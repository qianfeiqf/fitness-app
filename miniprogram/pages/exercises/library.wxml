<!-- 动作库页面 -->
<view class="page-library">
  <!-- 搜索栏 -->
  <mp-searchbar
    placeholder="搜索动作名称"
    value="{{searchKeyword}}"
    bind:input="onSearchInput"
    bind:confirm="onSearch"
    bind:cancel="onClearSearch"
  />

  <!-- 肌群筛选 -->
  <mp-tabs tabs="{{muscleGroupTabs}}" active-tab="{{selectedGroupIndex}}" bind:change="onGroupTabChange" />

  <!-- 二级细分筛选胶囊 -->
  <scroll-view wx:if="{{subMuscles.length > 0}}" scroll-x class="sub-muscle-scroll" show-scrollbar="{{false}}">
    <view class="sub-muscle-list">
      <view
        wx:for="{{subMuscles}}"
        wx:key="*this"
        class="sub-muscle-pill {{selectedSubMuscle === item ? 'active' : ''}}"
        data-sub="{{item}}"
        bindtap="onSelectSubMuscle"
      >{{item}}</view>
    </view>
  </scroll-view>

  <!-- 动作列表 -->
  <scroll-view class="exercise-list" scroll-y>
    <view wx:for="{{groupedExercises}}" wx:key="group" class="exercise-group">
      <view class="group-header">{{item.group}}</view>
      <view wx:for="{{item.exercises}}" wx:for-item="ex" wx:key="id"
            class="exercise-item {{selectedMap[ex.id] ? 'selected' : ''}}"
            bindtap="onSelectExercise" data-exercise-id="{{ex.id}}">
        <view
          class="ex-thumb-box {{playingExerciseId === ex.id ? 'playing' : ''}}"
          catchtap="onTogglePreviewGif"
          data-exercise-id="{{ex.id}}"
        >
          <image
            wx:if="{{playingExerciseId === ex.id && ex.gif_url}}"
            class="ex-thumb-img"
            src="{{ex.gif_url}}"
            mode="aspectFit"
          />
          <image
            wx:elif="{{ex.thumb_url && !thumbErrorMap[ex.id]}}"
            class="ex-thumb-img"
            src="{{ex.thumb_url}}"
            mode="aspectFit"
            lazy-load="{{true}}"
            binderror="onThumbError"
            data-exercise-id="{{ex.id}}"
          />
          <view wx:else class="ex-thumb-placeholder"></view>
          <view wx:if="{{playingExerciseId === ex.id && ex.gif_url}}" class="ex-thumb-live-dot"></view>
          <view wx:elif="{{ex.gif_url}}" class="ex-thumb-play"></view>
        </view>
        <view class="exercise-info">
          <text class="exercise-name">{{ex.name}}</text>
          <text wx:if="{{ex.sub_muscle || ex.equipment || ex.target_muscles || ex.name_en}}" class="exercise-name-en">{{ex.sub_muscle ? ex.sub_muscle + ' · ' : ''}}{{ex.equipment ? ex.equipment + ' · ' : ''}}{{ex.target_muscles || ex.name_en}}</text>
        </view>
        <view class="exercise-actions">
          <view wx:if="{{ex.description}}" class="exercise-info-btn" catchtap="onViewExerciseDetail" data-exercise-id="{{ex.id}}">
            <text class="exercise-info-icon">i</text>
          </view>
          <view class="select-circle {{selectedMap[ex.id] ? 'checked' : ''}}">
            <text wx:if="{{selectedMap[ex.id]}}">✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 无结果 -->
    <view wx:if="{{groupedExercises.length === 0}}" class="empty-state">
      <text class="empty-text">未找到匹配的动作</text>
    </view>
  </scroll-view>

  <!-- 底部操作栏：支持自定义动作 + 批量确认已选 -->
  <view class="library-bottom-bar">
    <view class="custom-secondary-btn" bindtap="onShowAddCustom">
      <text>+ 自定义动作</text>
    </view>
    <view class="confirm-add-btn {{selectedIds.length === 0 ? 'disabled' : ''}}" bindtap="onConfirmSelect">
      <text>{{selectedIds.length > 0 ? '添加已选 (' + selectedIds.length + ')' : '请选择动作'}}</text>
    </view>
  </view>

  <!-- 添加自定义动作弹窗 -->
  <modal-sheet
    visible="{{showAddCustom}}"
    title="新建自定义动作"
    description="保存后将加入动作库，下次可直接选用"
    confirmText="保存"
    cancelText="取消"
    confirmDisabled="{{!customExercise.name || !customExercise.muscle_group}}"
    bind:confirm="onConfirmAddCustom"
    bind:cancel="onCloseAddCustom"
    bind:close="onCloseAddCustom"
  >
    <view class="form-item">
      <text class="form-label">动作名称</text>
      <input class="form-input" placeholder="例如：绳索面拉 / 壶铃摇摆"
             value="{{customExercise.name}}" bindinput="onInputCustomName" />
    </view>

    <view class="form-item">
      <text class="form-label">所属肌群（必选）</text>
      <view class="custom-muscle-grid">
        <view
          wx:for="{{muscleGroups}}"
          wx:key="*this"
          class="custom-muscle-pill {{customExercise.muscle_group === item ? 'active' : ''}}"
          data-muscle="{{item}}"
          bindtap="onSelectMuscleGroup"
        >{{item}}</view>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">常用器械（可选）</text>
      <input class="form-input" placeholder="例如：哑铃、龙门架、固定器械"
             value="{{customExercise.equipment}}" bindinput="onInputCustomEquipment" />
    </view>
  </modal-sheet>

  <!-- 动作要领与动图半屏抽屉 -->
  <exercise-guide-sheet
    visible="{{showExerciseDetail}}"
    exercise="{{detailExercise}}"
    bind:close="onCloseExerciseDetail"
  />
</view>
