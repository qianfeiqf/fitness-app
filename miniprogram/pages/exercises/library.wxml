<!-- 动作库页面 -->
<view class="page-library">
  <!-- 搜索栏 -->
  <mp-searchbar
    placeholder="搜索动作名称"
    value="{{searchKeyword}}"
    bind:input="onSearchInput"
    bind:confirm="onSearch"
    bind:cancel="onClearSearch"
  />

  <!-- 肌群筛选 -->
  <mp-tabs tabs="{{muscleGroupTabs}}" active-tab="{{selectedGroupIndex}}" bind:change="onGroupTabChange" />

  <!-- 动作列表 -->
  <scroll-view class="exercise-list" scroll-y>
    <view wx:for="{{groupedExercises}}" wx:key="group" class="exercise-group">
      <view class="group-header">{{item.group}}</view>
      <view wx:for="{{item.exercises}}" wx:for-item="ex" wx:key="id"
            class="exercise-item {{selectedMap[ex.id] ? 'selected' : ''}}"
            bindtap="onSelectExercise" data-exercise-id="{{ex.id}}">
        <view class="exercise-info">
          <text class="exercise-name">{{ex.name}}</text>
          <text wx:if="{{ex.equipment || ex.target_muscles || ex.name_en}}" class="exercise-name-en">{{ex.equipment ? ex.equipment + ' · ' : ''}}{{ex.target_muscles || ex.name_en}}</text>
        </view>
        <view class="exercise-actions">
          <view wx:if="{{ex.description}}" class="exercise-info-btn" catchtap="onViewExerciseDetail" data-exercise-id="{{ex.id}}">
            <text class="exercise-info-icon">i</text>
          </view>
          <view class="select-circle {{selectedMap[ex.id] ? 'checked' : ''}}">
            <text wx:if="{{selectedMap[ex.id]}}">✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 无结果 -->
    <view wx:if="{{groupedExercises.length === 0}}" class="empty-state">
      <text class="empty-text">未找到匹配的动作</text>
    </view>
  </scroll-view>

  <!-- 底部操作栏：支持自定义动作 + 批量确认已选 -->
  <view class="library-bottom-bar">
    <view class="custom-secondary-btn" bindtap="onShowAddCustom">
      <text>+ 自定义动作</text>
    </view>
    <view class="confirm-add-btn {{selectedIds.length === 0 ? 'disabled' : ''}}" bindtap="onConfirmSelect">
      <text>{{selectedIds.length > 0 ? '添加已选 (' + selectedIds.length + ')' : '请选择动作'}}</text>
    </view>
  </view>

  <!-- 添加自定义动作弹窗 -->
  <modal-sheet
    visible="{{showAddCustom}}"
    title="添加自定义动作"
    confirmText="添加"
    cancelText="取消"
    bind:confirm="onConfirmAddCustom"
    bind:cancel="onCloseAddCustom"
    bind:close="onCloseAddCustom"
  >
    <view class="form-item">
      <text class="form-label">动作名称</text>
      <input class="form-input" placeholder="输入动作名称"
             value="{{customExercise.name}}" bindinput="onInputCustomName" />
    </view>

    <view class="form-item">
      <text class="form-label">英文名称（可选）</text>
      <input class="form-input" placeholder="输入英文名称"
             value="{{customExercise.name_en}}" bindinput="onInputCustomNameEn" />
    </view>

    <view class="form-item">
      <text class="form-label">肌群</text>
      <picker class="form-picker" mode="selector" range="{{muscleGroups}}"
              value="{{customExercise.muscleGroupIndex}}"
              bindchange="onSelectMuscleGroup">
        <view class="picker-value">
          {{customExercise.muscle_group || '选择肌群'}}
        </view>
      </picker>
    </view>
  </modal-sheet>

  <!-- 动作要领半屏抽屉 -->
  <modal-sheet
    visible="{{showExerciseDetail}}"
    title="{{detailExercise ? detailExercise.name : ''}}"
    description="{{detailExercise && detailExercise.name_en ? detailExercise.name_en : ''}}"
    showConfirm="{{false}}"
    cancelText="知道了"
    bind:cancel="onCloseExerciseDetail"
    bind:close="onCloseExerciseDetail"
  >
    <view wx:if="{{detailExercise}}" class="ex-detail-body">
      <view class="ex-detail-tags">
        <text wx:if="{{detailExercise.muscle_group}}" class="ex-detail-tag">{{detailExercise.muscle_group}}</text>
        <text wx:if="{{detailExercise.equipment}}" class="ex-detail-tag tag-equip">{{detailExercise.equipment}}</text>
      </view>
      <view wx:if="{{detailExercise.target_muscles}}" class="ex-detail-block">
        <text class="ex-detail-label">目标肌群</text>
        <text class="ex-detail-text">{{detailExercise.target_muscles}}</text>
      </view>
      <view wx:if="{{detailExercise.description}}" class="ex-detail-block">
        <text class="ex-detail-label">动作要领</text>
        <text class="ex-detail-text">{{detailExercise.description}}</text>
      </view>
      <view wx:if="{{detailExercise.tips}}" class="ex-detail-block ex-detail-tips">
        <text class="ex-detail-label">呼吸与避坑</text>
        <text class="ex-detail-text">{{detailExercise.tips}}</text>
      </view>
    </view>
  </modal-sheet>
</view>
