/* 计划详情页面样式 — 与全站统一的 #F7F8FA 浅灰底 + 无边框白卡 + 炭黑/微信绿 */

.page-detail {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-top: 24rpx;
  padding-bottom: calc(210rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  gap: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #888888;
}

/* 计划头部卡 */
.plan-header {
  margin: 0 32rpx 32rpx;
  padding: 32rpx 30rpx;
  background-color: #FFFFFF;
  border-radius: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.plan-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.plan-name {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
  color: #1A1A1A;
}

.plan-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: block;
}

/* 状态徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-active {
  background-color: #F0FBF4;
  color: #07C160;
}

.badge-paused {
  background-color: #F3F4F6;
  color: #888888;
}

.badge-template {
  background-color: #1A1A1A;
  color: #FFFFFF;
}

/* 频率与难度胶囊 */
.meta-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.meta-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 9999rpx;
  background-color: #F4F5F7;
  color: #555555;
  font-size: 22rpx;
  font-weight: 500;
}

/* 介绍展开区 */
.intro-section {
  margin-top: 24rpx;
  border-top: 1rpx solid #F2F3F5;
  padding-top: 16rpx;
}

.intro-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.intro-toggle-text {
  font-size: 26rpx;
  color: #07C160;
  font-weight: 600;
}

.intro-toggle-icon {
  font-size: 24rpx;
  color: #07C160;
}

.intro-content {
  margin-top: 16rpx;
}

.intro-block {
  margin-bottom: 22rpx;
}

.intro-block:last-child {
  margin-bottom: 0;
}

.intro-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.intro-text {
  font-size: 25rpx;
  color: #666666;
  line-height: 1.7;
  display: block;
}

/* 课表标题 */
.schedule-header {
  margin: 0 32rpx 18rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.schedule-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.schedule-subtitle {
  font-size: 22rpx;
  color: #999999;
}

/* 训练日卡片 */
.week-schedule {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 0 32rpx;
}

.day-section {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 1rpx solid #F4F5F7;
}

.day-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.day-count {
  font-size: 22rpx;
  color: #888888;
  font-weight: 500;
}

.day-exercises {
  padding: 4rpx 28rpx 8rpx;
}

.exercise-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F4F5F7;
}

.exercise-card:last-child {
  border-bottom: none;
}

.exercise-card:active {
  opacity: 0.72;
}

.exercise-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: 'DIN Alternate', system-ui, sans-serif;
}

.exercise-main {
  flex: 1;
  min-width: 0;
}

.exercise-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.exercise-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.exercise-muscle-pill {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #666666;
  background: #F4F5F7;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
}

.exercise-sets {
  font-size: 24rpx;
  color: #888888;
  display: block;
}

.exercise-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  font-weight: 300;
  flex-shrink: 0;
}

/* 空课表提示 */
.empty-schedule {
  margin: 0 32rpx;
  padding: 64rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  text-align: center;
}

.empty-schedule-text {
  font-size: 26rpx;
  color: #999999;
}

/* 低频危险操作（移出底部吸屏栏） */
.delete-plan-wrap {
  margin-top: 36rpx;
  text-align: center;
}

.delete-plan-link {
  display: inline-block;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  color: #999999;
}

.delete-plan-link:active {
  color: #FA5151;
}

/* 底部精简药丸操作栏 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 18rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 30;
}

.template-use-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #888888;
  margin-bottom: 14rpx;
  line-height: 1.3;
}

.action-btn-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.detail-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-btn.primary {
  background: #07C160;
  color: #FFFFFF;
}

.detail-btn.primary-soft {
  background: #F0FBF4;
  color: #07C160;
}

.detail-btn.dark {
  background: #1A1A1A;
  color: #FFFFFF;
}

.detail-btn.secondary {
  background: #F4F5F7;
  color: #333333;
  font-weight: 500;
}

.detail-btn.danger {
  background: #FA5151;
  color: #FFFFFF;
}

.detail-btn:active {
  opacity: 0.86;
}
