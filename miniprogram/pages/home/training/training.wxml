<wxs src="./training.wxs" module="wxs" />

<!-- 训练中页面 - 沉浸式极简风格 -->

<view class="page-training" style="padding-top: {{navHeight}}px;">
  <!-- 顶部自定义返回栏（与右侧微信胶囊垂直对齐） -->
  <view class="training-custom-nav" style="top: {{navTop}}px; height: {{navMenuHeight}}px;">
    <view class="training-back-btn" bindtap="onBackFromTraining">
      <mp-icon icon="back" color="#1A1A1A" size="{{12}}" />
      <text class="training-back-text">返回</text>
    </view>
  </view>

  <!-- 顶部进度条 -->
  <view class="progress-header">
    <view class="progress-info">
      <view class="progress-counter" bindtap="onOpenExerciseListModal">
        <text class="counter-num">{{exercises.length > 0 ? (currentExerciseIndex < exercises.length ? currentExerciseIndex + 1 : exercises.length) : 0}}</text>
        <text class="counter-sep">/</text>
        <text class="counter-total">{{exercises.length}}</text>
        <text class="counter-arrow">▾</text>
      </view>
      <view class="progress-right">
        <text class="training-duration">{{wxs.formatTime(trainingDuration)}}</text>
        <text class="exercise-name">{{currentExercise ? currentExercise.name : (isFreeWorkout ? '自由训练' : '')}}</text>
      </view>
    </view>
    <view class="progress-bar-track">
      <view class="progress-bar-fill" style="width: {{currentExercise && currentExercise.target_sets ? (currentExercise.completed_sets >= currentExercise.target_sets ? 100 : (currentExercise.completed_sets / currentExercise.target_sets) * 100) : 0}}%;"></view>
    </view>
  </view>

  <!-- 动作列表 - 横向滚动（独立浅灰底槽 + 自动滚动定位） -->
  <scroll-view
    scroll-x
    class="exercise-scroll"
    scroll-into-view="{{exerciseScrollIntoView}}"
    scroll-with-animation="{{true}}"
    show-scrollbar="{{false}}"
  >
    <view class="exercise-list">
      <view
        wx:for="{{exercises}}"
        wx:key="index"
        id="ex-chip-{{index}}"
        class="exercise-chip {{item.completed_sets >= item.target_sets ? 'completed' : ''}} {{index === currentExerciseIndex ? 'current' : ''}}"
        bindtap="onTapExercise"
        bindlongpress="onLongPressExercise"
        data-index="{{index}}"
      >
        <view class="chip-content">
          <text class="chip-name">{{item.exercise_name}}</text>
          <text class="chip-sets">{{item.completed_sets}}/{{item.target_sets}}组</text>
        </view>
        <text wx:if="{{item.completed_sets >= item.target_sets}}" class="chip-check done">✓</text>
        <text wx:elif="{{item.skipped}}" class="chip-check skip">跳过</text>
      </view>
      <view class="exercise-chip add-chip" bindtap="onAddExercise">
        <view class="chip-content">
          <text class="chip-name add-icon">+ 添加</text>
          <text class="chip-sets">新动作</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- PR徽章展示 -->
  <view wx:if="{{prBadges.length > 0}}" class="pr-badges">
    <view wx:for="{{prBadges}}" wx:key="id" class="pr-badge-item">
      <mp-icon icon="star" color="#07C160" size="{{16}}" />
      <text class="pr-badge-text">{{item.exerciseName}} 新PR: {{item.value}}kg</text>
    </view>
  </view>

  <!-- 自由训练：尚无动作时的空态引导 -->
  <view wx:if="{{isFreeWorkout && exercises.length === 0}}" class="free-empty-state">
    <mp-icon icon="add2" color="#CCCCCC" size="{{44}}" />
    <text class="free-empty-title">自由训练已开始</text>
    <text class="free-empty-desc">可以先一次性选好几个动作再逐个练，也可以练完一个再加下一个</text>
    <view class="btn btn-primary btn-md free-empty-btn" bindtap="onAddExercise">
      <text>+ 添加训练动作</text>
    </view>
  </view>

  <!-- 自由训练：当前列表全部完成后的流转引导 -->
  <view wx:elif="{{isFreeWorkout && freeAllDone}}" class="free-empty-state">
    <icon type="success" size="48" color="#07C160" />
    <text class="free-empty-title">已完成 {{completedSets.length}} 组训练</text>
    <view class="free-done-actions">
      <view class="btn btn-finish btn-md btn-block" bindtap="onFinishTraining">
        <text>完成本次训练并保存</text>
      </view>
      <view class="btn btn-secondary btn-md btn-block" bindtap="onAddExercise">
        <text>+ 继续添加下一个动作</text>
      </view>
      <view class="btn btn-secondary btn-md btn-block" bindtap="onAddExtraSet">
        <text>+ 上个动作再加一组</text>
      </view>
    </view>
  </view>

  <!-- 主训练区域：热身组与正式组双 Tab 平级切换 -->
  <view hidden="{{!currentExercise || freeAllDone}}" class="training-main">
    <!-- 动作肌群标签 + 移除动作入口 -->
    <view class="exercise-header">
      <view class="exercise-tags">
        <view class="tag tag-primary">{{currentExercise.muscle_group}}</view>
      </view>
      <view class="exercise-remove-btn" bindtap="onRemoveCurrentExercise">
        <mp-icon icon="delete" color="#888888" size="{{15}}" />
        <text class="exercise-remove-text">移除</text>
      </view>
    </view>

    <!-- 热身组 / 正式组 分段切换 Tab -->
    <view class="stage-tabs">
      <view
        class="stage-tab {{activeStage === 'warmup' ? 'active' : ''}}"
        data-stage="warmup"
        bindtap="onSwitchStage"
      >
        <text class="stage-tab-text">热身组</text>
        <text class="stage-tab-count">{{warmupCompletedCount}}/{{warmupSets.length}}</text>
      </view>
      <view
        class="stage-tab {{activeStage === 'formal' ? 'active' : ''}}"
        data-stage="formal"
        bindtap="onSwitchStage"
      >
        <text class="stage-tab-text">正式组</text>
        <text class="stage-tab-count">{{currentExercise.completed_sets || 0}}/{{currentExercise.target_sets || 0}}</text>
      </view>
    </view>

    <scroll-view scroll-y class="training-scroll" show-scrollbar="{{false}}">
      <!-- 热身组平铺列表 -->
      <block wx:if="{{activeStage === 'warmup'}}">
        <view class="warmup-list">
          <view
            wx:for="{{warmupSets}}"
            wx:key="index"
            class="warmup-item {{item.completed ? 'completed' : ''}} {{index === currentWarmupIndex ? 'current' : ''}}"
          >
            <view class="warmup-check" data-index="{{index}}" bindtap="onToggleWarmupSet">
              <text wx:if="{{item.completed}}" class="warmup-check-icon">✓</text>
              <text wx:else class="warmup-check-num">{{index + 1}}</text>
            </view>
            <view class="warmup-info">
              <input
                type="digit"
                class="warmup-input"
                value="{{item.weight}}"
                data-index="{{index}}"
                bindinput="onWarmupWeightInput"
                bindblur="onWarmupInputBlur"
              />
              <text class="warmup-unit">kg</text>
              <text class="warmup-sep">×</text>
              <input
                type="number"
                class="warmup-input warmup-input-sm"
                value="{{item.reps}}"
                data-index="{{index}}"
                bindinput="onWarmupRepsInput"
                bindblur="onWarmupInputBlur"
              />
              <text class="warmup-unit">次</text>
            </view>
            <view
              wx:if="{{warmupSets.length > 1}}"
              class="warmup-delete-btn"
              data-index="{{index}}"
              bindtap="onDeleteWarmupSet"
            >
              <text>×</text>
            </view>
          </view>
        </view>

        <view class="warmup-add-btn" bindtap="onAddWarmupSet">
          <text>+ 添加热身组</text>
        </view>
      </block>

      <!-- 正式组平铺列表 -->
      <block wx:else>
        <view class="formal-list">
          <view
            wx:for="{{formalSets}}"
            wx:key="index"
            class="formal-item {{item.completed ? 'completed' : ''}} {{index === currentSetIndex ? 'current' : ''}}"
          >
            <view class="formal-check" data-index="{{index}}" bindtap="onToggleFormalSet">
              <text wx:if="{{item.completed}}" class="formal-check-icon">✓</text>
              <text wx:else class="formal-check-num">{{index + 1}}</text>
            </view>
            <view class="warmup-info">
              <input
                type="digit"
                class="warmup-input"
                value="{{item.weight}}"
                data-index="{{index}}"
                bindinput="onFormalWeightInput"
                bindblur="onFormalInputBlur"
              />
              <text class="warmup-unit">kg</text>
              <text class="warmup-sep">×</text>
              <input
                type="number"
                class="warmup-input warmup-input-sm"
                value="{{item.reps}}"
                data-index="{{index}}"
                bindinput="onFormalRepsInput"
                bindblur="onFormalInputBlur"
              />
              <text class="warmup-unit">次</text>
            </view>
            <view
              wx:if="{{formalSets.length > 1}}"
              class="warmup-delete-btn"
              data-index="{{index}}"
              bindtap="onDeleteFormalSet"
            >
              <text>×</text>
            </view>
          </view>
        </view>

        <view class="formal-add-btn" bindtap="onAddFormalSet">
          <text>+ 添加正式组</text>
        </view>

        <!-- 更多操作折叠面板 -->
        <view class="more-section">
          <view class="more-toggle" bindtap="onToggleMoreActions">
            <text class="more-toggle-text">{{showMoreActions ? '收起' : '更多选项'}}</text>
            <text class="more-toggle-arrow {{showMoreActions ? 'open' : ''}}">▼</text>
          </view>

          <view wx:if="{{showMoreActions}}" class="more-panel">
            <!-- RPE选择 -->
            <view class="rpe-section">
              <text class="rpe-label">自觉力竭程度</text>
              <view class="rpe-options">
                <view
                  wx:for="{{rpeOptions}}"
                  wx:key="index"
                  class="rpe-option {{selectedRPE === index ? 'active' : ''}}"
                  bindtap="onSelectRPE"
                  data-value="{{index}}"
                >
                  <text class="rpe-value">{{item}}</text>
                </view>
              </view>
            </view>

            <!-- 组备注 -->
            <view class="note-section">
              <text class="note-label">备注</text>
              <input
                class="note-input"
                type="text"
                placeholder="记录体感、疼痛点、动作感受等..."
                value="{{setNote}}"
                bindinput="onSetNoteChange"
              />
            </view>

            <!-- 替换/跳过 -->
            <view class="secondary-actions">
              <view class="btn btn-secondary btn-sm" bindtap="onReplaceExercise">替换动作</view>
              <view class="btn btn-secondary btn-sm" bindtap="onSkipExercise">跳过动作</view>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>

    <!-- 底部固定主操作栏 -->
    <view class="complete-action">
      <block wx:if="{{activeStage === 'warmup'}}">
        <view
          wx:if="{{currentWarmupIndex < warmupSets.length}}"
          class="btn btn-warmup-primary btn-md btn-block"
          bindtap="onCompleteWarmupSet"
        >
          <text>完成第 {{currentWarmupIndex + 1}} 组热身</text>
        </view>
        <view
          wx:else
          class="btn btn-primary btn-md btn-block"
          bindtap="onFinishWarmup"
        >
          <text>开始正式组</text>
        </view>
      </block>
      <block wx:else>
        <view wx:if="{{currentExercise.isDone}}" class="btn btn-primary btn-md btn-block" bindtap="onAddExtraSet">
          <text>+ 加练一组（第 {{currentExercise.target_sets + 1}} 组）</text>
        </view>
        <view wx:else class="btn btn-primary btn-md btn-block" bindtap="onCompleteSet">
          <text>完成第 {{currentExercise.currentSetNumber}} 组</text>
        </view>
        <view wx:if="{{completedSets.length > 0}}" class="undo-last-btn" bindtap="onUndoLastSet">
          <text>撤回上一组</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 底部操作栏（单行紧凑图文 + 微信官方 WeUI 矢量图标） -->
  <view class="bottom-bar">
    <view class="bottom-btn" bindtap="{{isPaused ? 'onResumeTraining' : 'onPauseTraining'}}">
      <mp-icon icon="{{isPaused ? 'play2' : 'pause'}}" color="#666666" size="{{18}}" />
      <text class="bottom-label">{{isPaused ? '继续' : '暂停'}}</text>
    </view>
    <view class="bottom-btn finish" bindtap="onFinishTraining">
      <mp-icon icon="done" color="#07C160" size="{{18}}" />
      <text class="bottom-label">完成</text>
    </view>
  </view>

  <!-- 完成训练确认抽屉（三层视觉权重：主保存 / 次继续 / 弱放弃） -->
  <modal-sheet
    visible="{{showFinishModal}}"
    title="{{completedSets.length > 0 ? '完成本次训练' : '尚未记录训练'}}"
    description="{{completedSets.length > 0 ? ('已记录 ' + completedSets.length + ' 组 · 用时 ' + wxs.formatTime(trainingDuration)) : '还没有完成任何一组动作，确认要离开吗？'}}"
    showConfirm="{{false}}"
    showCancel="{{false}}"
    bind:close="onCancelFinishModal"
  >
    <view class="finish-sheet-actions">
      <block wx:if="{{completedSets.length > 0}}">
        <view class="finish-btn-primary" bindtap="onConfirmFinishAndSave">完成并保存</view>
        <view class="finish-btn-secondary" bindtap="onCancelFinishModal">继续训练</view>
        <view class="finish-btn-discard" bindtap="onRequestDiscardTraining">不保存，放弃本次训练</view>
      </block>
      <block wx:else>
        <view class="finish-btn-primary" bindtap="onCancelFinishModal">继续训练</view>
        <view class="finish-btn-discard" bindtap="onConfirmDiscardEmpty">放弃本次训练</view>
      </block>
    </view>
  </modal-sheet>

  <!-- 全部动作快捷切换抽屉 -->
  <modal-sheet
    visible="{{showExerciseListModal}}"
    title="本次训练动作"
    description="点击动作快速切换"
    confirmText="+ 添加动作"
    cancelText="关闭"
    bind:confirm="onAddExerciseFromList"
    bind:cancel="onCloseExerciseListModal"
    bind:close="onCloseExerciseListModal"
  >
    <scroll-view scroll-y class="exercise-drawer-list">
      <view
        wx:for="{{exercises}}"
        wx:key="index"
        class="exercise-drawer-item {{index === currentExerciseIndex ? 'current' : ''}} {{item.completed_sets >= item.target_sets ? 'completed' : ''}}"
        bindtap="onSelectExerciseFromDrawer"
        data-index="{{index}}"
      >
        <view class="drawer-item-index">{{index + 1}}</view>
        <view class="drawer-item-info">
          <text class="drawer-item-name">{{item.exercise_name || item.name}}</text>
          <text class="drawer-item-meta">{{item.completed_sets || 0}}/{{item.target_sets || 0}} 组{{item.skipped ? ' · 已跳过' : (item.completed_sets >= item.target_sets ? ' · 已完成' : '')}}</text>
        </view>
        <view class="drawer-item-actions">
          <text wx:if="{{index === currentExerciseIndex}}" class="drawer-current-tag">当前</text>
          <view class="drawer-remove-btn" catchtap="onRemoveExerciseFromDrawer" data-index="{{index}}">
            <mp-icon icon="delete" color="#999999" size="{{16}}" />
          </view>
        </view>
      </view>
    </scroll-view>
  </modal-sheet>

  <!-- 跳过动作弹窗 -->
  <modal-sheet
    visible="{{showSkipModal}}"
    title="跳过动作"
    description="为什么跳过这个动作？"
    confirmText="确认跳过"
    cancelText="取消"
    confirmDisabled="{{selectedSkipReason === -1}}"
    bind:confirm="onConfirmSkip"
    bind:cancel="onCancelSkip"
    bind:close="onCancelSkip"
  >
    <view class="skip-reason-list">
      <view
        wx:for="{{skipReasons}}"
        wx:key="index"
        class="skip-reason-item {{selectedSkipReason === index ? 'selected' : ''}}"
        bindtap="onSelectSkipReason"
        data-index="{{index}}"
      >
        <text class="skip-reason-text">{{item}}</text>
        <text wx:if="{{selectedSkipReason === index}}" class="skip-reason-check">✓</text>
      </view>
    </view>
  </modal-sheet>

  <!-- 添加动作弹窗（85vh 大抽屉：支持按肌群筛选、多选批量添加与自定义动作） -->
  <modal-sheet
    visible="{{showAddExerciseModal}}"
    tall="{{true}}"
    title="添加训练动作"
    description="支持多选或自定义"
    confirmText="{{selectedAddIds.length > 0 ? '添加已选 (' + selectedAddIds.length + ')' : '确定添加'}}"
    confirmDisabled="{{selectedAddIds.length === 0 && !canAddCustomExercise}}"
    cancelText="取消"
    bind:confirm="onConfirmAddExercises"
    bind:cancel="onCancelAddExercise"
    bind:close="onCancelAddExercise"
  >
    <view class="add-exercise-search">
      <input
        class="add-search-input"
        type="text"
        placeholder="搜索动作库，或输入自定义动作名..."
        value="{{addExerciseSearch}}"
        bindinput="onAddExerciseSearch"
      />
    </view>
    <scroll-view scroll-x class="add-muscle-scroll">
      <view class="add-muscle-list">
        <view
          wx:for="{{addMuscleGroups}}"
          wx:key="*this"
          class="add-muscle-chip {{selectedAddMuscle === item ? 'active' : ''}}"
          bindtap="onSelectAddMuscle"
          data-muscle="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
    <scroll-view scroll-y class="add-exercise-list">
      <view wx:if="{{canAddCustomExercise}}" class="alternative-item custom-add-row" bindtap="onAddCustomExercise">
        <view class="alt-info">
          <text class="alt-name">+ 添加自定义动作「{{addExerciseSearch}}」</text>
          <text class="alt-muscle">直接加入本次训练</text>
        </view>
        <text class="alt-arrow">+</text>
      </view>
      <view
        wx:for="{{filteredExercises}}"
        wx:key="id"
        class="add-exercise-card {{selectedAddMap[item.id] ? 'selected' : ''}}"
      >
        <view
          class="alternative-item add-card-head"
          bindtap="onToggleAddExercise"
          data-exercise-id="{{item.id}}"
        >
          <view class="alt-info">
            <text class="alt-name">{{item.name}}</text>
            <text class="alt-muscle">{{item.muscle_group}}</text>
          </view>
          <text class="add-check-circle {{selectedAddMap[item.id] ? 'checked' : ''}}">{{selectedAddMap[item.id] ? '✓' : ''}}</text>
        </view>
        <view wx:if="{{selectedAddMap[item.id] && selectedAddConfigs[item.id]}}" class="add-config-bar" catchtap="noop">
          <view class="add-cfg-item">
            <text class="add-cfg-label">组数</text>
            <view class="add-cfg-stepper">
              <text class="cfg-step-btn" bindtap="onStepAddSets" data-exercise-id="{{item.id}}" data-delta="-1">-</text>
              <text class="cfg-step-val">{{selectedAddConfigs[item.id].sets}}</text>
              <text class="cfg-step-btn" bindtap="onStepAddSets" data-exercise-id="{{item.id}}" data-delta="1">+</text>
            </view>
          </view>
          <view class="add-cfg-item">
            <text class="add-cfg-label">重量(kg)</text>
            <input
              class="add-cfg-input"
              type="digit"
              value="{{selectedAddConfigs[item.id].weight}}"
              data-exercise-id="{{item.id}}"
              data-field="weight"
              bindinput="onUpdateAddConfig"
            />
          </view>
          <view class="add-cfg-item">
            <text class="add-cfg-label">次数</text>
            <input
              class="add-cfg-input"
              type="number"
              value="{{selectedAddConfigs[item.id].reps}}"
              data-exercise-id="{{item.id}}"
              data-field="reps"
              bindinput="onUpdateAddConfig"
            />
          </view>
        </view>
      </view>
    </scroll-view>
  </modal-sheet>

  <!-- 动作替换弹窗 -->
  <modal-sheet
    visible="{{showReplaceModal}}"
    title="替换动作"
    description="选择同发力模式的替代动作"
    showConfirm="{{false}}"
    cancelText="取消"
    bind:cancel="onCancelReplace"
    bind:close="onCancelReplace"
  >
    <view class="alternative-list">
      <view
        wx:for="{{alternativeExercises}}"
        wx:key="id"
        class="alternative-item"
        bindtap="onSelectAlternative"
        data-exercise-id="{{item.id}}"
      >
        <view class="alt-info">
          <text class="alt-name">{{item.name}}</text>
          <text class="alt-muscle">{{item.muscle_group}}</text>
        </view>
        <text class="alt-arrow">›</text>
      </view>
    </view>
  </modal-sheet>
</view>

<!-- 组间休息遮罩层（放在 page-training 外部，避免被 overflow:hidden 截断；用 hidden 避免销毁/重建 DOM） -->
<view hidden="{{!isResting || restMinimized}}" class="rest-overlay">
  <view class="rest-overlay-backdrop" bindtap="onMinimizeRest"></view>
  <view class="rest-overlay-content">
    <view class="rest-overlay-header">
      <text class="rest-overlay-label">组间休息</text>
    </view>

    <!-- 大号倒计时 -->
    <view class="rest-countdown">
      <text class="rest-countdown-time">{{wxs.formatTime(restTimeLeft)}}</text>
      <text class="rest-countdown-total">/ {{wxs.formatTime(restTimeTotal)}}</text>
    </view>

    <view class="rest-overlay-progress">
      <view class="rest-overlay-progress-track">
        <view class="rest-overlay-progress-fill" style="width: {{((restTimeTotal - restTimeLeft) / restTimeTotal) * 100}}%;"></view>
      </view>
    </view>

    <view wx:if="{{nextSetPreview}}" class="rest-overlay-body">
      <text class="rest-next-preview">下一组：{{nextSetPreview}}</text>
    </view>
    <view class="rest-overlay-actions">
      <view class="rest-overlay-btn" bindtap="onReduceRestTime">-30s</view>
      <view class="rest-overlay-btn primary" bindtap="onReadyToGo">我准备好了</view>
      <view class="rest-overlay-btn" bindtap="onAddRestTime">+30s</view>
    </view>
    <view wx:if="{{completedSets.length > 0}}" class="rest-undo-link" bindtap="onUndoLastSet">
      <text>手滑点错了？撤回上一组</text>
    </view>
  </view>
</view>

<!-- 休息悬浮倒计时（点击弹窗外区域后显示） -->
<view hidden="{{!isResting || !restMinimized}}" class="rest-float" bindtap="onExpandRest">
  <view class="rest-float-content">
    <mp-icon icon="time" color="#FFFFFF" size="{{18}}" />
    <text class="rest-float-time">{{wxs.formatTime(restTimeLeft)}}</text>
    <text class="rest-float-label">组间休息</text>
  </view>
</view>
