<!-- 训练中心首页 - 浅色极简 -->
<page-meta page-style="overflow: {{coachTour.visible ? 'hidden' : 'visible'}}" />

<view class="page-home" style="padding-top: {{navHeight}}px;">
  <!-- 顶部轻头部 -->
  <view class="welcome-section">
    <view class="welcome-content">
      <text class="welcome-greeting">{{todayMonth ? (todayMonth + '月' + todayDate + '日 · ' + todayWeek) : '欢迎使用'}}</text>
      <text class="welcome-title">今日训练</text>
    </view>
    <view wx:if="{{todayPlan && !activeFreeSession}}" class="header-free-pill" bindtap="onStartFreeWorkout">
      <text class="header-free-plus">+</text>
      <text class="header-free-text">自由训练</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-section">
    <view class="skeleton-wrapper">
      <view class="skeleton-block tall"></view>
      <view class="skeleton-block medium"></view>
      <view class="skeleton-block short"></view>
    </view>
  </view>

  <!-- 无训练计划（深炭黑主卡带矢量徽章与暗纹 + 轻白自由训练图标卡） -->
  <view wx:elif="{{!todayPlan}}" class="empty-section">
    <!-- 1. 深炭黑主视觉卡：承接挑选经典计划 + 自建计划两条路径 -->
    <view class="empty-hero-card">
      <view class="empty-hero-watermark"></view>
      <view class="empty-hero-top">
        <view class="empty-hero-icon-badge">
          <view class="empty-svg-icon icon-plan"></view>
        </view>
        <text class="empty-hero-eyebrow">训练计划</text>
      </view>
      <text class="empty-hero-title">制定你的训练计划</text>
      <text class="empty-hero-desc">选用经典体系，或按习惯自由安排每周训练</text>
      <view class="empty-hero-actions">
        <view class="empty-hero-btn primary" bindtap="onGoToPlans">
          <view class="empty-btn-icon icon-list"></view>
          <text>挑选经典计划</text>
        </view>
        <view class="empty-hero-btn secondary" bindtap="onGoToCreatePlan">
          <view class="empty-btn-icon icon-plus"></view>
          <text>自建计划</text>
        </view>
      </view>
      <view class="empty-hero-recommend" bindtap="onGoToRecommend">
        <text>不知道怎么选？试试智能推荐 ›</text>
      </view>
    </view>

    <!-- 2. 轻量单行自由训练图标卡 -->
    <view class="empty-free-card {{activeFreeSession ? 'active' : ''}}" bindtap="onStartFreeWorkout">
      <view class="empty-free-icon-box {{activeFreeSession ? 'active' : ''}}">
        <view class="empty-svg-icon {{activeFreeSession ? 'icon-bolt-active' : 'icon-bolt'}}"></view>
      </view>
      <view class="empty-free-info">
        <text class="empty-free-title">{{activeFreeSession ? '继续自由训练' : '自由训练'}}</text>
        <text class="empty-free-desc">{{activeFreeSession ? activeFreeSummary : '不按固定计划，进馆随选动作边练边记'}}</text>
      </view>
      <view class="empty-free-pill {{activeFreeSession ? 'active' : ''}}">{{activeFreeSession ? '继续 ›' : '开练 ›'}}</view>
    </view>
  </view>

  <!-- 今日训练 -->
  <view wx:else class="training-section">
    <!-- 云端同步失败重试条 -->
    <view wx:if="{{syncFailed}}" class="home-tip-banner warn">
      <icon type="warn" size="18" color="#D97706" />
      <text class="home-tip-text">云端同步失败，请检查网络</text>
      <text class="home-tip-action" bindtap="onRetrySync">重试</text>
    </view>

    <!-- 首次完善身体档案轻提示条（非阻塞） -->
    <view wx:if="{{showProfileBanner}}" class="home-tip-banner">
      <icon type="info" size="18" color="#07C160" />
      <text class="home-tip-text">填写体重，1RM 与重量推荐更准确</text>
      <text class="home-tip-action" bindtap="onGoToProfileBanner">去填写</text>
      <view class="home-tip-close" bindtap="onDismissProfileBanner">
        <mp-icon icon="close" color="#999999" size="{{14}}" />
      </view>
    </view>

    <!-- 仅在存在进行中的自由训练时置顶展示续练条，平时收在顶部胶囊 -->
    <view wx:if="{{activeFreeSession}}" class="free-workout-bar active" bindtap="onStartFreeWorkout">
      <view class="free-workout-left">
        <mp-icon icon="play2" color="#07C160" size="{{22}}" />
        <view class="free-workout-info">
          <text class="free-workout-title">进行中的自由训练</text>
          <text class="free-workout-desc">{{activeFreeSummary}}</text>
        </view>
      </view>
      <text class="free-workout-btn">继续 ›</text>
    </view>
    <!-- Deload 提醒横幅 -->
    <view wx:if="{{showDeloadReminder}}" class="deload-banner" bindtap="onDismissDeloadReminder">
      <icon type="warn" size="20" color="#D97706" />
      <view class="deload-content">
        <text class="deload-title">建议安排减载周</text>
        <text class="deload-desc">你已持续高强度训练 6 周，建议本周降低重量 10-20% 进行恢复</text>
      </view>
      <mp-icon icon="close" color="#999999" size="{{14}}" />
    </view>

    <!-- 计划主卡片轮播（仅主卡左右切换，全宽无露边，内置本周小圆环） -->
    <swiper
      wx:if="{{planDataList.length > 0}}"
      class="plan-hero-swiper"
      current="{{currentPlanIndex}}"
      bindchange="onPlanChange"
      duration="260"
    >
      <swiper-item wx:for="{{planDataList}}" wx:key="id" wx:for-item="pd">
        <view class="plan-swiper-item-inner">
          <view class="training-card" data-plan-id="{{pd.plan.id}}" bindtap="onPreviewPlanById" hover-class="training-card-hover" hover-stay-time="100">
            <view class="training-card-watermark"></view>
            <view class="hero-card-row">
              <view class="hero-card-left">
                <view class="hero-title-row">
                  <view class="card-title-wrap">
                    <text class="card-title">{{pd.plan.name}}</text>
                    <text class="card-title-arrow">›</text>
                  </view>
                  <text wx:if="{{pd.needsExercises}}" class="badge-pill">待添加动作</text>
                  <text wx:elif="{{pd.isRoundCompleted}}" class="badge-pill rest">本轮已完成</text>
                  <text wx:elif="{{pd.isRestDay}}" class="badge-pill rest">休息日</text>
                  <text wx:elif="{{pd.muscleGroups}}" class="badge-pill">{{pd.muscleGroups}}</text>
                </view>
                <view wx:if="{{pd.needsExercises}}" class="card-meta-line compact">
                  <text class="meta-chip">尚未添加训练动作</text>
                </view>
                <view wx:elif="{{pd.isRestDay}}" class="card-meta-line compact">
                  <text class="meta-chip">休整恢复{{pd.nextDayLabel ? ' · 下次 ' + pd.nextDayLabel : ''}}</text>
                </view>
                <view wx:else class="card-meta-line compact">
                  <text class="meta-chip">{{pd.exercises.length}} 动作</text>
                  <text class="meta-dot">·</text>
                  <text class="meta-chip">{{pd.totalSets}} 组</text>
                  <text class="meta-dot">·</text>
                  <text class="meta-chip">约 {{pd.estimatedMinutes}} 分钟</text>
                </view>
              </view>

              <view class="hero-ring-wrap">
                <view class="progress-ring-bg">
                  <view class="progress-ring-fill" style="background: conic-gradient(#07C160 {{pd.weekProgress.percent * 3.6}}deg, rgba(255, 255, 255, 0.14) 0deg);"></view>
                  <view class="progress-ring-center">
                    <text class="progress-ring-num">{{pd.weekProgress.completedDays}}</text>
                    <text class="progress-ring-total">/{{pd.weekProgress.plannedDays}}</text>
                  </view>
                </view>
                <text class="hero-ring-label">{{pd.weekProgress.label || '本周'}}</text>
              </view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 多计划极简圆点指示器 -->
    <view wx:if="{{planDataList.length > 1}}" class="plan-dots">
      <view
        wx:for="{{planDataList}}"
        wx:key="id"
        wx:for-index="dotIdx"
        class="plan-dot {{dotIdx === currentPlanIndex ? 'active' : ''}}"
      ></view>
    </view>

    <!-- 本周课表自由切换胶囊条（支持调序开练 + 本周已练打钩） -->
    <view wx:if="{{currentPlanData && currentPlanData.dayOptions && currentPlanData.dayOptions.length > 0}}" class="week-day-section">
      <scroll-view scroll-x class="week-day-scroll" show-scrollbar="{{false}}">
        <view class="week-day-list">
          <view
            wx:for="{{currentPlanData.dayOptions}}"
            wx:key="key"
            wx:for-item="day"
            class="week-day-pill {{day.key === currentPlanData.selectedDayKey ? 'active' : ''}} {{day.completedThisWeek ? 'done' : ''}}"
            data-day-key="{{day.key}}"
            bindtap="onSelectPlanDay"
          >
            <text wx:if="{{day.completedThisWeek}}" class="week-day-check">✓</text>
            <text class="week-day-label">{{day.label}}</text>
            <text wx:if="{{day.shortMuscle}}" class="week-day-muscle">{{day.shortMuscle}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 动作预览列表（正常页面流渲染，完整展示绝不截断） -->
    <view
      class="exercises-section"
      wx:if="{{currentPlanData && currentPlanData.exercises && currentPlanData.exercises.length > 0}}"
    >
      <view class="section-header">
        <text class="section-title">{{currentPlanData.selectedDayIsToday ? '今日动作' : (currentPlanData.selectedDayLabel ? (currentPlanData.selectedDayLabel + '动作') : '训练动作')}}</text>
        <view class="section-link" data-plan-id="{{currentPlanData.plan.id}}" bindtap="onEditPlanExercises">
          <text>编辑计划</text>
          <text class="link-arrow">›</text>
        </view>
      </view>

      <view class="exercise-list">
        <view wx:for="{{currentPlanData.exercises}}"
              wx:key="id"
              class="exercise-item"
              bindtap="onTapTodayExercise"
              data-exercise-id="{{item.id}}">
          <view class="exercise-number">{{index + 1}}</view>
          <view class="exercise-content">
            <text class="exercise-name">{{item.name}}</text>
            <view class="exercise-details">
              <text class="exercise-sets">{{item.target_sets}}组 × {{item.target_reps}}次</text>
              <text class="exercise-sep">·</text>
              <text class="exercise-weight">{{item.target_weight}}kg</text>
            </view>
          </view>
          <view class="exercise-tag">{{item.muscle_group}}</view>
          <text class="exercise-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 有计划但该训练日尚未添加动作时的引导卡 -->
    <view
      class="plan-empty-ex-card"
      wx:elif="{{currentPlanData && (!currentPlanData.exercises || currentPlanData.exercises.length === 0)}}"
    >
      <text class="plan-empty-ex-title">{{currentPlanData.selectedDayLabel ? (currentPlanData.selectedDayLabel + ' 尚未添加动作') : '尚未添加训练动作'}}</text>
      <text class="plan-empty-ex-desc">给这一天安排几个动作，就能直接开始跟练并记录重量</text>
      <view class="plan-empty-ex-btn" data-plan-id="{{currentPlanData.plan.id}}" bindtap="onEditPlanExercises">
        <text>+ 去添加动作</text>
      </view>
    </view>
</view>

  <!-- 恢复训练弹窗（三层药丸权重 + 具体进度摘要，点遮罩仅收起不放弃） -->
  <modal-sheet
    visible="{{showRecoveryModal}}"
    title="发现未完成的训练"
    description="{{unfinishedSummary}}"
    showConfirm="{{false}}"
    showCancel="{{false}}"
    bind:close="onDismissRecoveryModal"
  >
    <view class="recovery-sheet-actions">
      <view class="recovery-btn-primary" bindtap="onRecoverTraining">
        <text>继续训练</text>
      </view>
      <view class="recovery-btn-secondary" bindtap="onDismissRecoveryModal">
        <text>暂不处理</text>
      </view>
      <view class="recovery-btn-abandon" bindtap="onAbandonTraining">
        <text>放弃本次训练</text>
      </view>
    </view>
  </modal-sheet>

  <!-- 底部吸屏主操作按钮（仅在存在激活计划且无悬浮条时显示） -->
  <view wx:if="{{todayPlan && currentPlanData && !hasMinimizedFloat}}" class="home-sticky-cta">
    <view
      wx:if="{{currentPlanData.session && currentPlanData.session.status !== 'completed' && currentPlanData.session.status !== 'aborted'}}"
      class="sticky-cta-btn"
      bindtap="onPrimaryAction"
    >
      <text>继续训练</text>
    </view>
    <view
      wx:elif="{{currentPlanData.isRoundCompleted}}"
      class="sticky-cta-btn"
      bindtap="onStartNewCycleRound"
    >
      <text>开启新一轮</text>
    </view>
    <view
      wx:elif="{{currentPlanData.exercises && currentPlanData.exercises.length > 0}}"
      class="sticky-cta-btn"
      bindtap="onPrimaryAction"
    >
      <text>{{currentPlanData.selectedDayCompleted ? ('再练一次 · ' + currentPlanData.selectedDayLabel) : (currentPlanData.selectedDayIsToday ? '开始训练' : ('开始训练 · 练' + currentPlanData.selectedDayLabel))}}</text>
    </view>
  </view>

  <!-- 动作要领与动图半屏抽屉 -->
  <exercise-guide-sheet
    visible="{{showExerciseGuide}}"
    exercise="{{guideExercise}}"
    bind:close="onCloseExerciseGuide"
  />

  <!-- 训练悬浮窗（含全局组间休息倒计时） -->
  <training-float />

  <!-- 页面实战高亮引导 -->
  <coach-tour
    visible="{{coachTour.visible}}"
    rect="{{coachTour.rect}}"
    title="{{coachTour.title}}"
    desc="{{coachTour.desc}}"
    stepText="{{coachTour.stepText}}"
    nextText="{{coachTour.nextText}}"
    isLast="{{coachTour.isLast}}"
    bind:next="onCoachTourNext"
    bind:skip="onCoachTourSkip"
  />

  <!-- 公共 4 步智能推荐半屏弹窗 -->
  <recommend-sheet
    visible="{{showRecommendModal}}"
    isOnboarding="{{recommendIsOnboarding}}"
    bind:apply="onApplyRecommendPlan"
    bind:close="onCloseRecommendModal"
  />

  <!-- 按需登录半屏抽屉 -->
  <login-sheet
    visible="{{loginSheet.visible}}"
    desc="{{loginSheet.desc}}"
    bind:success="onLoginSheetSuccess"
    bind:close="onLoginSheetClose"
  />

  <!-- 微信隐私保护指引弹窗 -->
  <privacy-popup />
</view>
