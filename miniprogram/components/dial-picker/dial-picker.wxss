/**
 * 刻度拨盘 — 原生 picker-view 精准居中风格
 * 移除横线，使用柔和的居中高亮底色，确保数字严格垂直居中
 */

.dial-picker {
  position: relative;
  width: 100%;
  height: 264rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
}

.dial-picker-view {
  width: 100%;
  height: 100%;
}

/* 居中选中区域：无黑线，仅保留柔和底色框 */
.dial-indicator {
  height: 88rpx;
  background: rgba(0, 0, 0, 0.035);
  border-radius: 16rpx;
}

.dial-indicator::before,
.dial-indicator::after {
  display: none;
  border: none;
}

/* 单项：严格与 indicator 88rpx 等高，确保垂直居中 */
.dial-item {
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 未选中项 — 灰色较小 */
.dial-item-value {
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-size: 34rpx;
  font-weight: 400;
  color: #B0B0B0;
  font-variant-numeric: tabular-nums;
  line-height: 1;
  transition: font-size 0.12s ease, color 0.12s ease;
}

/* 选中项 — 黑色大号加粗，严格居中 */
.dial-item--active .dial-item-value {
  font-size: 52rpx;
  font-weight: 800;
  color: #1A1A1A;
}

/* 单位文字 */
.dial-unit {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  font-weight: 500;
  color: #999999;
  z-index: 4;
  pointer-events: none;
}
