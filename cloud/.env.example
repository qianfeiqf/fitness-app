# 微信云托管服务端口（云托管默认 80，本地开发可用 3000）
PORT=80
NODE_ENV=production

# 微信小程序凭证（微信公众平台 -> 开发管理 -> 开发设置）
WX_APPID=wx2641939f5b17a140
WX_SECRET=your_wechat_app_secret

# JWT 签名密钥（建议 32 位以上随机字符串）
JWT_SECRET=replace_with_strong_random_secret

# MySQL 数据库连接（微信云托管数据库实例内网地址）
MYSQL_HOST=10.x.x.x
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=fitness

# 可选：额外允许的 CORS 来源
# CORS_ALLOW_ORIGIN=https://your-domain.com
