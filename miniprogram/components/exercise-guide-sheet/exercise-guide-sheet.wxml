<!-- 公共动作要领与历史记录半屏抽屉（z-index: 1200，可稳稳覆盖在选动作/替换抽屉之上） -->
<view wx:if="{{visible && exercise}}" class="ex-guide-overlay" bindtap="onClose" catchtouchmove="noop">
  <view class="ex-guide-sheet" catchtap="noop">
    <view class="ex-guide-handle"></view>

    <view class="ex-guide-header">
      <text class="ex-guide-title">{{exercise.name}}</text>
      <text wx:if="{{exercise.name_en}}" class="ex-guide-subtitle">{{exercise.name_en}}</text>
    </view>

    <!-- 动作要领 / 历史记录 极简切换栏 -->
    <view class="ex-guide-tabs">
      <view
        class="ex-guide-tab {{activeTab === 'guide' ? 'active' : ''}}"
        data-tab="guide"
        bindtap="onSwitchTab"
      >
        <text>动作要领</text>
      </view>
      <view
        class="ex-guide-tab {{activeTab === 'history' ? 'active' : ''}}"
        data-tab="history"
        bindtap="onSwitchTab"
      >
        <text>历史记录</text>
        <text wx:if="{{historySummary.sessionCount > 0}}" class="ex-guide-tab-count">{{historySummary.sessionCount}}</text>
      </view>
    </view>

    <scroll-view scroll-y class="ex-guide-scroll" show-scrollbar="{{false}}">
      <!-- Tab 1：动作要领 -->
      <block wx:if="{{activeTab === 'guide'}}">
        <view wx:if="{{exercise.gif_url && !gifLoadError}}" class="ex-guide-gif-wrap">
          <image
            class="ex-guide-gif"
            src="{{exercise.gif_url}}"
            mode="aspectFit"
            lazy-load="{{true}}"
            binderror="onGifError"
          />
        </view>

        <view class="ex-guide-tags">
          <text wx:if="{{exercise.muscle_group}}" class="ex-guide-tag">{{exercise.muscle_group}}{{exercise.sub_muscle ? ' · ' + exercise.sub_muscle : ''}}</text>
          <text wx:if="{{exercise.equipment}}" class="ex-guide-tag tag-equip">{{exercise.equipment}}</text>
          <text wx:if="{{exercise.is_system === false}}" class="ex-guide-tag">自定义动作</text>
        </view>

        <view wx:if="{{exercise.target_muscles}}" class="ex-guide-block">
          <text class="ex-guide-label">目标肌群</text>
          <text class="ex-guide-text">{{exercise.target_muscles}}</text>
        </view>

        <view wx:if="{{exercise.description}}" class="ex-guide-block">
          <text class="ex-guide-label">动作要领</text>
          <text class="ex-guide-text">{{exercise.description}}</text>
        </view>

        <view wx:if="{{exercise.tips}}" class="ex-guide-block ex-guide-tips">
          <text class="ex-guide-label">呼吸与避坑</text>
          <text class="ex-guide-text">{{exercise.tips}}</text>
        </view>

        <view wx:if="{{!exercise.description}}" class="ex-guide-block">
          <text class="ex-guide-text">自定义动作暂无要领说明，可在训练或编排计划时直接使用。</text>
        </view>

        <view wx:if="{{allowDelete && exercise.is_system === false}}" class="ex-guide-delete" bindtap="onDelete">
          <text>删除此自定义动作</text>
        </view>
      </block>

      <!-- Tab 2：历史记录 -->
      <block wx:else>
        <view wx:if="{{historyList.length > 0}}" class="ex-history-wrap">
          <!-- 核心摘要条 -->
          <view class="ex-history-summary">
            <view class="ex-history-stat">
              <text class="ex-history-stat-val highlight">{{historySummary.best1RM}}<text class="ex-history-stat-unit">kg</text></text>
              <text class="ex-history-stat-label">最佳预估 1RM</text>
            </view>
            <view class="ex-history-divider"></view>
            <view class="ex-history-stat">
              <text class="ex-history-stat-val">{{historySummary.maxWeight}}<text class="ex-history-stat-unit">kg</text></text>
              <text class="ex-history-stat-label">最大重量</text>
            </view>
            <view class="ex-history-divider"></view>
            <view class="ex-history-stat">
              <text class="ex-history-stat-val">{{historySummary.sessionCount}}<text class="ex-history-stat-unit">次</text></text>
              <text class="ex-history-stat-label">累计训练</text>
            </view>
          </view>

          <!-- 按日期倒序的历史记录卡片 -->
          <view wx:for="{{historyList}}" wx:key="sessionId" class="ex-history-card">
            <view class="ex-history-card-head">
              <view class="ex-history-date-wrap">
                <text class="ex-history-date">{{item.dateText}}</text>
                <text wx:if="{{item.planName}}" class="ex-history-plan">{{item.planName}}</text>
              </view>
              <view class="ex-history-rm-wrap">
                <text wx:if="{{item.isPR}}" class="ex-history-pr-tag">PR</text>
                <text class="ex-history-rm">预估 1RM {{item.best1RM}}kg</text>
              </view>
            </view>
            <view class="ex-history-sets">
              <view wx:for="{{item.sets}}" wx:for-item="set" wx:key="displayIndex" class="ex-history-set-chip">
                <text class="ex-history-set-idx">{{set.displayIndex}}</text>
                <text class="ex-history-set-val">{{set.weightText}}kg × {{set.reps}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:else class="ex-history-empty">
          <text class="ex-history-empty-title">暂无训练记录</text>
          <text class="ex-history-empty-desc">完成该动作的任意一组训练后，这里会自动记录每次重量、组次与预估 1RM</text>
        </view>
      </block>
    </scroll-view>

    <view class="ex-guide-footer">
      <view class="ex-guide-close-btn" bindtap="onClose">知道了</view>
    </view>
  </view>
</view>
