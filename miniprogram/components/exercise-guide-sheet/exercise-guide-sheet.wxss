/* 公共动作要领与历史记录半屏抽屉样式（高于 modal-sheet 的 1000，确保多层弹窗不遮挡） */

.ex-guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: exGuideFadeIn 0.2s ease-out;
}

.ex-guide-sheet {
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 20rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  animation: exGuideSlideUp 0.25s ease-out;
}

.ex-guide-handle {
  width: 56rpx;
  height: 6rpx;
  background: #E2E4E8;
  border-radius: 9999rpx;
  margin: 0 auto 20rpx;
  flex-shrink: 0;
}

.ex-guide-header {
  text-align: center;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

.ex-guide-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.3;
}

.ex-guide-subtitle {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-top: 6rpx;
}

/* 顶部双 Tab 切换器 */
.ex-guide-tabs {
  display: flex;
  padding: 6rpx;
  background: #F4F5F7;
  border-radius: 9999rpx;
  margin-bottom: 22rpx;
  flex-shrink: 0;
}

.ex-guide-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 9999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #666666;
  transition: all 0.15s ease;
}

.ex-guide-tab.active {
  background: #1A1A1A;
  color: #FFFFFF;
  font-weight: 600;
}

.ex-guide-tab-count {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.08);
  color: #666666;
  font-family: 'DIN Alternate', system-ui, sans-serif;
}

.ex-guide-tab.active .ex-guide-tab-count {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
}

.ex-guide-scroll {
  flex: 1;
  min-height: 0;
  max-height: 54vh;
}

.ex-guide-gif-wrap {
  width: 100%;
  height: 340rpx;
  background: #F7F8FA;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.ex-guide-gif {
  width: 320rpx;
  height: 320rpx;
}

.ex-guide-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.ex-guide-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #1A1A1A;
  background: #F2F3F5;
  padding: 6rpx 18rpx;
  border-radius: 9999rpx;
}

.ex-guide-tag.tag-equip {
  color: #07C160;
  background: #EAF9F0;
}

.ex-guide-block {
  margin-bottom: 22rpx;
}

.ex-guide-block:last-child {
  margin-bottom: 8rpx;
}

.ex-guide-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.ex-guide-text {
  display: block;
  font-size: 26rpx;
  color: #555555;
  line-height: 1.7;
}

.ex-guide-tips {
  padding: 20rpx 22rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
}

.ex-guide-delete {
  margin-top: 20rpx;
  padding: 12rpx 0 4rpx;
  text-align: center;
  font-size: 26rpx;
  color: #FA5151;
}

/* 历史记录 Tab */
.ex-history-wrap {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 8rpx;
}

.ex-history-summary {
  display: flex;
  align-items: center;
  background: #1A1A1A;
  border-radius: 22rpx;
  padding: 26rpx 16rpx;
}

.ex-history-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.ex-history-stat-val {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.ex-history-stat-val.highlight {
  color: #07C160;
}

.ex-history-stat-unit {
  font-size: 20rpx;
  font-weight: 500;
  margin-left: 4rpx;
  opacity: 0.78;
}

.ex-history-stat-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.56);
}

.ex-history-divider {
  width: 1rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.14);
}

.ex-history-card {
  background: #F7F8FA;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
}

.ex-history-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ex-history-date-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  flex: 1;
}

.ex-history-date {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex-shrink: 0;
}

.ex-history-plan {
  font-size: 22rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ex-history-rm-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.ex-history-pr-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #07C160;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
}

.ex-history-rm {
  font-size: 22rpx;
  font-weight: 600;
  color: #555555;
  font-variant-numeric: tabular-nums;
}

.ex-history-sets {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ex-history-set-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.ex-history-set-idx {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #F0F1F4;
  color: #666666;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'DIN Alternate', system-ui, sans-serif;
}

.ex-history-set-val {
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.ex-history-empty {
  padding: 72rpx 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.ex-history-empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.ex-history-empty-desc {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.6;
  max-width: 480rpx;
}

.ex-guide-footer {
  margin-top: 24rpx;
  flex-shrink: 0;
}

.ex-guide-close-btn {
  height: 88rpx;
  border-radius: 9999rpx;
  background: #F5F6F8;
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ex-guide-close-btn:active {
  background: #EAECEF;
}

@keyframes exGuideFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes exGuideSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
