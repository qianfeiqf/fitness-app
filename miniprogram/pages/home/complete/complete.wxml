<!-- 训练完成页面 - 浅色简约 -->

<view class="page-complete">
  <!-- 完成标志 -->
  <view class="complete-header">
    <view class="complete-icon-native">
      <icon type="success" size="56" color="#07C160" />
    </view>
    <text class="complete-title">训练完成</text>
    <text class="complete-subtitle">{{session ? session.plan_name : ''}}</text>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-cards">
    <view class="stat-card">
      <text class="stat-value">{{completedSets.length}}</text>
      <text class="stat-label">完成组数</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{totalVolume}}</text>
      <text class="stat-label">总容量(kg)</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{duration}}</text>
      <text class="stat-label">训练时长</text>
    </view>
  </view>

  <!-- PR展示 -->
  <view wx:if="{{prCount > 0}}" class="pr-section">
    <view class="pr-banner">
      <mp-icon icon="star" color="#07C160" size="{{20}}" />
      <text class="pr-text">恭喜刷新 {{prCount}} 个个人纪录</text>
    </view>
  </view>

  <!-- 演进预览 -->
  <view wx:if="{{showProgressions}}" class="progression-section">
    <text class="section-title">下次训练重量</text>
    <view class="progression-list">
      <view 
        wx:for="{{progressions}}" 
        wx:key="exerciseId"
        class="progression-item"
      >
        <view class="progression-info">
          <text class="progression-name">{{item.exerciseName}}</text>
          <text class="progression-reason">{{item.reason}}</text>
        </view>
        <view class="progression-change">
          <text class="weight-current">{{item.currentWeight}}kg</text>
          <text class="weight-arrow">→</text>
          <text class="weight-next {{item.type === 'progression' ? 'up' : item.type === 'deload' ? 'down' : ''}}">{{item.nextWeight}}kg</text>
          <view class="progression-badge {{item.type}}">
            <text wx:if="{{item.type === 'progression'}}">↑</text>
            <text wx:elif="{{item.type === 'deload'}}">↓</text>
            <text wx:else>→</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 完成动作列表（按动作分组展示） -->
  <view class="completed-list">
    <text class="section-title">完成动作</text>
    <view wx:for="{{groupedSets}}" wx:key="exercise_id" class="completed-group">
      <view class="completed-group-header">
        <text class="completed-group-name">{{item.exercise_name}}</text>
        <text class="completed-group-count">{{item.sets.length}} 组</text>
      </view>
      <view class="completed-group-sets">
        <view wx:for="{{item.sets}}" wx:for-item="set" wx:key="id" class="completed-set-row">
          <text class="completed-set-num">第{{set.set_number}}组</text>
          <text class="completed-set-val">{{set.actual_weight}}kg × {{set.actual_reps}}次</text>
          <view wx:if="{{set.is_pr}}" class="pr-badge">PR</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 分享按钮 -->
  <view class="share-section">
    <button class="btn btn-share btn-block" bindtap="onShareCard">
      <mp-icon icon="share" color="#1A1A1A" size="{{18}}" />
      <text>生成分享卡片</text>
    </button>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="btn btn-secondary btn-block" bindtap="onViewStats">查看统计</button>
    <button class="btn btn-primary btn-block" bindtap="onBackHome">返回首页</button>
  </view>

  <!-- 分享画布 (绝对定位在屏幕外) -->
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
