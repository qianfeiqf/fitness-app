<!-- 计划详情页面 — 浅灰底无边框白卡极简风格 -->

<view class="page-detail">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <mp-loading type="circular" color="#1A1A1A" size="{{64}}" />
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 计划内容 -->
  <view wx:else class="plan-content">
    <!-- 计划头部卡 -->
    <view class="plan-header">
      <view class="plan-title-row">
        <text class="plan-name">{{plan.name}}</text>
        <text wx:if="{{plan.status === 'active'}}" class="badge badge-active">进行中</text>
        <text wx:elif="{{plan.status === 'archived'}}" class="badge badge-paused">已暂停</text>
        <text wx:elif="{{plan.status === 'template'}}" class="badge badge-template">经典计划</text>
        <text wx:else class="badge badge-paused">草稿</text>
      </view>
      <text wx:if="{{plan.description}}" class="plan-desc">{{plan.description}}</text>

      <!-- 核心频率与难度胶囊 -->
      <view class="meta-tags">
        <text wx:if="{{isTemplate && plan.difficulty}}" class="meta-tag">{{plan.difficulty}}</text>
        <text class="meta-tag">每周 {{activeDayCount}} 天训练</text>
        <text wx:if="{{restDayCount > 0}}" class="meta-tag">{{restDayCount}} 天休息</text>
        <text class="meta-tag">共 {{exercises.length}} 个动作</text>
      </view>

      <!-- 模板介绍展开 -->
      <view wx:if="{{isTemplate && (plan.background || plan.suitable_for || plan.notes)}}" class="intro-section">
        <view class="intro-toggle" bindtap="onToggleIntro">
          <text class="intro-toggle-text">{{showIntro ? '收起详细介绍' : '查看详细介绍'}}</text>
          <text class="intro-toggle-icon">{{showIntro ? '▴' : '▾'}}</text>
        </view>
        <view wx:if="{{showIntro}}" class="intro-content">
          <view wx:if="{{plan.background}}" class="intro-block">
            <text class="intro-title">产生背景</text>
            <text class="intro-text">{{plan.background}}</text>
          </view>
          <view wx:if="{{plan.suitable_for}}" class="intro-block">
            <text class="intro-title">适用对象</text>
            <text class="intro-text">{{plan.suitable_for}}</text>
          </view>
          <view wx:if="{{plan.notes}}" class="intro-block">
            <text class="intro-title">注意事项</text>
            <text class="intro-text">{{plan.notes}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 周期安排标题 -->
    <view class="schedule-header">
      <text class="schedule-title">训练安排</text>
      <text class="schedule-subtitle">点击动作查看动图与要领</text>
    </view>

    <!-- 仅展示有动作的训练日卡片（不再堆砌休息日空卡片） -->
    <view wx:if="{{trainingDaysList.length > 0}}" class="week-schedule">
      <view wx:for="{{trainingDaysList}}"
            wx:key="day"
            class="day-section">
        <view class="day-header">
          <text class="day-name">{{item.dayName}}</text>
          <text class="day-count">{{item.exercises.length}} 个动作</text>
        </view>

        <view class="day-exercises">
          <view wx:for="{{item.exercises}}"
                wx:for-item="ex"
                wx:key="index"
                class="exercise-card"
                bindtap="onViewExerciseDetail"
                data-exercise-id="{{ex.exercise_id}}">
            <view class="exercise-num">{{index + 1}}</view>
            <view class="exercise-main">
              <view class="exercise-name-row">
                <text class="exercise-name">{{ex.exercise_name}}</text>
                <text wx:if="{{ex.muscle_group}}" class="exercise-muscle-pill">{{ex.muscle_group}}</text>
              </view>
              <text class="exercise-sets">{{ex.target_sets}}组 × {{ex.target_reps}}次 · {{ex.initial_weight}}kg · 休{{ex.rest_seconds || 120}}秒</text>
            </view>
            <text class="exercise-arrow">›</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-schedule">
      <text class="empty-schedule-text">该计划尚未添加训练动作</text>
    </view>

    <!-- 低频危险操作收在列表最底部，避免底部操作栏臃肿或误触 -->
    <view wx:if="{{!isTemplate}}" class="delete-plan-wrap">
      <text class="delete-plan-link" bindtap="onDeletePlan">删除此计划</text>
    </view>

    <!-- 底部精简药丸操作栏 -->
    <view class="action-buttons">
      <!-- 模板模式：轻量预期提示 + 唯一绿色主按钮 -->
      <block wx:if="{{isTemplate}}">
        <text class="template-use-hint">点击按需调整训练日、动作与重量</text>
        <view class="detail-btn primary" bindtap="onUseTemplate">
          <text>使用此计划</text>
        </view>
      </block>
      <!-- 用户计划模式：单行双药丸按钮（左：暂停/恢复，右：编辑计划） -->
      <view wx:else class="action-btn-row">
        <view
          wx:if="{{plan.status === 'active'}}"
          class="detail-btn secondary"
          bindtap="onArchivePlan"
        >
          <text>暂停计划</text>
        </view>
        <view
          wx:else
          class="detail-btn primary-soft"
          bindtap="onActivatePlan"
        >
          <text>恢复计划</text>
        </view>
        <view class="detail-btn dark" bindtap="onEditPlan">
          <text>编辑计划</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 删除计划极简底部确认抽屉 -->
  <modal-sheet
    visible="{{showDeleteModal}}"
    title="删除计划"
    description="删除「{{plan ? plan.name : ''}}」后无法恢复"
    showConfirm="{{false}}"
    showCancel="{{false}}"
    bind:close="onCancelDeletePlan"
  >
    <view class="delete-sheet-actions">
      <view class="detail-btn danger" bindtap="onConfirmDeletePlan">
        <text>确认删除</text>
      </view>
      <view class="detail-btn secondary" bindtap="onCancelDeletePlan">
        <text>取消</text>
      </view>
    </view>
  </modal-sheet>

  <!-- 动作要领与动图半屏抽屉 -->
  <exercise-guide-sheet
    visible="{{showExerciseDetail}}"
    exercise="{{detailExercise}}"
    bind:close="onCloseExerciseDetail"
  />

  <!-- 按需登录半屏抽屉 -->
  <login-sheet
    visible="{{loginSheet.visible}}"
    desc="{{loginSheet.desc}}"
    bind:success="onLoginSheetSuccess"
    bind:close="onLoginSheetClose"
  />
</view>
