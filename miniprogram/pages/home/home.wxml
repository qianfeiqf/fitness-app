<!-- 训练中心首页 - 浅色简约 -->

<view class="page-home" style="padding-top: {{navHeight}}px;">
  <!-- 顶部欢迎区 -->
  <view class="welcome-section">
    <view class="welcome-content">
      <text class="welcome-greeting">{{isLoggedIn ? '今日' : '欢迎'}}</text>
      <text class="welcome-title">{{isLoggedIn ? '开始训练' : '开启硬核之旅'}}</text>
    </view>
    <view class="date-widget">
      <text class="date-day">{{todayDate}}</text>
      <text class="date-week">{{todayWeek}}</text>
    </view>
  </view>

  <!-- 未登录状态 -->
  <view wx:if="{{!isLoggedIn}}" class="login-section">
    <view class="login-hero">
      <view class="login-avatar">
        <mp-icon icon="me" color="#1A1A1A" size="{{36}}" />
      </view>
      <text class="login-headline">准备好突破了</text>
      <text class="login-subhead">登录后同步训练数据，追踪你的每一步进步</text>
    </view>
    <button class="btn-login" bindtap="onLogin">微信一键登录</button>
  </view>

  <!-- 加载状态 -->
  <view wx:elif="{{loading}}" class="loading-section">
    <view class="skeleton-wrapper">
      <view class="skeleton-block tall"></view>
      <view class="skeleton-block medium"></view>
      <view class="skeleton-block short"></view>
    </view>
  </view>

  <!-- 无训练计划 -->
  <view wx:elif="{{!todayPlan}}" class="empty-section">
    <view class="empty-visual">
      <mp-icon icon="add2" color="#CCCCCC" size="{{44}}" />
    </view>
    <text class="empty-title">还没有训练计划</text>
    <text class="empty-desc">选择一个计划，或者直接进入自由训练边练边记</text>
    <button class="btn-cta" bindtap="onGoToPlans">
      <text>浏览计划库</text>
      <text class="btn-cta-arrow">→</text>
    </button>
    <view class="free-workout-empty-btn {{activeFreeSession ? 'active' : ''}}" bindtap="onStartFreeWorkout">
      <text class="free-workout-plus">{{activeFreeSession ? '▶' : '+'}}</text>
      <text>{{activeFreeSession ? '继续进行中的自由训练' : '开始自由训练'}}</text>
    </view>
  </view>

  <!-- 今日训练 -->
  <view wx:else class="training-section">
    <!-- 云端同步失败重试条 -->
    <view wx:if="{{syncFailed}}" class="home-tip-banner warn">
      <icon type="warn" size="18" color="#D97706" />
      <text class="home-tip-text">云端同步失败，请检查网络</text>
      <text class="home-tip-action" bindtap="onRetrySync">重试</text>
    </view>

    <!-- 首次完善身体档案轻提示条（非阻塞） -->
    <view wx:if="{{showProfileBanner}}" class="home-tip-banner">
      <icon type="info" size="18" color="#07C160" />
      <text class="home-tip-text">填写体重，1RM 与重量推荐更准确</text>
      <text class="home-tip-action" bindtap="onGoToProfileBanner">去填写</text>
      <view class="home-tip-close" bindtap="onDismissProfileBanner">
        <mp-icon icon="close" color="#999999" size="{{14}}" />
      </view>
    </view>

    <!-- 自由训练快捷入口（有进行中会话时高亮提示直接续练） -->
    <view class="free-workout-bar {{activeFreeSession ? 'active' : ''}}" bindtap="onStartFreeWorkout">
      <view class="free-workout-left">
        <mp-icon
          icon="{{activeFreeSession ? 'play2' : 'add2'}}"
          color="{{activeFreeSession ? '#07C160' : '#1A1A1A'}}"
          size="{{24}}"
        />
        <view class="free-workout-info">
          <text class="free-workout-title">{{activeFreeSession ? '进行中的自由训练' : '自由训练'}}</text>
          <text class="free-workout-desc">{{activeFreeSession ? activeFreeSummary : '随练随记，不按计划'}}</text>
        </view>
      </view>
      <text class="free-workout-btn">{{activeFreeSession ? '继续 ›' : '开始 ›'}}</text>
    </view>
    <!-- Deload 提醒横幅 -->
    <view wx:if="{{showDeloadReminder}}" class="deload-banner" bindtap="onDismissDeloadReminder">
      <icon type="warn" size="20" color="#D97706" />
      <view class="deload-content">
        <text class="deload-title">建议安排减载周</text>
        <text class="deload-desc">你已持续高强度训练 6 周，建议本周降低重量 10-20% 进行恢复</text>
      </view>
      <mp-icon icon="close" color="#999999" size="{{14}}" />
    </view>

    <!-- 多计划切换栏 -->
    <view wx:if="{{planDataList.length > 1}}" class="plan-tabs-section">
      <scroll-view class="plan-tabs-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="plan-tabs-list">
          <view
            wx:for="{{planDataList}}"
            wx:key="id"
            class="plan-tab-pill {{index === currentPlanIndex ? 'active' : ''}}"
            data-index="{{index}}"
            bindtap="onSelectPlanTab"
          >
            <text class="plan-tab-name">{{item.plan.name}}</text>
            <text class="plan-tab-tag">{{item.isRestDay ? '休' : '练'}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 主内容 — 左右滑动切换计划 -->
    <swiper
      wx:if="{{planDataList.length > 0}}"
      class="plan-swiper"
      style="height: {{swiperHeight}}rpx;"
      current="{{currentPlanIndex}}"
      bindchange="onPlanChange"
      duration="300"
    >
      <swiper-item wx:for="{{planDataList}}" wx:key="id" wx:for-item="pd">
        <scroll-view scroll-y class="plan-scroll-view" style="height: {{swiperHeight}}rpx;" show-scrollbar="{{false}}">
        <!-- 本周概览：进度与Streak -->
        <view class="week-overview">
          <view class="progress-ring-wrap">
            <view class="progress-ring-bg">
              <view class="progress-ring-fill" style="background: conic-gradient(#1A1A1A {{pd.weekProgress.percent * 3.6}}deg, #F0F0F0 0deg);"></view>
              <view class="progress-ring-center">
                <text class="progress-ring-num">{{pd.weekProgress.completedDays}}</text>
                <text class="progress-ring-total">/ {{pd.weekProgress.plannedDays}} 天</text>
              </view>
            </view>
            <text class="progress-ring-label">本周训练</text>
          </view>
          <view class="streak-wrap" wx:if="{{streak > 0}}">
            <text class="streak-num">{{streak}}</text>
            <text class="streak-label">连续训练天</text>
          </view>
        </view>

        <!-- 训练卡片 -->
        <view class="training-card">
          <view class="card-accent"></view>

          <!-- 休息日提示（单计划时轻量带出计划名，多计划时由顶部页签承载避免重复） -->
          <view wx:if="{{pd.isRestDay}}" class="rest-day-inline">
            <mp-icon icon="time" color="#666666" size="{{26}}" />
            <view class="rest-day-inline-content">
              <text class="rest-day-inline-title">今日是休息日</text>
              <text class="rest-day-inline-desc">{{planDataList.length === 1 ? pd.plan.name + ' · ' : ''}}适当放松，让身体恢复，明天继续加油</text>
            </view>
          </view>

          <view wx:else>
            <view class="card-header-modern">
              <view class="card-meta">
                <text class="card-label">TODAY</text>
                <text class="card-title">{{pd.plan.name}}</text>
              </view>
              <view class="card-badge">
                <text class="badge-pill">{{pd.exercises.length}} 个动作</text>
              </view>
            </view>

            <!-- 训练数据网格 -->
            <view class="stats-grid">
              <view class="stat-item">
                <text class="stat-value">{{pd.estimatedMinutes}}</text>
                <text class="stat-label">分钟</text>
              </view>
              <view class="stat-divider"></view>
              <view class="stat-item">
                <text class="stat-value">{{pd.totalSets}}</text>
                <text class="stat-label">组数</text>
              </view>
              <view class="stat-divider"></view>
              <view class="stat-item">
                <text class="stat-value-sm">{{pd.muscleGroups}}</text>
                <text class="stat-label">肌群</text>
              </view>
            </view>

            <!-- 主按钮 -->
            <view class="card-action">
              <button wx:if="{{!pd.session || pd.session.status === 'completed' || pd.session.status === 'aborted'}}"
                      class="btn-start"
                      data-plan-id="{{pd.plan.id}}"
                      bindtap="onStartTrainingForPlan">
                <text class="btn-start-icon">▶</text>
                <text class="btn-start-text">开始训练</text>
              </button>
              <button wx:else
                      class="btn-resume"
                      data-session-id="{{pd.session.id}}"
                      bindtap="onResumeTrainingForPlan">
                <text class="btn-start-icon">▶</text>
                <text class="btn-start-text">继续训练</text>
              </button>
            </view>
          </view>
        </view>

        <!-- 动作预览列表 -->
        <view class="exercises-section" wx:if="{{pd.exercises.length > 0}}">
          <view class="section-header">
            <text class="section-title">动作预览</text>
            <view class="section-link" data-plan-id="{{pd.plan.id}}" bindtap="onPreviewPlanById">
              <text>查看详情</text>
              <text class="link-arrow">›</text>
            </view>
          </view>

          <view class="exercise-list">
            <view wx:for="{{pd.exercises}}"
                  wx:key="id"
                  class="exercise-item">
              <view class="exercise-number">{{index + 1}}</view>
              <view class="exercise-content">
                <text class="exercise-name">{{item.name}}</text>
                <view class="exercise-details">
                  <text class="exercise-sets">{{item.target_sets}}组 × {{item.target_reps}}次</text>
                  <text class="exercise-sep">·</text>
                  <text class="exercise-weight">{{item.target_weight}}kg</text>
                </view>
              </view>
              <view class="exercise-tag">{{item.muscle_group}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>

  <!-- 恢复训练弹窗 -->
  <modal-sheet
    visible="{{showRecoveryModal}}"
    title="发现未完成的训练"
    description="你有一项训练进行中，继续完成还是放弃？"
    confirmText="继续"
    cancelText="放弃"
    bind:confirm="onRecoverTraining"
    bind:cancel="onAbandonTraining"
    bind:close="onAbandonTraining"
  >
    <view class="modal-icon-wrap" style="text-align:center;margin-bottom:16rpx;">
      <icon type="info" size="40" color="#07C160" />
    </view>
  </modal-sheet>

  <!-- 训练悬浮窗（含全局组间休息倒计时） -->
  <training-float />

  <!-- 微信隐私保护指引弹窗 -->
  <privacy-popup />
</view>
