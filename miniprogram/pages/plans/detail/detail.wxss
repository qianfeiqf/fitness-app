/* 计划详情页面样式 */

.page-detail {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-top: 24rpx;
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  gap: 24rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666666;
}

/* 计划头部 */
.plan-header {
  margin: 0 32rpx 28rpx;
  padding: 28rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
}

.plan-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.plan-name {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #1A1A1A;
}

.plan-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: block;
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.badge-success {
  background-color: #E8F5E9;
  color: #2E7D32;
}

.badge-secondary {
  background-color: #F5F5F5;
  color: #666666;
}

.badge-warning {
  background-color: #FFF3E0;
  color: #E65100;
}

.badge-info {
  background-color: #E3F2FD;
  color: #1565C0;
}

/* 模板标签 */
.template-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  flex-wrap: wrap;
}

.template-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-green {
  background-color: #E8F5E9;
  color: #2E7D32;
}

.tag-yellow {
  background-color: #FFF8E1;
  color: #F57F17;
}

.tag-red {
  background-color: #FFEBEE;
  color: #C62828;
}

.tag-gray {
  background-color: #F5F5F5;
  color: #666666;
}

/* 介绍展开区 */
.intro-section {
  margin-top: 24rpx;
  border-top: 1rpx solid #EEEEEE;
  padding-top: 20rpx;
}

.intro-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.intro-toggle-text {
  font-size: 26rpx;
  color: #1565C0;
  font-weight: 500;
}

.intro-toggle-icon {
  font-size: 24rpx;
  color: #1565C0;
}

.intro-content {
  margin-top: 16rpx;
}

.intro-block {
  margin-bottom: 24rpx;
}

.intro-block:last-child {
  margin-bottom: 0;
}

.intro-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.intro-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.7;
  display: block;
}

/* 周期安排标题 */
.schedule-header {
  margin: 0 32rpx 20rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.schedule-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.schedule-subtitle {
  font-size: 24rpx;
  color: #999999;
}

/* 周计划 */
.week-schedule {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin: 0 32rpx;
}

.day-section {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.day-section.rest-day {
  opacity: 0.7;
}

.day-section.has-exercises {
  /* 有训练内容的日期 */
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  background-color: #FAFAFA;
}

.day-label-group {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.day-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.day-count {
  font-size: 22rpx;
  color: #666666;
  font-weight: 500;
}

.rest-badge {
  font-size: 22rpx;
  color: #999999;
  font-weight: 500;
  padding: 4rpx 16rpx;
  background-color: #F0F0F0;
  border-radius: 9999rpx;
}

.day-exercises {
  padding: 8rpx 28rpx 16rpx;
}

.exercise-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.exercise-card:last-child {
  border-bottom: none;
}

.exercise-main {
  flex: 1;
  min-width: 0;
}

.exercise-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 4rpx;
}

.exercise-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
}

.exercise-muscle {
  font-size: 22rpx;
  color: #999999;
  display: block;
  margin-bottom: 6rpx;
}

.exercise-sets {
  font-size: 24rpx;
  color: #666666;
  display: block;
}

/* 视频按钮 */
.video-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background-color: #E3F2FD;
  border-radius: 9999rpx;
  flex-shrink: 0;
}

.video-icon {
  font-size: 20rpx;
  color: #1565C0;
}

.video-text {
  font-size: 22rpx;
  color: #1565C0;
  font-weight: 500;
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary {
  background: #07C160;
  color: #FFFFFF;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background-color: #F5F5F5;
  color: #666666;
}

.btn-outline {
  background: transparent;
  color: #666666;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
}

.btn-block {
  width: 100%;
}


