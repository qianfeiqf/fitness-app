<!-- 计划详情页面 -->

<view class="page-detail">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <mp-loading type="circular" color="#1A1A1A" size="{{64}}" />
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 计划内容 -->
  <view wx:else class="plan-content">
    <!-- 计划头部 -->
    <view class="plan-header">
      <view class="plan-title-row">
        <text class="plan-name">{{plan.name}}</text>
        <text wx:if="{{plan.status === 'active'}}" class="badge badge-success">进行中</text>
        <text wx:elif="{{plan.status === 'archived'}}" class="badge badge-secondary">已归档</text>
        <text wx:elif="{{plan.status === 'template'}}" class="badge badge-info">经典计划</text>
        <text wx:else class="badge badge-warning">草稿</text>
      </view>
      <text class="plan-desc">{{plan.description || '暂无描述'}}</text>

      <!-- 模板标签 -->
      <view wx:if="{{isTemplate}}" class="template-tags">
        <text class="template-tag {{plan.difficulty === '入门' ? 'tag-green' : plan.difficulty === '进阶' ? 'tag-red' : 'tag-yellow'}}">{{plan.difficulty}}</text>
        <text class="template-tag tag-gray">每周{{plan.training_days}}天</text>
      </view>

      <!-- 模板介绍展开 -->
      <view wx:if="{{isTemplate && (plan.background || plan.suitable_for || plan.notes)}}" class="intro-section">
        <view class="intro-toggle" bindtap="onToggleIntro">
          <text class="intro-toggle-text">{{showIntro ? '收起介绍' : '查看详细介绍'}}</text>
          <text class="intro-toggle-icon">{{showIntro ? '▲' : '▼'}}</text>
        </view>
        <view wx:if="{{showIntro}}" class="intro-content">
          <view wx:if="{{plan.background}}" class="intro-block">
            <text class="intro-title">产生背景</text>
            <text class="intro-text">{{plan.background}}</text>
          </view>
          <view wx:if="{{plan.suitable_for}}" class="intro-block">
            <text class="intro-title">适用对象</text>
            <text class="intro-text">{{plan.suitable_for}}</text>
          </view>
          <view wx:if="{{plan.notes}}" class="intro-block">
            <text class="intro-title">注意事项</text>
            <text class="intro-text">{{plan.notes}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 周期安排标题 -->
    <view class="schedule-header">
      <text class="schedule-title">训练安排</text>
      <text class="schedule-subtitle">{{plan.training_days ? '每周 ' + plan.training_days + ' 天 · ' : ''}}共 {{exercises.length}} 个动作</text>
    </view>

    <!-- 周训练安排 -->
    <view class="week-schedule">
      <view wx:for="{{weekSchedule}}"
            wx:key="day"
            class="day-section {{item.isRest ? 'rest-day' : 'has-exercises'}}">
        <view class="day-header">
          <view class="day-label-group">
            <text class="day-name">{{item.dayName}}</text>
            <text wx:if="{{!item.isRest}}" class="day-count">{{item.exercises.length}}个动作</text>
          </view>
          <text wx:if="{{item.isRest}}" class="rest-badge">休息日</text>
        </view>

        <view wx:if="{{!item.isRest}}" class="day-exercises">
          <view wx:for="{{item.exercises}}"
                wx:for-item="ex"
                wx:key="id"
                class="exercise-card">
            <view class="exercise-main">
              <view class="exercise-name-row">
                <text class="exercise-name">{{ex.exercise_name}}</text>
                <view wx:if="{{ex.video_url}}" class="video-btn"
                      bindtap="onViewVideo"
                      data-video-url="{{ex.video_url}}"
                      data-exercise-name="{{ex.exercise_name}}">
                  <text class="video-icon">▶</text>
                  <text class="video-text">教学</text>
                </view>
              </view>
              <text wx:if="{{ex.muscle_group}}" class="exercise-muscle">{{ex.muscle_group}}</text>
              <text class="exercise-sets">{{ex.target_sets}}组 × {{ex.target_reps}}次 · 初始 {{ex.initial_weight}}kg · 休{{ex.rest_seconds}}秒</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <!-- 模板模式：使用此计划 -->
      <button wx:if="{{isTemplate}}"
              class="btn btn-primary btn-block"
              bindtap="onUseTemplate">
        使用此计划
      </button>
      <!-- 用户计划模式 -->
      <button wx:if="{{!isTemplate && plan.status !== 'active'}}"
              class="btn btn-primary btn-block"
              bindtap="onActivatePlan">
        激活此计划
      </button>
      <button wx:if="{{!isTemplate}}" class="btn btn-secondary btn-block"
              bindtap="onEditPlan">
        编辑计划
      </button>
      <button wx:if="{{!isTemplate}}" class="btn btn-outline btn-block"
              bindtap="onDeletePlan">
        删除计划
      </button>
    </view>
  </view>

  <!-- 返回按钮 -->
  <view class="back-button" bindtap="onBack">
    <text class="back-icon">←</text>
  </view>
</view>
