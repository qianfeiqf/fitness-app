/* 公共动作要领半屏抽屉样式（高于 modal-sheet 的 1000，确保多层弹窗不遮挡） */

.ex-guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1200;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  animation: exGuideFadeIn 0.2s ease-out;
}

.ex-guide-sheet {
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 20rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  animation: exGuideSlideUp 0.25s ease-out;
}

.ex-guide-handle {
  width: 56rpx;
  height: 6rpx;
  background: #E2E4E8;
  border-radius: 9999rpx;
  margin: 0 auto 22rpx;
  flex-shrink: 0;
}

.ex-guide-header {
  text-align: center;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

.ex-guide-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.3;
}

.ex-guide-subtitle {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-top: 6rpx;
}

.ex-guide-scroll {
  flex: 1;
  min-height: 0;
  max-height: 58vh;
}

.ex-guide-gif-wrap {
  width: 100%;
  height: 340rpx;
  background: #F7F8FA;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.ex-guide-gif {
  width: 320rpx;
  height: 320rpx;
}

.ex-guide-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.ex-guide-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #1A1A1A;
  background: #F2F3F5;
  padding: 6rpx 18rpx;
  border-radius: 9999rpx;
}

.ex-guide-tag.tag-equip {
  color: #07C160;
  background: #EAF9F0;
}

.ex-guide-block {
  margin-bottom: 22rpx;
}

.ex-guide-block:last-child {
  margin-bottom: 8rpx;
}

.ex-guide-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.ex-guide-text {
  display: block;
  font-size: 26rpx;
  color: #555555;
  line-height: 1.7;
}

.ex-guide-tips {
  padding: 20rpx 22rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
}

.ex-guide-delete {
  margin-top: 20rpx;
  padding: 12rpx 0 4rpx;
  text-align: center;
  font-size: 26rpx;
  color: #FA5151;
}

.ex-guide-footer {
  margin-top: 24rpx;
  flex-shrink: 0;
}

.ex-guide-close-btn {
  height: 88rpx;
  border-radius: 9999rpx;
  background: #F5F6F8;
  color: #333333;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ex-guide-close-btn:active {
  background: #EAECEF;
}

@keyframes exGuideFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes exGuideSlideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
