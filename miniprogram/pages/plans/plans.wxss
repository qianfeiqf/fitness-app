/**
 * 计划管理页面样式 — 与首页统一的极简浅灰底 + 纯白无边框卡片
 */

.page-plans {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

.page-header {
  padding: 12rpx 0 8rpx;
}

.page-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: -0.5rpx;
}

/* 顶部双大字分段 Tab（计划库 / 动作库） */
.main-tabs {
  display: flex;
  align-items: flex-end;
  gap: 44rpx;
}

.main-tab {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 14rpx;
}

.main-tab-text {
  font-size: 36rpx;
  font-weight: 500;
  color: #999999;
  line-height: 1.25;
  transition: all 0.15s ease;
}

.main-tab.active .main-tab-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.main-tab-bar {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  border-radius: 9999rpx;
  background: #07C160;
}

/* =====================
   动作库视图样式
   ===================== */
.ex-toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.ex-search-box {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  background: #FFFFFF;
  border-radius: 9999rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.ex-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 26rpx;
  color: #1A1A1A;
}

.ex-search-clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F0F1F4;
  color: #888888;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ex-muscle-row {
  margin-bottom: 18rpx;
}

.ex-count-row {
  margin-bottom: 16rpx;
}

.ex-lib-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.ex-lib-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 22rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.ex-lib-card:active {
  background: #FAFAFB;
}

.ex-lib-main {
  flex: 1;
  min-width: 0;
}

.ex-lib-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
  flex-wrap: wrap;
}

.ex-lib-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.ex-lib-equip {
  font-size: 20rpx;
  font-weight: 600;
  color: #07C160;
  background: #F0FBF4;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
}

.ex-lib-custom {
  font-size: 20rpx;
  font-weight: 500;
  color: #666666;
  background: #F2F3F5;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
}

.ex-lib-sub {
  display: block;
  font-size: 24rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 动作要领与动图半屏抽屉 */
.ex-detail-body {
  padding-bottom: 16rpx;
}

.ex-detail-gif-wrap {
  width: 100%;
  height: 320rpx;
  background: #F7F8FA;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.ex-detail-gif {
  width: 300rpx;
  height: 300rpx;
}

.ex-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.ex-detail-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #1A1A1A;
  background: #F2F3F5;
  padding: 6rpx 18rpx;
  border-radius: 9999rpx;
}

.ex-detail-tag.tag-equip {
  color: #07C160;
  background: #EAF9F0;
}

.ex-detail-block {
  margin-bottom: 22rpx;
}

.ex-detail-block:last-child {
  margin-bottom: 0;
}

.ex-detail-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.ex-detail-text {
  display: block;
  font-size: 26rpx;
  color: #555555;
  line-height: 1.7;
}

.ex-detail-tips {
  padding: 20rpx 22rpx;
  background: #F7F8FA;
  border-radius: 16rpx;
}

.ex-delete-link {
  margin-top: 24rpx;
  text-align: center;
  padding: 12rpx 0 4rpx;
  font-size: 26rpx;
  color: #FA5151;
}

.custom-picker-box {
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: #1A1A1A;
}

/* =====================
   章节
   ===================== */
.section {
  margin-top: 40rpx;
}

.section.first-section {
  margin-top: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.section-title-group {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.section-count {
  font-size: 22rpx;
  color: #999999;
}

/* 新建按钮（与首页胶囊风格统一） */
.btn-new {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 58rpx;
  padding: 0 22rpx;
  background: #FFFFFF;
  border-radius: 9999rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 600;
}

.btn-new:active {
  background: #F0F1F4;
}

.btn-new-plus {
  font-size: 28rpx;
  font-weight: 700;
  color: #07C160;
  line-height: 1;
}

/* 智能推荐按钮 */
.btn-recommend {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
  padding: 10rpx 22rpx;
  background: #F0FBF4;
  border-radius: 9999rpx;
}

.btn-recommend:active {
  opacity: 0.75;
}

/* 紧凑双排胶囊筛选 */
.filter-pills-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.filter-pill-row {
  width: 100%;
  white-space: nowrap;
}

.filter-pill-list {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 22rpx;
  border-radius: 9999rpx;
  background: #FFFFFF;
  color: #666666;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.filter-pill.active {
  background: #1A1A1A;
  color: #FFFFFF;
  font-weight: 600;
}

/* 推荐计划列表 */
.recommend-list {
  margin-bottom: 32rpx;
}

.recommend-empty {
  text-align: center;
  padding: 48rpx 0;
}

.recommend-empty-text {
  font-size: 28rpx;
  color: #999999;
}

.recommend-card {
  background: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.recommend-card:active {
  background: #EEEEEE;
}

.recommend-card.selected {
  background: #F0F0F0;
  border-color: #1A1A1A;
}

.recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.recommend-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.recommend-tags {
  display: flex;
  gap: 8rpx;
}

.recommend-desc {
  font-size: 26rpx;
  color: #666666;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.recommend-features {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.feature-tag {
  font-size: 20rpx;
  color: #1A1A1A;
  background: #E5E5E5;
  padding: 4rpx 12rpx;
  border-radius: 9999rpx;
}

.recommend-check {
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 600;
  margin-top: 10rpx;
}

/* 标签样式 */
.tag {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  background: #E5E5E5;
  color: #1A1A1A;
}

.tag.beginner { background: rgba(7, 193, 96, 0.1); color: #07C160; }
.tag.intermediate { background: rgba(0, 0, 0, 0.06); color: #1A1A1A; }
.tag.advanced { background: rgba(0, 0, 0, 0.1); color: #1A1A1A; }

/* 空状态卡片 */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  background: #FFFFFF;
  border: 2rpx dashed rgba(0, 0, 0, 0.15);
  border-radius: 24rpx;
}

.empty-card-icon {
  font-size: 48rpx;
  color: #1A1A1A;
  font-weight: 300;
  margin-bottom: 16rpx;
}

.empty-card-text {
  font-size: 30rpx;
  color: #1A1A1A;
  font-weight: 600;
}

/* =====================
   计划列表（纯白无边框微阴影 + 细分割线 + 状态小胶囊）
   ===================== */
.plan-list {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.plan-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #F4F5F7;
  transition: background-color 0.15s ease;
}

.plan-item:active {
  background-color: #FAFAFB;
}

.plan-item:last-child {
  border-bottom: none;
}

.plan-info {
  flex: 1;
  min-width: 0;
}

.plan-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-status-pill {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
}

.plan-status-pill.active {
  background: #F0FBF4;
  color: #07C160;
}

.plan-status-pill.archived {
  background: #F3F4F6;
  color: #888888;
}

.plan-meta {
  font-size: 24rpx;
  color: #888888;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.arrow-icon {
  font-size: 38rpx;
  color: #CCCCCC;
  font-weight: 300;
}

/* =====================
   经典计划模板列表
   ===================== */
.template-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.template-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.template-item:active {
  background-color: #FAFAFB;
}

.template-info {
  flex: 1;
  min-width: 0;
}

.template-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 6rpx;
}

.template-desc {
  font-size: 24rpx;
  color: #777777;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.45;
}

.template-tags {
  display: flex;
  gap: 10rpx;
}

.template-difficulty,
.template-days {
  font-size: 22rpx;
  color: #666666;
  padding: 4rpx 14rpx;
  background-color: #F4F5F7;
  border-radius: 9999rpx;
}

.template-use-btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  border-radius: 9999rpx;
  background: #F0FBF4;
  color: #07C160;
  font-size: 24rpx;
  font-weight: 600;
}

.template-use-btn:active {
  background: #DCF5E6;
}

.tag-green,
.tag-yellow,
.tag-red {
  color: #1A1A1A !important;
  background-color: #F0F0F0 !important;
}

/* =====================
   模板详情弹窗
   ===================== */
.template-detail-modal {
  width: 650rpx;
  max-height: 85vh;
  overflow-y: auto;
  background-color: #FFFFFF !important;
  border: none !important;
}

.detail-header {
  margin-bottom: 28rpx;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}

.detail-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.detail-desc {
  font-size: 28rpx;
  color: #666666;
  display: block;
  margin-bottom: 32rpx;
}

.detail-exercises {
  margin-top: 28rpx;
}

.detail-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  border-bottom: none;
}

/* 训练日区块 */
.day-block {
  margin-bottom: 24rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
  padding: 24rpx;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: none;
}

.day-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.day-count {
  font-size: 24rpx;
  color: #999999;
}

/* 动作行 */
.exercise-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: none;
}

.exercise-row:last-child {
  border-bottom: none;
}

.exercise-name {
  font-size: 28rpx;
  color: #1A1A1A;
  flex: 1;
  font-weight: 500;
}

.exercise-sets {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 600;
  background-color: #F0F0F0;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  margin-left: 16rpx;
}

/* =====================
   输入框
   ===================== */
.input-wrapper {
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

.input::placeholder {
  color: #B0B0B0;
}

/* =====================
   空状态
   ===================== */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #666666;
  display: block;
}

/* WeUI 组件样式覆盖 */
mp-tabs {
  margin-bottom: 16rpx;
}

.filter-hint {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  background-color: #F5F5F5;
  border-radius: 16rpx;
}

/* 详细介绍弹窗 */
.template-intro-modal {
  width: 680rpx;
  max-height: 85vh;
  overflow-y: auto;
  background-color: #FFFFFF !important;
  border: none !important;
}

.intro-header {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: none;
}

.intro-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 16rpx;
}

.intro-tags {
  display: flex;
  gap: 16rpx;
}

.intro-section {
  margin-bottom: 28rpx;
}

.intro-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 12rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #666666;
  display: block;
  line-height: 1.7;
}

/* =====================
   Wizard 进度条
   ===================== */
.wizard-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 48rpx;
  padding-top: 20rpx;
}

.wizard-dots {
  display: flex;
  gap: 12rpx;
}

.wizard-dot {
  width: 48rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E5E5E5;
  transition: all 0.3s ease;
}

.wizard-dot.active {
  background: #1A1A1A;
  width: 64rpx;
}

.wizard-step-text {
  font-size: 24rpx;
  color: #999999;
}

/* =====================
   Wizard 步骤头部
   ===================== */
.wizard-step {
  display: flex;
  flex-direction: column;
}

.wizard-header {
  margin-bottom: 48rpx;
}

.wizard-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 12rpx;
}

.wizard-subtitle {
  font-size: 28rpx;
  color: #666666;
  display: block;
}

/* =====================
   目标选项 (Step 1)
   ===================== */
.wizard-goal-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  max-height: 400rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.wizard-goal-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5E5;
  transition: all 0.2s ease;
  position: relative;
}

.wizard-goal-card.selected {
  border-color: #07C160;
  background-color: #F8F8F8;
}

.wizard-goal-card .wizard-option-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.wizard-goal-card .wizard-option-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.wizard-goal-card .wizard-option-desc {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  line-height: 1.4;
}

.wizard-option-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* =====================
   天数选项 (Step 2)
   ===================== */
.wizard-days-grid {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
  max-height: 400rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.wizard-day-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5E5;
  transition: all 0.2s ease;
}

.wizard-day-card.selected {
  border-color: #07C160;
  background-color: #F8F8F8;
}

.wizard-day-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  line-height: 1;
}

.wizard-day-label {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
}

.wizard-day-desc {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* =====================
   经验选项 (Step 3)
   ===================== */
.wizard-exp-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  max-height: 400rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.wizard-exp-card {
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5E5;
  transition: all 0.2s ease;
}

.wizard-exp-card.selected {
  border-color: #07C160;
  background-color: #F8F8F8;
}

.wizard-exp-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.wizard-exp-card .wizard-option-icon {
  font-size: 48rpx;
}

.wizard-exp-card .wizard-option-info {
  display: flex;
  flex-direction: column;
}

.wizard-exp-card .wizard-option-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.wizard-exp-tag {
  font-size: 22rpx;
  color: #1A1A1A;
  background: #F0F0F0;
  padding: 2rpx 12rpx;
  border-radius: 9999rpx;
  margin-top: 4rpx;
  align-self: flex-start;
}

.wizard-exp-card .wizard-option-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

/* =====================
   推荐结果 (Step 4)
   ===================== */
.wizard-recommend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  max-height: 400rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.wizard-recommend-card {
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5E5;
  transition: all 0.2s ease;
}

.wizard-recommend-card.selected {
  border-color: #07C160;
  background-color: #F8F8F8;
}

.wizard-recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.wizard-recommend-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.wizard-recommend-tags {
  display: flex;
  gap: 8rpx;
}

.wizard-recommend-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: block;
}

.wizard-recommend-features {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.wizard-recommend-check {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 600;
}

/* =====================
   Wizard 空状态
   ===================== */
.wizard-empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.wizard-empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* =====================
   Wizard 底部按钮
   ===================== */
.wizard-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 32rpx;
  padding-top: 16rpx;
}

.wizard-btn {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.wizard-btn-primary {
  background: #07C160;
  color: #FFFFFF;
}

.wizard-btn-ghost {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 0;
  background: none;
  border: none;
  flex: none;
  font-weight: 400;
  white-space: nowrap;
}

.wizard-btn.disabled {
  opacity: 0.4;
}

/* =====================
   暂不使用推荐
   ===================== */
.wizard-skip-row {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.wizard-skip-text {
  font-size: 26rpx;
  color: #999999;
  padding: 12rpx 24rpx;
}

/* =====================
   训练悬浮窗
   ===================== */
.training-float {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 999;
  background: #1A1A1A;
  border-radius: 9999rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  animation: floatSlideUp 0.3s ease-out;
}

@keyframes floatSlideUp {
  from {
    transform: translateY(200rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.training-float-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.training-float-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.training-float-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.training-float-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.training-float-set {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.training-float-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
  flex-shrink: 0;
}

.training-float:active {
  opacity: 0.85;
  transform: scale(0.98);
}
