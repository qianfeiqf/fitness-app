<wxs src="./training.wxs" module="wxs" />

<!-- 训练中页面 - 沉浸式极简风格 -->

<view class="page-training" style="padding-top: {{navHeight}}px;">

  <!-- 顶部进度条 -->
  <view class="progress-header">
    <view class="progress-info">
      <view class="progress-counter">
        <text class="counter-num">{{exercises.length > 0 ? (currentExerciseIndex < exercises.length ? currentExerciseIndex + 1 : exercises.length) : 0}}</text>
        <text class="counter-sep">/</text>
        <text class="counter-total">{{exercises.length}}</text>
      </view>
      <view class="progress-right">
        <text class="training-duration">{{wxs.formatTime(trainingDuration)}}</text>
        <text class="exercise-name">{{currentExercise ? currentExercise.name : (isFreeWorkout ? '自由训练' : '')}}</text>
      </view>
    </view>
    <view class="progress-bar-track">
      <view class="progress-bar-fill" style="width: {{currentExercise && currentExercise.target_sets ? (currentExercise.currentSetNumber / currentExercise.target_sets) * 100 : 0}}%;"></view>
    </view>
  </view>

  <!-- 动作列表 - 横向滚动 -->
  <scroll-view scroll-x class="exercise-scroll" scroll-left="{{scrollLeft}}">
    <view class="exercise-list">
      <view
        wx:for="{{exercises}}"
        wx:key="index"
        class="exercise-chip {{item.completed_sets >= item.target_sets ? 'completed' : ''}} {{index === currentExerciseIndex ? 'current' : ''}}"
        bindtap="onTapExercise"
        data-index="{{index}}"
      >
        <view class="chip-content">
          <text class="chip-name">{{item.exercise_name}}</text>
          <text class="chip-sets">{{item.completed_sets}}/{{item.target_sets}}组</text>
        </view>
        <text wx:if="{{item.completed_sets >= item.target_sets}}" class="chip-check done">✓</text>
        <text wx:elif="{{item.skipped}}" class="chip-check skip">跳过</text>
      </view>
    </view>
    <view class="exercise-chip add-chip" bindtap="onAddExercise">
      <view class="chip-content">
        <text class="chip-name add-icon">+</text>
        <text class="chip-sets">添加</text>
      </view>
    </view>
  </scroll-view>

  <!-- PR徽章展示 -->
  <view wx:if="{{prBadges.length > 0}}" class="pr-badges">
    <view wx:for="{{prBadges}}" wx:key="id" class="pr-badge-item">
      <text class="pr-badge-icon">🏆</text>
      <text class="pr-badge-text">{{item.exerciseName}} 新PR: {{item.value}}kg</text>
    </view>
  </view>

  <!-- 热身区域 — 用 hidden 避免销毁/重建 DOM -->
  <view hidden="{{!showWarmup}}" class="warmup-main">
    <view class="warmup-header">
      <view class="tag tag-warning">热身阶段</view>
      <view class="warmup-title">
        <text class="warmup-exercise-name">{{currentExercise.exercise_name}}</text>
        <text class="warmup-target">目标重量 {{currentExercise.target_weight}}kg</text>
      </view>
    </view>

    <view class="warmup-desc">
      <text class="warmup-desc-text">热身可以降低受伤风险，提升训练表现。请按顺序完成以下热身组：</text>
    </view>

    <view class="warmup-list">
      <view
        wx:for="{{warmupSets}}"
        wx:key="index"
        class="warmup-item {{item.completed ? 'completed' : ''}} {{index === currentWarmupIndex ? 'current' : ''}}"
      >
        <view class="warmup-check">
          <text wx:if="{{item.completed}}" class="warmup-check-icon">✓</text>
          <text wx:else class="warmup-check-num">{{index + 1}}</text>
        </view>
        <view class="warmup-info">
          <text class="warmup-weight">{{item.weight}}kg</text>
          <text class="warmup-sep">×</text>
          <text class="warmup-reps">{{item.reps}}次</text>
        </view>
        <text class="warmup-label">{{item.label}}</text>
      </view>
    </view>

    <view class="warmup-actions">
      <view
        wx:if="{{currentWarmupIndex < warmupSets.length}}"
        class="btn btn-primary btn-block"
        bindtap="onCompleteWarmupSet"
      >
        <text class="btn-complete-icon">✓</text>
        <text>完成第 {{currentWarmupIndex + 1}} 组热身</text>
      </view>
      <view
        wx:else
        class="btn btn-primary btn-block"
        bindtap="onFinishWarmup"
      >
        <text>热身完成，开始正式训练</text>
      </view>
      <view class="btn btn-text" bindtap="onSkipWarmup">跳过热身</view>
    </view>
  </view>

  <!-- 自由训练：尚无动作时的空态引导 -->
  <view wx:if="{{isFreeWorkout && exercises.length === 0}}" class="free-empty-state">
    <text class="free-empty-icon">🏋️</text>
    <text class="free-empty-title">自由训练已开始</text>
    <text class="free-empty-desc">可以先一次性选好几个动作再逐个练，也可以练完一个再加下一个</text>
    <view class="btn btn-primary btn-md free-empty-btn" bindtap="onAddExercise">
      <text>+ 添加训练动作</text>
    </view>
  </view>

  <!-- 自由训练：当前列表全部完成后的流转引导 -->
  <view wx:elif="{{isFreeWorkout && freeAllDone}}" class="free-empty-state">
    <text class="free-empty-icon">✅</text>
    <text class="free-empty-title">已完成 {{completedSets.length}} 组训练</text>
    <text class="free-empty-desc">想继续加练新动作、当前动作再加一组，还是现在结束并保存？</text>
    <view class="free-done-actions">
      <view class="btn btn-primary btn-md btn-block" bindtap="onAddExercise">
        <text>+ 继续添加下一个动作</text>
      </view>
      <view class="btn btn-secondary btn-md btn-block" bindtap="onAddExtraSet">
        <text>+ 上个动作再加一组</text>
      </view>
      <view class="btn btn-finish btn-md btn-block" bindtap="onFinishTraining">
        <text>✓ 完成本次训练并保存</text>
      </view>
    </view>
  </view>

  <!-- 主训练区域 — 用 hidden 避免销毁/重建 DOM；休息时不隐藏，由遮罩层覆盖 -->
  <view hidden="{{showWarmup || !currentExercise}}" class="training-main">
    <!-- 动作标签 + 组数进度 -->
    <view class="exercise-header">
      <view class="tag tag-primary">{{currentExercise.muscle_group}}</view>
      <view class="set-indicator-wrap">
        <view class="set-indicator">
          <text class="set-current">{{currentExercise.currentSetNumber}}</text>
          <text class="set-sep">/</text>
          <text class="set-total">{{currentExercise.target_sets}}</text>
          <text class="set-label">组</text>
        </view>
        <view wx:if="{{isFreeWorkout}}" class="extra-set-btn" bindtap="onAddExtraSet">+ 加组</view>
      </view>
    </view>

    <!-- 目标展示 -->
    <view class="target-display">
      <text class="target-label">目标</text>
      <view class="target-values">
        <text class="target-weight">{{currentExercise.target_weight}}</text>
        <text class="target-unit">kg</text>
        <text class="target-sep">×</text>
        <text class="target-reps">{{currentExercise.target_reps}}</text>
        <text class="target-unit">次</text>
      </view>
      <view wx:if="{{plateHint}}" class="plate-hint-bar" bindtap="onToggleBarWeight">
        <text class="plate-hint-text">🏋️ {{plateHint}}</text>
        <text class="plate-hint-switch">切换杆重</text>
      </view>
    </view>

    <!-- 实际录入 — 刻度拨盘 -->
    <view class="actual-input">
      <view class="input-card">
        <text class="input-card-label">实际重量</text>
        <dial-picker
          items="{{weightOptions}}"
          value="{{currentExercise.actual_weight}}"
          unit="kg"
          step="2.5"
          bind:change="onWeightChange"
        />
      </view>

      <view class="input-card">
        <text class="input-card-label">实际次数</text>
        <dial-picker
          items="{{repOptions}}"
          value="{{currentExercise.actual_reps}}"
          unit="次"
          step="1"
          bind:change="onRepChange"
        />
      </view>
    </view>

    <!-- 更多操作折叠面板 -->
    <view class="more-section">
      <view class="more-toggle" bindtap="onToggleMoreActions">
        <text class="more-toggle-text">{{showMoreActions ? '收起' : '更多选项'}}</text>
        <text class="more-toggle-arrow {{showMoreActions ? 'open' : ''}}">▼</text>
      </view>

      <view wx:if="{{showMoreActions}}" class="more-panel">
        <!-- RPE选择 -->
        <view class="rpe-section">
          <text class="rpe-label">自觉力竭程度</text>
          <view class="rpe-options">
            <view
              wx:for="{{rpeOptions}}"
              wx:key="index"
              class="rpe-option {{selectedRPE === index ? 'active' : ''}}"
              bindtap="onSelectRPE"
              data-value="{{index}}"
            >
              <text class="rpe-value">{{item}}</text>
            </view>
          </view>
        </view>

        <!-- 组备注 -->
        <view class="note-section">
          <text class="note-label">备注</text>
          <input
            class="note-input"
            type="text"
            placeholder="记录体感、疼痛点、动作感受等..."
            value="{{setNote}}"
            bindinput="onSetNoteChange"
          />
        </view>

        <!-- 替换/跳过 -->
        <view class="secondary-actions">
          <view class="btn btn-secondary btn-sm" bindtap="onReplaceExercise">替换动作</view>
          <view class="btn btn-secondary btn-sm" bindtap="onSkipExercise">跳过动作</view>
        </view>
      </view>
    </view>

    <!-- 完成按钮 -->
    <view class="complete-action">
      <view class="btn btn-primary btn-md btn-block" bindtap="onCompleteSet">
        <text class="btn-complete-icon">✓</text>
        <text>完成一组</text>
      </view>
      <view wx:if="{{completedSets.length > 0}}" class="undo-last-btn" bindtap="onUndoLastSet">
        <text>↩ 撤回上一组</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-btn" bindtap="onCollapseTraining">
      <text class="bottom-icon">⬇</text>
      <text class="bottom-label">收起</text>
    </view>
    <view class="bottom-btn" bindtap="{{isPaused ? 'onResumeTraining' : 'onPauseTraining'}}">
      <text class="bottom-icon">{{isPaused ? '▶' : '⏸'}}</text>
      <text class="bottom-label">{{isPaused ? '继续' : '暂停'}}</text>
    </view>
    <view wx:if="{{isFreeWorkout || completedSets.length > 0}}" class="bottom-btn finish" bindtap="onFinishTraining">
      <text class="bottom-icon">✓</text>
      <text class="bottom-label">完成训练</text>
    </view>
    <view class="bottom-btn danger" bindtap="onAbandonTraining">
      <text class="bottom-icon">✕</text>
      <text class="bottom-label">放弃</text>
    </view>
  </view>

  <!-- 跳过动作弹窗 -->
  <modal-sheet
    visible="{{showSkipModal}}"
    title="跳过动作"
    description="为什么跳过这个动作？"
    confirmText="确认跳过"
    cancelText="取消"
    confirmDisabled="{{selectedSkipReason === -1}}"
    bind:confirm="onConfirmSkip"
    bind:cancel="onCancelSkip"
    bind:close="onCancelSkip"
  >
    <view class="skip-reason-list">
      <view
        wx:for="{{skipReasons}}"
        wx:key="index"
        class="skip-reason-item {{selectedSkipReason === index ? 'selected' : ''}}"
        bindtap="onSelectSkipReason"
        data-index="{{index}}"
      >
        <text class="skip-reason-text">{{item}}</text>
        <text wx:if="{{selectedSkipReason === index}}" class="skip-reason-check">✓</text>
      </view>
    </view>
  </modal-sheet>

  <!-- 添加动作弹窗（支持按肌群筛选、多选批量添加与自定义动作） -->
  <modal-sheet
    visible="{{showAddExerciseModal}}"
    title="添加训练动作"
    description="可单选即刻开练，也可多选几个动作依次练"
    confirmText="{{selectedAddIds.length > 0 ? '添加已选 (' + selectedAddIds.length + ')' : '确定添加'}}"
    confirmDisabled="{{selectedAddIds.length === 0 && !canAddCustomExercise}}"
    cancelText="取消"
    bind:confirm="onConfirmAddExercises"
    bind:cancel="onCancelAddExercise"
    bind:close="onCancelAddExercise"
  >
    <view class="add-exercise-search">
      <input
        class="add-search-input"
        type="text"
        placeholder="搜索动作库，或输入自定义动作名..."
        value="{{addExerciseSearch}}"
        bindinput="onAddExerciseSearch"
      />
    </view>
    <scroll-view scroll-x class="add-muscle-scroll">
      <view class="add-muscle-list">
        <view
          wx:for="{{addMuscleGroups}}"
          wx:key="*this"
          class="add-muscle-chip {{selectedAddMuscle === item ? 'active' : ''}}"
          bindtap="onSelectAddMuscle"
          data-muscle="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
    <scroll-view scroll-y class="add-exercise-list">
      <view wx:if="{{canAddCustomExercise}}" class="alternative-item custom-add-row" bindtap="onAddCustomExercise">
        <view class="alt-info">
          <text class="alt-name">+ 添加自定义动作「{{addExerciseSearch}}」</text>
          <text class="alt-muscle">直接加入本次训练</text>
        </view>
        <text class="alt-arrow">+</text>
      </view>
      <view
        wx:for="{{filteredExercises}}"
        wx:key="id"
        class="alternative-item {{selectedAddMap[item.id] ? 'selected' : ''}}"
        bindtap="onToggleAddExercise"
        data-exercise-id="{{item.id}}"
      >
        <view class="alt-info">
          <text class="alt-name">{{item.name}}</text>
          <text class="alt-muscle">{{item.muscle_group}}</text>
        </view>
        <text class="add-check-circle {{selectedAddMap[item.id] ? 'checked' : ''}}">{{selectedAddMap[item.id] ? '✓' : ''}}</text>
      </view>
    </scroll-view>
  </modal-sheet>

  <!-- 动作替换弹窗 -->
  <modal-sheet
    visible="{{showReplaceModal}}"
    title="替换动作"
    description="选择同发力模式的替代动作"
    showConfirm="{{false}}"
    cancelText="取消"
    bind:cancel="onCancelReplace"
    bind:close="onCancelReplace"
  >
    <view class="alternative-list">
      <view
        wx:for="{{alternativeExercises}}"
        wx:key="id"
        class="alternative-item"
        bindtap="onSelectAlternative"
        data-exercise-id="{{item.id}}"
      >
        <view class="alt-info">
          <text class="alt-name">{{item.name}}</text>
          <text class="alt-muscle">{{item.muscle_group}}</text>
        </view>
        <text class="alt-arrow">›</text>
      </view>
    </view>
  </modal-sheet>
</view>

<!-- 组间休息遮罩层（放在 page-training 外部，避免被 overflow:hidden 截断；用 hidden 避免销毁/重建 DOM） -->
<view hidden="{{!isResting || restMinimized}}" class="rest-overlay">
  <view class="rest-overlay-backdrop" bindtap="onMinimizeRest"></view>
  <view class="rest-overlay-content">
    <view class="rest-overlay-header">
      <text class="rest-overlay-label">组间休息</text>
    </view>

    <!-- 大号倒计时 -->
    <view class="rest-countdown">
      <text class="rest-countdown-time">{{wxs.formatTime(restTimeLeft)}}</text>
      <text class="rest-countdown-total">/ {{wxs.formatTime(restTimeTotal)}}</text>
    </view>

    <view class="rest-overlay-progress">
      <view class="rest-overlay-progress-track">
        <view class="rest-overlay-progress-fill" style="width: {{((restTimeTotal - restTimeLeft) / restTimeTotal) * 100}}%;"></view>
      </view>
    </view>

    <view class="rest-overlay-body">
      <text class="rest-overlay-icon">💪</text>
      <text class="rest-overlay-title">休息一下</text>
      <text class="rest-overlay-desc">让肌肉充分恢复，下一组表现更好</text>
    </view>
    <view class="rest-overlay-actions">
      <view class="rest-overlay-btn" bindtap="onReduceRestTime">-30s</view>
      <view class="rest-overlay-btn primary" bindtap="onReadyToGo">我准备好了</view>
      <view class="rest-overlay-btn" bindtap="onAddRestTime">+30s</view>
    </view>
    <view wx:if="{{completedSets.length > 0}}" class="rest-undo-link" bindtap="onUndoLastSet">
      <text>手滑点错了？撤回上一组</text>
    </view>
  </view>
</view>

<!-- 休息悬浮倒计时（点击弹窗外区域后显示） -->
<view hidden="{{!isResting || !restMinimized}}" class="rest-float" bindtap="onExpandRest">
  <view class="rest-float-content">
    <text class="rest-float-icon">⏱</text>
    <text class="rest-float-time">{{wxs.formatTime(restTimeLeft)}}</text>
    <text class="rest-float-label">组间休息</text>
  </view>
</view>
