<!-- 公共按需登录半屏抽屉（深炭黑品牌风格） -->
<view wx:if="{{visible}}" class="login-sheet-overlay" bindtap="onClose" catchtouchmove="noop">
  <view class="login-sheet-card" catchtap="noop">
    <view class="login-sheet-watermark"></view>
    <view class="login-sheet-handle"></view>
    <text class="login-sheet-eyebrow">训练记一记 · 云端同步</text>
    <text class="login-sheet-title">{{title}}</text>
    <text class="login-sheet-desc">{{desc}}</text>

    <view class="login-sheet-actions">
      <view class="login-sheet-btn primary {{submitting ? 'loading' : ''}}" bindtap="onConfirmLogin">
        <text>{{submitting ? '登录中...' : '微信一键登录'}}</text>
      </view>
      <view class="login-sheet-btn secondary" bindtap="onClose">
        <text>暂不登录，继续逛逛</text>
      </view>
    </view>
  </view>
</view>
