/* 训练中心首页样式 — 极简通透浅灰底 + 纯白无边框卡片 */

.page-home {
  min-height: 100vh;
  min-height: 100dvh;
  background: #F7F8FA;
  padding: 32rpx;
  padding-top: 200rpx; /* JS 动态覆盖 */
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
  width: 100%;
  box-sizing: border-box;
}

/* =====================
   顶部轻头部
   ===================== */
.welcome-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 28rpx;
  padding-top: 12rpx;
}

.welcome-content {
  display: flex;
  flex-direction: column;
}

.welcome-greeting {
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 6rpx;
}

.welcome-title {
  font-size: 46rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: -0.5rpx;
  line-height: 1.15;
}

.header-free-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border-radius: 9999rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.header-free-pill:active {
  background: #F0F1F4;
}

.header-free-plus {
  font-size: 28rpx;
  font-weight: 700;
  color: #07C160;
  line-height: 1;
}

.header-free-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.date-widget {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  text-align: center;
  border: 1rpx solid #E5E5E5;
}

.date-day {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.date-week {
  font-size: 20rpx;
  color: #999999;
  display: block;
  margin-top: 2rpx;
}

/* =====================
   登录引导
   ===================== */
.login-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.login-hero {
  margin-bottom: 60rpx;
}

.login-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 36rpx;
}

.login-avatar-icon {
  font-size: 72rpx;
}

.login-headline {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
  display: block;
}

.login-subhead {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  max-width: 500rpx;
  display: block;
}

.btn-login {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 100rpx;
  background: #07C160;
  border-radius: 9999rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: none;
}

.btn-login:active {
  opacity: 0.85;
}

/* =====================
   骨架屏加载
   ===================== */
.loading-section {
  padding: 60rpx 0;
}

.skeleton-wrapper {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.skeleton-block {
  background: linear-gradient(90deg, #F0F0F0 25%, #E0E0E0 50%, #F0F0F0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.8s infinite;
  border-radius: 24rpx;
}

.skeleton-block.tall { height: 320rpx; }
.skeleton-block.medium { height: 200rpx; }
.skeleton-block.short { height: 160rpx; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* =====================
   空状态
   ===================== */
.empty-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 56rpx;
  color: #B0B0B0;
}

.empty-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 48rpx;
  max-width: 450rpx;
  line-height: 1.6;
}

.btn-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  padding: 0 48rpx;
  background: #07C160;
  border-radius: 9999rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  border: none;
}

.btn-cta:active {
  opacity: 0.85;
}

.btn-cta-arrow {
  font-size: 28rpx;
  transition: transform 0.2s ease;
}

/* =====================
   今日训练
   ===================== */
.training-section {
  animation: slideUp 0.4s ease;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* =====================
   本周训练轻量进度卡（保留小圆环，合并连续天数）
   ===================== */
.week-summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 22rpx 28rpx;
  margin: 20rpx 4rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.week-summary-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.progress-ring-bg {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.progress-ring-fill {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  mask: radial-gradient(transparent 58%, black 59%);
  -webkit-mask: radial-gradient(transparent 58%, black 59%);
}

.progress-ring-center {
  display: flex;
  align-items: baseline;
  justify-content: center;
  z-index: 1;
}

.progress-ring-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1;
  font-family: 'DIN Alternate', system-ui, sans-serif;
}

.progress-ring-total {
  font-size: 18rpx;
  color: #999999;
}

.week-summary-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.week-summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.week-summary-sub {
  font-size: 22rpx;
  color: #888888;
}

.streak-pill {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  background: #F0FBF4;
  color: #07C160;
  font-size: 22rpx;
  font-weight: 600;
}

.progress-ring-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.streak-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 16rpx 32rpx;
  border: 1rpx solid #E5E5E5;
  min-width: 140rpx;
}

.streak-flame {
  font-size: 40rpx;
  line-height: 1;
}

.streak-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.2;
  font-family: 'DIN Alternate', system-ui, sans-serif;
}

.streak-label {
  font-size: 20rpx;
  color: #999999;
}

/* =====================
   休息日横幅
   ===================== */
.rest-day-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #E5E5E5;
}

.rest-day-icon {
  font-size: 48rpx;
}

.rest-day-content {
  display: flex;
  flex-direction: column;
}

.rest-day-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.rest-day-desc {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
}

/* =====================
   Deload 提醒横幅
   ===================== */
.deload-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #E5E5E5;
}

.deload-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.deload-content {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.deload-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.deload-desc {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
}

.deload-dismiss {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx;
  flex-shrink: 0;
}

/* =====================
   多计划切换栏（计划名称页签）
   ===================== */
.plan-tabs-section {
  margin-bottom: 20rpx;
}

.plan-tabs-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.plan-tabs-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #333333;
}

.plan-tabs-hint {
  font-size: 22rpx;
  color: #999999;
}

.plan-tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.plan-tabs-list {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 2rpx 4rpx 4rpx;
}

.plan-tab-pill {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 22rpx;
  border-radius: 9999rpx;
  background: #F3F4F6;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.plan-tab-pill.active {
  background: #1A1A1A;
  border-color: #1A1A1A;
}

.plan-tab-status {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.plan-tab-status.train {
  background: #07C160;
}

.plan-tab-status.rest {
  background: #BDBDBD;
}

.plan-tab-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #444444;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.plan-tab-pill.active .plan-tab-name {
  color: #FFFFFF;
  font-weight: 600;
}

.plan-tab-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 9999rpx;
  background: rgba(0, 0, 0, 0.06);
  color: #666666;
}

.plan-tab-pill.active .plan-tab-tag {
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
}

/* =====================
   计划卡片 Swiper
   ===================== */
.plan-swiper {
  width: 100%;
}

.plan-scroll-view {
  width: 100%;
  box-sizing: border-box;
}

.plan-hero-swiper {
  width: 100%;
  height: 220rpx;
}

.plan-swiper-item-inner {
  padding: 4rpx 4rpx 0;
  box-sizing: border-box;
}

.hero-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 34rpx 30rpx;
}

.hero-card-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-ring-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.hero-ring-label {
  font-size: 20rpx;
  color: #999999;
}

/* 多计划极简圆点指示器 */
.plan-dots {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 8rpx;
  margin-bottom: 4rpx;
}

.plan-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 9999rpx;
  background: #D8DCE2;
  transition: all 0.2s ease;
}

.plan-dot.active {
  width: 28rpx;
  background: #1A1A1A;
}

/* =====================
   训练主卡片（纯白无边框，轻盈聚焦日程）
   ===================== */
.training-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.card-body-clean {
  padding: 30rpx 32rpx;
}

.card-header-modern {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-pill {
  background: #F4F5F7;
  color: #555555;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
  flex-shrink: 0;
}

.badge-pill.rest {
  background: #F0FBF4;
  color: #07C160;
}

.card-meta-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 28rpx;
}

.card-meta-line.compact {
  margin-bottom: 0;
}

/* =====================
   底部吸屏主操作按钮
   ===================== */
.home-sticky-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 248, 250, 0) 0%, rgba(247, 248, 250, 0.94) 28%, #F7F8FA 100%);
  z-index: 90;
  box-sizing: border-box;
}

.sticky-cta-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 9999rpx;
  background: #07C160;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.24);
}

.sticky-cta-btn:active {
  opacity: 0.88;
}

.sticky-cta-btn.unlock {
  background: #1A1A1A;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 26, 0.2);
}

.meta-chip {
  font-size: 26rpx;
  color: #666666;
  font-variant-numeric: tabular-nums;
}

.meta-dot {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* =====================
   主按钮
   ===================== */
.card-action {
  padding: 0;
}

.btn-start,
.btn-resume {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 92rpx;
  border-radius: 9999rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

/* 开始训练 — WeUI 绿 */
.btn-start {
  background: #07C160;
  color: #FFFFFF;
}

.btn-start:active {
  opacity: 0.85;
}

/* 继续训练 — 统一使用绿色训练执行语义 */
.btn-resume {
  background: #07C160;
  color: #FFFFFF;
}

.btn-resume:active {
  opacity: 0.85;
}

.btn-start-icon {
  font-size: 28rpx;
}

/* =====================
   动作预览
   ===================== */
.exercises-section {
  margin-top: 28rpx;
  padding: 0 4rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.section-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #666666;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
}

.section-link:active {
  opacity: 0.7;
}

.link-arrow {
  font-size: 28rpx;
  font-weight: 300;
}

.exercise-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.exercise-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #F4F5F7;
  transition: background-color 0.15s ease;
}

.exercise-item:last-child {
  border-bottom: none;
}

.exercise-item:active {
  background: rgba(0, 0, 0, 0.02);
}

/* 动作编号圆 — 纯黑底白字 */
.exercise-number {
  width: 56rpx;
  height: 56rpx;
  background: #1A1A1A;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.exercise-content {
  flex: 1;
  min-width: 0;
}

.exercise-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
  margin-bottom: 6rpx;
}

.exercise-details {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.exercise-sets,
.exercise-weight {
  font-size: 24rpx;
  color: #666666;
}

.exercise-sep {
  color: #CCCCCC;
  font-size: 20rpx;
}

.exercise-tag {
  font-size: 20rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 8rpx 16rpx;
  border-radius: 9999rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.exercise-arrow {
  margin-left: 10rpx;
  font-size: 32rpx;
  color: #CCCCCC;
  font-weight: 300;
  flex-shrink: 0;
}

/* 弹窗内图标容器（纯居中，不额外套方框） */
.modal-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

/* =====================
   训练悬浮窗
   ===================== */
.training-float {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 999;
  background: #1A1A1A;
  border-radius: 9999rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  animation: floatSlideUp 0.3s ease-out;
}

@keyframes floatSlideUp {
  from {
    transform: translateY(200rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.training-float-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.training-float-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.training-float-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.training-float-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.training-float-set {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.training-float-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
  flex-shrink: 0;
}

.training-float:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* =====================
   自由训练快捷入口
   ===================== */
.free-workout-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  background: #F7F7F7;
  border: 1rpx solid #EAEAEA;
  border-radius: 20rpx;
}

.free-workout-bar:active {
  background: #EFEFEF;
}

.free-workout-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.free-workout-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.free-workout-info {
  flex: 1;
  min-width: 0;
}

.free-workout-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.free-workout-desc {
  display: block;
  font-size: 22rpx;
  color: #888888;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.free-workout-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #1A1A1A;
  padding: 10rpx 24rpx;
  border-radius: 9999rpx;
}

.free-workout-empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 18rpx 40rpx;
  border-radius: 9999rpx;
  border: 1rpx solid #DCDCDC;
  background: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.free-workout-plus {
  font-size: 30rpx;
  font-weight: 600;
}

.free-workout-bar.active {
  background: #1A1A1A;
  border-color: #1A1A1A;
}

.free-workout-bar.active .free-workout-title {
  color: #FFFFFF;
}

.free-workout-bar.active .free-workout-desc {
  color: rgba(255, 255, 255, 0.72);
}

.free-workout-bar.active .free-workout-btn {
  background: #07C160;
  color: #FFFFFF;
}

.free-workout-empty-btn.active {
  background: #1A1A1A;
  border-color: #1A1A1A;
  color: #FFFFFF;
}

/* 顶部非阻塞轻提示条（身体档案 / 同步重试） */
.home-tip-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: #F4FBF7;
  border: 1rpx solid #CBEFD9;
}

.home-tip-banner.warn {
  background: #FFFBF2;
  border-color: #FDE6B8;
}

.home-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: #333333;
  line-height: 1.4;
}

.home-tip-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #07C160;
  padding: 12rpx 16rpx;
  flex-shrink: 0;
}

.home-tip-banner.warn .home-tip-action {
  color: #D97706;
}

.home-tip-close {
  padding: 16rpx;
  margin: -12rpx -8rpx -12rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
