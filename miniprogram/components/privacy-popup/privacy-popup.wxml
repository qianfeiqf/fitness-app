<view wx:if="{{visible}}" class="privacy-mask">
  <view class="privacy-dialog">
    <text class="privacy-title">用户隐私保护提示</text>
    <view class="privacy-desc">
      <text>在你使用健身训练计划小程序前，请仔细阅读</text>
      <text class="privacy-link" bindtap="onOpenContract">{{privacyContractName}}</text>
      <text>。我们仅在你主动使用对应功能时收集必要信息（如保存战报图至相册、剪贴板导出数据）。</text>
    </view>
    <view class="privacy-actions">
      <button class="privacy-btn reject" bindtap="onDisagree">暂不同意</button>
      <button
        id="agree-privacy-btn"
        class="privacy-btn agree"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgree"
      >同意并继续</button>
    </view>
  </view>
</view>
