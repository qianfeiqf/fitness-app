/* 训练中页面 — WeUI 扁平风格 */

.page-training {
  height: 100vh;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  padding-top: 100rpx; /* JS 动态覆盖 */
  padding-bottom: calc(104rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

.training-custom-nav {
  position: fixed;
  left: 24rpx;
  z-index: 60;
  display: flex;
  align-items: center;
}

.training-back-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  height: 100%;
  padding: 0 20rpx 0 12rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #EAEAEA;
}

.training-back-btn:active {
  background: #F2F2F2;
}

.training-back-arrow {
  font-size: 38rpx;
  line-height: 1;
  color: #1A1A1A;
  margin-top: -2rpx;
}

.training-back-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A1A;
}

/* =====================
   进度条（原生替代 t-progress）
   ===================== */
.progress-bar-track {
  width: 100%;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: #1A1A1A;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* =====================
   标签组件
   ===================== */
.tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-primary {
  background: #F0F0F0;
  color: #1A1A1A;
}

.tag-warning {
  background: #F0F0F0;
  color: #666666;
}

/* =====================
   顶部进度条
   ===================== */
.progress-header {
  padding: 24rpx 40rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-counter {
  display: flex;
  align-items: baseline;
}

.counter-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.counter-sep {
  font-size: 28rpx;
  color: #999999;
  margin: 0 4rpx;
}

.counter-total {
  font-size: 28rpx;
  color: #666666;
  font-variant-numeric: tabular-nums;
}

.progress-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.training-duration {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #1A1A1A;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.exercise-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* =====================
   动作列表 - 横向滚动
   ===================== */
.exercise-scroll {
  background: #FFFFFF;
  padding: 16rpx 40rpx;
  white-space: nowrap;
}

.exercise-list {
  display: inline-flex;
  gap: 12rpx;
}

.exercise-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E5E5;
  flex-shrink: 0;
}

.exercise-chip.current {
  background-color: #07C160;
  color: #FFFFFF;
  border-color: #07C160;
}

.exercise-chip.completed {
  opacity: 0.5;
}

.chip-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rpx;
}

.chip-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-sets {
  font-size: 22rpx;
  color: #999999;
}

.chip-check {
  font-size: 24rpx;
  font-weight: 600;
}

.chip-check.done {
  color: #1A1A1A;
}

.chip-check.skip {
  font-size: 22rpx;
  color: #666666;
  background: #F0F0F0;
  padding: 2rpx 8rpx;
  border-radius: 9999rpx;
}

.exercise-chip.current .chip-name {
  color: #FFFFFF;
  font-weight: 700;
}

.exercise-chip:active {
  opacity: 0.8;
}

.exercise-chip.add-chip {
  border: 2rpx dashed rgba(0, 0, 0, 0.2);
  background: #F5F5F5;
  box-shadow: none;
  padding: 12rpx 24rpx;
  margin-left: 8rpx;
}

.exercise-chip.add-chip .add-icon {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

/* =====================
   PR徽章 — 黑白
   ===================== */
.pr-badges {
  background: #F5F5F5;
  padding: 16rpx 40rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pr-badge-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #1A1A1A;
  padding: 10rpx 20rpx;
  border-radius: 9999rpx;
}

.pr-badge-icon {
  font-size: 24rpx;
}

.pr-badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* =====================
   组间休息全屏遮罩
   ===================== */
.rest-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rest-overlay-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.rest-overlay-content {
  position: relative;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 600rpx;
  max-width: 90%;
  animation: popIn 0.25s ease-out;
}

@keyframes popIn {
  from {
    transform: scale(0.9);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.rest-overlay-header {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 32rpx;
}

.rest-overlay-label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

/* =====================
   休息倒计时大数字
   ===================== */
.rest-countdown {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.rest-countdown-time {
  font-size: 120rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.rest-countdown-total {
  font-size: 36rpx;
  font-weight: 500;
  color: #999999;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.rest-overlay-progress {
  margin-bottom: 32rpx;
}

.rest-overlay-progress-track {
  width: 100%;
  height: 8rpx;
  background: #E5E5E5;
  border-radius: 4rpx;
  overflow: hidden;
}

.rest-overlay-progress-fill {
  height: 100%;
  background: #07C160;
  border-radius: 4rpx;
  transition: width 1s linear;
}

.rest-overlay-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  text-align: center;
}

.rest-overlay-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  display: block;
}

.rest-overlay-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  display: block;
}

.rest-overlay-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
  display: block;
}

.rest-overlay-actions {
  display: flex;
  gap: 20rpx;
}

.rest-overlay-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #F5F5F5;
  color: #666666;
}

.rest-overlay-btn:active {
  background: #E5E5E5;
}

.rest-overlay-btn.primary {
  background: #07C160;
  color: #FFFFFF;
}

.rest-overlay-btn.primary:active {
  opacity: 0.85;
}

/* =====================
   休息悬浮倒计时
   ===================== */
.rest-float {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  z-index: 150;
  background: #1A1A1A;
  border-radius: 9999rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.rest-float-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.rest-float-icon {
  font-size: 36rpx;
}

.rest-float-time {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.rest-float-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.rest-float:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* =====================
   热身区域
   ===================== */
.warmup-main {
  flex: 1;
  min-height: 0;
  padding: 28rpx 40rpx 16rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.warmup-header {
  flex-shrink: 0;
  margin-bottom: 20rpx;
}

.warmup-badge-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.warmup-stage-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 9999rpx;
  background: #FFF7ED;
  border: 1rpx solid #FDBA74;
  color: #D97706;
  font-size: 24rpx;
  font-weight: 700;
}

.warmup-stage-note {
  font-size: 24rpx;
  color: #999999;
}

.warmup-scroll {
  flex: 1;
  min-height: 0;
}

.warmup-title {
  margin-top: 16rpx;
}

.warmup-exercise-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
}

.warmup-target {
  font-size: 26rpx;
  color: #666666;
  display: block;
  margin-top: 4rpx;
}

.warmup-desc {
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
}

.warmup-desc-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.warmup-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

.warmup-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E5E5;
}

.warmup-item.current {
  background-color: #F7F7F7;
  border-color: #D0D0D0;
}

.warmup-item.completed {
  opacity: 0.72;
}

.warmup-check {
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 50%;
  background: #F0F0F0;
  border: 1rpx solid #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.warmup-item.current .warmup-check {
  background: #333333;
  border-color: #333333;
}

.warmup-item.current .warmup-check-num {
  color: #FFFFFF;
}

.warmup-item.completed .warmup-check {
  background: #07C160;
  border-color: #07C160;
}

.warmup-check-icon {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.warmup-check-num {
  font-size: 26rpx;
  color: #666666;
  font-weight: 700;
}

.warmup-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.warmup-input {
  width: 112rpx;
  height: 60rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: #F5F5F5;
  border: 1rpx solid #E5E5E5;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  box-sizing: border-box;
}

.warmup-input-sm {
  width: 88rpx;
}

.warmup-unit {
  font-size: 24rpx;
  color: #666666;
}

.warmup-delete-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #F5F5F5;
  color: #999999;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.warmup-delete-btn:active {
  background: #EAEAEA;
  color: #333333;
}

.warmup-add-btn {
  height: 76rpx;
  margin-bottom: 28rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #D8D8D8;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #555555;
}

.warmup-add-btn:active {
  background: #F0F0F0;
}

.warmup-weight {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.warmup-sep {
  font-size: 24rpx;
  color: #999999;
}

.warmup-reps {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.warmup-label {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}

.warmup-actions {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 12rpx 0 4rpx;
  border-top: 1rpx solid #F2F2F2;
  background: #FFFFFF;
}

.warmup-actions .btn-primary,
.warmup-actions .btn-warmup-primary {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.btn-warmup-primary {
  background: #1A1A1A;
  color: #FFFFFF;
  border-radius: 9999rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.btn-warmup-primary:active {
  opacity: 0.88;
}

.warmup-actions .btn-text {
  height: auto;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
}

/* =====================
   主训练区域
   ===================== */
.training-main {
  flex: 1;
  padding: 24rpx 40rpx 12rpx;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.training-scroll {
  flex: 1;
  min-height: 0;
}

.exercise-header {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.exercise-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 热身组 / 正式组 极简分段 Tab */
.stage-tabs {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 6rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #F3F4F6;
}

.stage-tab {
  flex: 1;
  height: 68rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #666666;
  transition: all 0.15s ease;
}

.stage-tab.active {
  background: #FFFFFF;
  color: #1A1A1A;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.stage-tab-text {
  font-size: 26rpx;
  font-weight: 500;
}

.stage-tab.active .stage-tab-text {
  font-weight: 700;
}

.stage-tab-count {
  font-size: 22rpx;
  color: #999999;
  font-family: 'DIN Alternate', system-ui, sans-serif;
}

.stage-tab.active .stage-tab-count {
  color: #555555;
  font-weight: 600;
}

.set-indicator-warmup {
  background: #333333;
}

.set-indicator {
  display: flex;
  align-items: baseline;
  background: #1A1A1A;
  padding: 8rpx 24rpx;
  border-radius: 9999rpx;
}

.set-current {
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.set-sep {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  margin: 0 2rpx;
}

.set-total {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.7);
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.set-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 6rpx;
}

/* =====================
   目标展示 — DIN 大数字
   ===================== */
.target-display {
  text-align: center;
  padding: 24rpx 0;
}

.target-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  font-weight: 500;
}

.target-values {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
}

.target-weight,
.target-reps {
  font-size: 72rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.target-unit {
  font-size: 28rpx;
  color: #666666;
  margin-left: 4rpx;
}

.target-sep {
  font-size: 40rpx;
  color: #999999;
  margin: 0 12rpx;
}

/* =====================
   正式组平铺列表（与热身组一致的交互，绿/黑视觉体系区分）
   ===================== */
.formal-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

.formal-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E5E5;
}

.formal-item.current {
  background-color: #F4FBF7;
  border-color: #A7E3BE;
}

.formal-item.completed {
  opacity: 0.72;
}

.formal-check {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0F0F0;
  border: 1rpx solid #E0E0E0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.formal-item.current .formal-check {
  background: #1A1A1A;
  border-color: #1A1A1A;
}

.formal-item.current .formal-check-num {
  color: #FFFFFF;
}

.formal-item.completed .formal-check {
  background: #07C160;
  border-color: #07C160;
}

.formal-check-icon {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.formal-check-num {
  font-size: 26rpx;
  color: #666666;
  font-weight: 700;
}

.formal-add-btn {
  height: 76rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #D8D8D8;
  background: #FAFAFA;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #555555;
}

.formal-add-btn:active {
  background: #F0F0F0;
}

.input-card {
  flex: 1;
  max-width: 280rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx;
  /* 内凹槽质感 */
  border: 1rpx solid #E5E5E5;
  background-color: #F6F6F6;
}

.input-card-label {
  font-size: 22rpx;
  color: #999999;
  display: block;
  text-align: center;
  margin-bottom: 8rpx;
}

.input-stepper {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 16rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  transition: all 0.15s ease;
}

.stepper-btn:active {
  background: rgba(0, 0, 0, 0.06);
}

.stepper-btn-text {
  font-size: 36rpx;
  font-weight: 300;
  color: #1A1A1A;
}

.stepper-input {
  flex: 1;
  height: 72rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 16rpx;
}

/* =====================
   更多操作折叠面板
   ===================== */
.more-section {
  margin-bottom: 24rpx;
}

.more-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 0;
  cursor: pointer;
}

.more-toggle-text {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.more-toggle-arrow {
  font-size: 20rpx;
  color: #999999;
  transition: transform 0.2s ease;
}

.more-toggle-arrow.open {
  transform: rotate(180deg);
}

.more-panel {
  animation: slideUp 0.2s ease-out;
}

/* =====================
   RPE选择
   ===================== */
.rpe-section {
  margin-bottom: 24rpx;
}

.rpe-label {
  font-size: 22rpx;
  color: #999999;
  display: block;
  text-align: center;
  margin-bottom: 16rpx;
}

.rpe-options {
  display: flex;
  gap: 12rpx;
  justify-content: center;
}

.rpe-option {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
}

.rpe-option.active {
  background-color: #07C160;
  border-color: #07C160;
}

.rpe-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #666666;
}

.rpe-option.active .rpe-value {
  color: #FFFFFF;
  font-weight: 700;
}

/* =====================
   组备注
   ===================== */
.note-section {
  margin-bottom: 24rpx;
}

.note-label {
  font-size: 22rpx;
  color: #999999;
  display: block;
  text-align: center;
  margin-bottom: 12rpx;
}

.note-input {
  width: 100%;
  height: 80rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

.note-input::placeholder {
  color: #B0B0B0;
  font-size: 26rpx;
}

/* =====================
   次要操作按钮
   ===================== */
.secondary-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

/* =====================
   完成按钮
   ===================== */
.complete-action {
  flex-shrink: 0;
  margin-top: 12rpx;
  padding: 12rpx 0 4rpx;
  border-top: 1rpx solid #F2F2F2;
  background: #FFFFFF;
}

/* 训练页按钮覆盖 — 药丸圆角 + 大尺寸 */
.page-training .btn {
  border-radius: 9999rpx;
  box-sizing: border-box;
}

.page-training .btn-primary {
  background: #07C160 !important;
  color: #FFFFFF !important;
}

.page-training .btn-lg {
  height: 120rpx;
  font-size: 36rpx;
  padding: 0 48rpx;
}

.page-training .btn-md {
  height: 96rpx;
  font-size: 32rpx;
  padding: 0 48rpx;
}

.btn-complete-icon {
  margin-right: 12rpx;
  font-size: 36rpx;
}

/* =====================
   底部操作栏
   ===================== */
.bottom-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 12rpx 32rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
}

.bottom-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background: transparent;
  transition: background 0.15s ease;
}

.bottom-btn:active {
  background: #F5F5F5;
}

.bottom-collapse-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transform: rotate(90deg);
}

.bottom-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #666666;
}

.bottom-btn.danger .bottom-icon {
  color: #FA5151;
}

.bottom-btn.danger .bottom-label {
  color: #FA5151;
}

/* =====================
   弹窗公共样式
   ===================== */
.skip-reason-list {
  margin-bottom: 32rpx;
}

.skip-reason-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: none;
  transition: box-shadow 0.15s ease;
}

.skip-reason-item.selected {
  background-color: #F8F8F8;
}

.skip-reason-item:active {
  background: #E5E5E5;
}

.skip-reason-text {
  font-size: 30rpx;
  color: #1A1A1A;
}

.skip-reason-check {
  font-size: 28rpx;
  color: #1A1A1A;
  font-weight: 600;
}

/* =====================
   添加动作弹窗
   ===================== */
.add-exercise-search {
  margin-bottom: 20rpx;
}

.add-search-input {
  width: 100%;
  height: 80rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5E5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

.add-search-input::placeholder {
  color: #B0B0B0;
}

.add-exercise-list {
  max-height: 400rpx;
  margin-bottom: 24rpx;
}

/* =====================
   动作替换/添加列表
   ===================== */
.alternative-list {
  margin-bottom: 32rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.alternative-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  transition: all 0.15s ease;
}

.alternative-item:active {
  background: #E5E5E5;
}

.alternative-item:last-child {
  margin-bottom: 0;
}

.alt-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.alt-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.alt-muscle {
  font-size: 22rpx;
  color: #999999;
}

.alt-arrow {
  font-size: 36rpx;
  color: #999999;
  font-weight: 300;
}

/* =====================
   动画
   ===================== */
@keyframes slideUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* =====================
   杠铃配重片提示与撤回上一组
   ===================== */
.plate-hint-bar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  background: #F5F5F5;
  border-radius: 9999rpx;
}

.plate-hint-text {
  font-size: 22rpx;
  color: #333333;
  font-weight: 500;
}

.plate-hint-switch {
  font-size: 20rpx;
  color: #888888;
  text-decoration: underline;
}

.undo-last-btn {
  margin-top: 16rpx;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #888888;
}

.undo-last-btn:active {
  color: #1A1A1A;
}

.rest-undo-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  text-decoration: underline;
}

/* =====================
   自由训练模式与多选动作抽屉
   ===================== */
.free-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 120rpx 48rpx 80rpx;
}

.free-empty-icon {
  font-size: 84rpx;
  margin-bottom: 24rpx;
}

.free-empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.free-empty-desc {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.6;
  margin-bottom: 44rpx;
  max-width: 540rpx;
}

.free-empty-btn {
  padding: 0 56rpx;
}

.free-done-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-finish {
  background: #07C160;
  color: #FFFFFF;
}

.set-indicator-wrap {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.extra-set-btn {
  font-size: 22rpx;
  font-weight: 600;
  color: #1A1A1A;
  background: #F2F2F2;
  padding: 8rpx 18rpx;
  border-radius: 9999rpx;
}

.extra-set-btn:active {
  background: #E5E5E5;
}

.bottom-btn.finish .bottom-icon,
.bottom-btn.finish .bottom-label {
  color: #07C160;
  font-weight: 600;
}

.add-muscle-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.add-muscle-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.add-muscle-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  border-radius: 9999rpx;
  background: #F3F3F3;
  font-size: 24rpx;
  color: #555555;
}

.add-muscle-chip.active {
  background: #1A1A1A;
  color: #FFFFFF;
  font-weight: 600;
}

.alternative-item.selected {
  background: #F4F6F5;
  border-color: #1A1A1A;
}

.alternative-item.custom-add-row {
  border: 1rpx dashed #1A1A1A;
  background: #FAFAFA;
}

.add-check-circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #CCCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
}

.add-check-circle.checked {
  background: #1A1A1A;
  border-color: #1A1A1A;
}

.extra-set-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.add-exercise-card {
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid transparent;
}

.add-exercise-card.selected {
  border-color: #1A1A1A;
  background: #F7F8F7;
}

.add-card-head {
  margin-bottom: 0 !important;
  border: none !important;
}

.add-config-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 14rpx 20rpx 18rpx;
  border-top: 1rpx solid #EAEAEA;
  background: #FAFAFA;
}

.add-cfg-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.add-cfg-label {
  font-size: 20rpx;
  color: #888888;
}

.add-cfg-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 56rpx;
  background: #FFFFFF;
  border: 1rpx solid #E0E0E0;
  border-radius: 10rpx;
  padding: 0 6rpx;
}

.cfg-step-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  background: #F2F2F2;
  border-radius: 8rpx;
}

.cfg-step-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.add-cfg-input {
  height: 56rpx;
  background: #FFFFFF;
  border: 1rpx solid #E0E0E0;
  border-radius: 10rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  box-sizing: border-box;
}
