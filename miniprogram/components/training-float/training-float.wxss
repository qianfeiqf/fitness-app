.training-float {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 999;
  background: #1A1A1A;
  border-radius: 9999rpx;
  padding: 20rpx 32rpx;
  border: 1rpx solid transparent;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  animation: floatSlideUp 0.25s ease-out;
}

.training-float.resting {
  border-color: rgba(7, 193, 96, 0.45);
}

.training-float.rest-done {
  border-color: #07C160;
}

@keyframes floatSlideUp {
  from {
    transform: translateY(120rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.training-float-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.training-float-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.training-float-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.training-float-name.highlight {
  color: #07C160;
}

.training-float-set {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.training-float-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
  flex-shrink: 0;
}

.training-float:active {
  opacity: 0.85;
  transform: scale(0.98);
}
