/* 统计页面样式 — WeUI 扁平风格 */

.page-stats {
  min-height: 100vh;
  background: #FFFFFF;
  padding: 40rpx;
  padding-top: 200rpx; /* JS 动态覆盖 */
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  color: #1A1A1A;
  width: 100%;
  box-sizing: border-box;
}

/* =====================
   页面头部
   ===================== */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.page-header-left {
  display: flex;
  flex-direction: column;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.page-subtitle {
  font-size: 26rpx;
  color: #666666;
  margin-top: 6rpx;
  display: block;
}

.history-entry {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #FFFFFF;
  padding: 12rpx 20rpx;
  border-radius: 9999rpx;
  border: 1rpx solid #E5E5E5;
}

.history-entry-text {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.history-entry-arrow {
  font-size: 28rpx;
  color: #999999;
}

/* WeUI 组件样式覆盖 */
mp-tabs {
  margin-bottom: 8rpx;
}

/* =====================
   1RM 趋势图
   ===================== */

.chart-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #E5E5E5;
}

.rm-chart {
  width: 100%;
  height: 400rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: none;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 24rpx;
  color: #666666;
}

/* =====================
   肌群雷达图
   ===================== */
.section-subtitle {
  font-size: 22rpx;
  color: #999999;
  margin-left: 12rpx;
}

.radar-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.radar-chart {
  width: 100%;
  height: 480rpx;
}

.muscle-advice {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  margin-top: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.advice-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.advice-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

/* =====================
   章节
   ===================== */
.section {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

/* 周期筛选 */
.total-volume {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.total-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.total-unit {
  font-size: 22rpx;
  color: #999999;
}

/* =====================
   三大项
   ===================== */
.big-three-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.big-three-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  border: 1rpx solid #E5E5E5;
}

.big-three-card:active {
  background-color: #F8F8F8;
}

.card-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #1A1A1A;
}

.card-content {
  position: relative;
  z-index: 1;
}

.big-three-card .exercise-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rm-display {
  margin-bottom: 10rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
}

.rm-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.rm-unit {
  font-size: 20rpx;
  color: #999999;
}

.rm-trend {
  margin-bottom: 10rpx;
}

.trend-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 12rpx;
  border-radius: 9999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.trend-badge.up {
  background: #F0F0F0;
  color: #1A1A1A;
}

.trend-badge.down {
  background: #F0F0F0;
  color: #999999;
}

.trend-badge.flat {
  background: #F0F0F0;
  color: #666666;
}

.trend-arrow {
  font-size: 18rpx;
}

.trend-value {
  font-variant-numeric: tabular-nums;
}

.best-rm {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.best-label {
  font-size: 18rpx;
  color: #999999;
}

.best-value {
  font-size: 22rpx;
  font-weight: 600;
  color: #666666;
  font-variant-numeric: tabular-nums;
}

/* =====================
   容量图
   ===================== */
.volume-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  border: 1rpx solid #E5E5E5;
}

.volume-chart {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 180rpx;
}

.volume-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.volume-bar-container {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  min-height: 4rpx;
}

.volume-bar-track {
  width: 28rpx;
  height: 100%;
  background: #F0F0F0;
  border-radius: 6rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}

.volume-bar {
  width: 100%;
  background: rgba(26, 26, 26, 0.2);
  border-radius: 6rpx;
  min-height: 4rpx;
  transition: all 0.4s ease;
}

.volume-bar.active {
  background: #1A1A1A;
}

.volume-day {
  font-size: 20rpx;
  color: #999999;
  margin-top: 12rpx;
  font-weight: 500;
}

/* =====================
   空状态
   ===================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5E5;
}

.empty-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.empty-icon {
  font-size: 48rpx;
  color: #B0B0B0;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #666666;
  display: block;
}

/* =====================
   PR列表
   ===================== */
.pr-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #E5E5E5;
}

.pr-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: none;
  transition: background-color 0.15s ease;
}

.pr-item:last-child {
  border-bottom: none;
}

.pr-item:active {
  background: rgba(0, 0, 0, 0.02);
}

.pr-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  background: #F0F0F0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.pr-icon {
  font-size: 32rpx;
}

.pr-info {
  flex: 1;
  min-width: 0;
}

.pr-exercise {
  font-size: 28rpx;
  font-weight: 500;
  color: #1A1A1A;
  display: block;
  margin-bottom: 4rpx;
}

.pr-date {
  font-size: 22rpx;
  color: #999999;
  display: block;
}

.pr-value {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.pr-value .value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
}

.pr-value .type {
  font-size: 20rpx;
  color: #999999;
  display: block;
  margin-top: 2rpx;
}

/* =====================
   训练悬浮窗
   ===================== */
.training-float {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 999;
  background: #1A1A1A;
  border-radius: 9999rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
  animation: floatSlideUp 0.3s ease-out;
}

@keyframes floatSlideUp {
  from {
    transform: translateY(200rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.training-float-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.training-float-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.training-float-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.training-float-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.training-float-set {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

.training-float-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 300;
  flex-shrink: 0;
}

.training-float:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* =====================
   月度训练日历
   ===================== */
.calendar-summary {
  font-size: 24rpx;
  font-weight: 600;
  color: #07C160;
  background: #E8F8EE;
  padding: 6rpx 18rpx;
  border-radius: 9999rpx;
}

.calendar-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid #EFEFEF;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.calendar-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.calendar-nav-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #1A1A1A;
}

.calendar-nav-btn:active {
  background: #E5E5E5;
}

.calendar-nav-center {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.calendar-month-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.calendar-today-btn {
  font-size: 22rpx;
  color: #07C160;
  background: #E8F8EE;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
  font-weight: 500;
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 10rpx;
}

.calendar-weekday {
  text-align: center;
  font-size: 22rpx;
  color: #999999;
  padding: 6rpx 0;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx 4rpx;
}

.calendar-cell {
  min-height: 92rpx;
  border-radius: 14rpx;
  padding: 8rpx 4rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.calendar-cell.empty {
  pointer-events: none;
}

.calendar-cell.today {
  border-color: #D8D8D8;
  background: #FAFAFA;
}

.calendar-cell.trained {
  background: #F0FBF4;
}

.calendar-cell.selected {
  border-color: #1A1A1A;
  background: #F5F5F5;
}

.calendar-cell.trained.selected {
  border-color: #07C160;
  background: #E4F7EC;
}

.calendar-day-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.calendar-day-num {
  font-size: 26rpx;
  font-weight: 500;
  color: #333333;
  line-height: 1.3;
}

.calendar-cell.trained .calendar-day-num {
  font-weight: 700;
  color: #07C160;
}

.calendar-cell.today .calendar-day-num {
  font-weight: 700;
  color: #1A1A1A;
}

.calendar-multi-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #07C160;
}

.calendar-plan-tag {
  margin-top: 4rpx;
  width: 100%;
  padding: 2rpx 4rpx;
  border-radius: 6rpx;
  background: #07C160;
  box-sizing: border-box;
  text-align: center;
  overflow: hidden;
}

.calendar-plan-text {
  display: block;
  font-size: 20rpx;
  line-height: 1.25;
  color: #FFFFFF;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-action-btn {
  margin-top: 24rpx;
  padding: 16rpx 40rpx;
  border-radius: 9999rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.empty-action-btn:active {
  opacity: 0.85;
}

.calendar-detail {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.calendar-detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 0 6rpx;
}

.calendar-detail-date {
  font-size: 26rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.calendar-detail-count {
  font-size: 22rpx;
  color: #999999;
}

.calendar-detail-empty {
  padding: 20rpx 6rpx 6rpx;
  font-size: 24rpx;
  color: #999999;
  text-align: center;
}

.calendar-session-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.calendar-session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #F8F8F8;
}

.calendar-session-item:active {
  background: #EFEFEF;
}

.calendar-session-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.calendar-session-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.calendar-session-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-session-time {
  font-size: 22rpx;
  color: #999999;
  flex-shrink: 0;
}

.calendar-session-meta {
  font-size: 24rpx;
  color: #666666;
}

.calendar-session-arrow {
  font-size: 32rpx;
  color: #BBBBBB;
  margin-left: 12rpx;
}
