<view class="onboarding-container" style="padding-top: {{navHeight}}px;">
  
  <!-- 顶部进度条 -->
  <view class="onboarding-header">
    <view class="progress-bar">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{(currentStep / 4) * 100}}%"></view>
      </view>
      <text class="progress-text">{{currentStep}} / 4</text>
    </view>
    
    <view class="step-header">
      <block wx:if="{{currentStep === 1}}">
        <text class="step-title">你的健身目标是什么？</text>
        <text class="step-subtitle">我们会根据你的目标推荐最适合的计划</text>
      </block>
      <block wx:if="{{currentStep === 2}}">
        <text class="step-title">每周能练几天？</text>
        <text class="step-subtitle">选择你能坚持的训练频率</text>
      </block>
      <block wx:if="{{currentStep === 3}}">
        <text class="step-title">你的训练经验？</text>
        <text class="step-subtitle">帮助我们匹配适合你的难度</text>
      </block>
      <block wx:if="{{currentStep === 4}}">
        <text class="step-title">为你推荐以下计划</text>
        <text class="step-subtitle">基于你的目标、时间和经验</text>
      </block>
    </view>
  </view>

  <!-- 步骤1：健身目标 -->
  <view class="step-content" wx:if="{{currentStep === 1}}">
    <view class="goal-grid">
      <view 
        class="goal-card {{selectedGoal === item.id ? 'selected' : ''}}"
        wx:for="{{goals}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSelectGoal"
      >
        <text class="goal-name">{{item.name}}</text>
        <text class="goal-desc">{{item.desc}}</text>
        <view class="goal-check" wx:if="{{selectedGoal === item.id}}">
          <text class="check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 步骤2：训练天数 -->
  <view class="step-content" wx:if="{{currentStep === 2}}">
    <view class="days-grid">
      <view 
        class="day-card {{selectedDays === item.days ? 'selected' : ''}}"
        wx:for="{{dayOptions}}"
        wx:key="days"
        data-days="{{item.days}}"
        bindtap="onSelectDays"
      >
        <text class="day-num">{{item.days}}</text>
        <text class="day-label">天/周</text>
        <text class="day-desc">{{item.desc}}</text>
        <view class="day-check" wx:if="{{selectedDays === item.days}}">
          <text class="check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 步骤3：训练经验 -->
  <view class="step-content" wx:if="{{currentStep === 3}}">
    <view class="exp-list">
      <view 
        class="exp-card {{selectedExp === item.id ? 'selected' : ''}}"
        wx:for="{{expOptions}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSelectExp"
      >
        <view class="exp-header">
          <view class="exp-info">
            <text class="exp-name">{{item.name}}</text>
            <text class="exp-tag">{{item.tag}}</text>
          </view>
        </view>
        <text class="exp-desc">{{item.desc}}</text>
        <view class="exp-check" wx:if="{{selectedExp === item.id}}">
          <text class="check-icon">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 步骤4：推荐计划 -->
  <view class="step-content" wx:if="{{currentStep === 4}}">
    <view class="recommend-list" wx:if="{{recommendedPlans.length > 0}}">
      <view 
        class="recommend-card {{selectedPlan === item.id ? 'selected' : ''}}"
        wx:for="{{recommendedPlans}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onSelectPlan"
      >
        <view class="recommend-header">
          <text class="recommend-name">{{item.name}}</text>
          <view class="recommend-tags">
            <text class="tag tag-{{item.difficultyClass}}">{{item.difficulty}}</text>
            <text class="tag">{{item.training_days}}天/周</text>
          </view>
        </view>
        <text class="recommend-desc">{{item.description}}</text>
        <view class="recommend-features">
          <text class="feature-tag" wx:for="{{item.features}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="recommend-check" wx:if="{{selectedPlan === item.id}}">
          <text class="check-text">已选择</text>
        </view>
      </view>
    </view>
    
    <!-- 无推荐结果 -->
    <view class="empty-recommend" wx:if="{{recommendedPlans.length === 0}}">
      <mp-icon icon="search" color="#CCCCCC" size="{{40}}" />
      <text class="empty-title">暂无匹配的计划</text>
      <text class="empty-desc">建议调整训练天数或经验选择</text>
      <view class="empty-action" bindtap="onGoCreatePlan">
        <text class="empty-action-text">去创建计划</text>
        <text class="empty-action-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮区 -->
  <view class="onboarding-footer">
    <view class="footer-buttons">
      <view
        class="btn-prev"
        wx:if="{{currentStep > 1}}"
        bindtap="onPrev"
      >上一步</view>
      
      <view
        class="btn-next {{loading || currentStep === 1 && !selectedGoal || currentStep === 2 && !selectedDays || currentStep === 3 && !selectedExp || currentStep === 4 && recommendedPlans.length > 0 && !selectedPlan ? 'disabled' : ''}}"
        bindtap="{{loading ? '' : (currentStep === 4 && recommendedPlans.length === 0 ? 'onSkip' : (currentStep === 4 ? 'onComplete' : 'onNext'))}}"
      >{{loading ? '创建中...' : (currentStep === 4 ? (recommendedPlans.length === 0 ? '关闭' : '开始训练') : '下一步')}}</view>
    </view>
    
    <text class="skip-text" bindtap="onSkip" wx:if="{{currentStep < 4 || currentStep === 4 && recommendedPlans.length > 0}}">跳过引导，稍后可在「训练库 → 智能推荐」中使用</text>
  </view>

</view>
