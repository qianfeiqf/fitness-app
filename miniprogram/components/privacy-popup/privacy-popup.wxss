.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.privacy-dialog {
  width: 100%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 44rpx 36rpx 36rpx;
  box-sizing: border-box;
}

.privacy-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #555555;
  margin-bottom: 36rpx;
}

.privacy-link {
  color: #07C160;
  font-weight: 500;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
}

.privacy-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 9999rpx;
  margin: 0;
  padding: 0;
}

.privacy-btn::after {
  border: none;
}

.privacy-btn.reject {
  background: #F2F2F2;
  color: #666666;
}

.privacy-btn.agree {
  background: #1A1A1A;
  color: #FFFFFF;
}
