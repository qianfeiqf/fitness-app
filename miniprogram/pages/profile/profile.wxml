<!-- 个人中心页面 - 现代化风格 -->

<view class="page-profile" style="padding-top: {{navHeight}}px;">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">我的</text>
  </view>

  <!-- 主内容区（未登录也可完整使用本地档案、目标、导出与小贴士） -->
  <view class="profile-content">
    <!-- 未登录时置顶展示深炭黑云端同步引导卡 -->
    <view wx:if="{{!isLoggedIn}}" class="sync-login-card">
      <view class="sync-login-watermark"></view>
      <view class="sync-login-head">
        <text class="sync-login-eyebrow">云端同步</text>
        <text class="sync-login-title">开启云端备份</text>
        <text class="sync-login-desc">微信一键登录，换机不丢训练记录与 1RM 数据</text>
      </view>
      <view class="sync-login-btn" bindtap="onLogin">
        <text>微信一键登录</text>
      </view>
    </view>
    <!-- 从训练页引导填写体重时的返回提示条 -->
    <view wx:if="{{returnTrainingSessionId}}" class="return-training-banner" bindtap="onReturnToTraining">
      <view class="return-banner-text">
        <text class="return-banner-title">填写体重后返回继续训练</text>
        <text class="return-banner-desc">输入体重会自动保存，点此直接回到刚才的训练</text>
      </view>
      <text class="return-banner-btn">返回训练 ›</text>
    </view>

    <!-- 身体档案卡片 -->
    <view class="profile-card">
      <view class="card-header">
        <text class="card-title">身体档案</text>
      </view>

      <view class="profile-inputs">
        <view class="profile-input-item">
          <view class="input-content">
            <text class="input-label">体重</text>
            <view class="input-row">
              <input class="input"
                     type="digit"
                     placeholder="0"
                     placeholder-style="color: #C0C4CC; font-weight: 400;"
                     value="{{weight}}"
                     bindinput="onUpdateWeight"
                     bindblur="onProfileInputBlur" />
              <text class="input-unit">kg</text>
            </view>
          </view>
        </view>

        <view class="input-divider"></view>

        <view class="profile-input-item">
          <view class="input-content">
            <text class="input-label">身高</text>
            <view class="input-row">
              <input class="input"
                     type="digit"
                     placeholder="0"
                     placeholder-style="color: #C0C4CC; font-weight: 400;"
                     value="{{height}}"
                     bindinput="onUpdateHeight"
                     bindblur="onProfileInputBlur" />
              <text class="input-unit">cm</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 训练目标 -->
    <view class="profile-card goals-card">
      <view class="card-header goals-header">
        <text class="card-title">训练目标</text>
        <view class="btn-add-goal" bindtap="onShowGoalModal">+ 添加</view>
      </view>

      <view wx:if="{{goals.length === 0}}" class="goals-empty">
        <text class="goals-empty-text">还没有设定目标，添加一个激励自己吧</text>
      </view>

      <view wx:else class="goals-list">
        <view wx:for="{{goals}}" wx:key="id" class="goal-item">
          <view class="goal-info">
            <text class="goal-name">{{item.exercise_name}}</text>
            <view class="goal-target">
              <text class="goal-current">{{item.current_1rm}}kg</text>
              <text class="goal-arrow"> → </text>
              <text class="goal-dest">{{item.target_weight}}kg</text>
            </view>
          </view>
          <view class="goal-progress">
            <view class="progress-track">
              <view class="progress-fill" style="{{item.progressStyle}}"></view>
            </view>
            <text class="progress-text">{{item.progress}}%</text>
            <view class="goal-delete" bindtap="onDeleteGoal" data-id="{{item.id}}"><mp-icon icon="close" color="#999999" size="{{14}}" /></view>
          </view>
          <view wx:if="{{item.deadline}}" class="goal-deadline">
            截止日期: {{item.deadline}}
          </view>
        </view>
      </view>
    </view>

    <!-- 功能列表（采用官方 WeUI 矢量图标） -->
    <view class="menu-section">
      <view class="menu-item" bindtap="onOpenGuideSheet">
        <view class="menu-icon-wrap">
          <mp-icon icon="info" color="#1A1A1A" size="{{22}}" />
        </view>
        <view class="menu-content">
          <text class="menu-title">使用小贴士</text>
          <text class="menu-desc">训练日调序、悬浮拖动、快捷做组等实用技巧</text>
        </view>
        <mp-icon icon="arrow" color="#CCCCCC" size="{{12}}" />
      </view>

      <view class="menu-item" bindtap="onExportData">
        <view class="menu-icon-wrap">
          <mp-icon icon="download" color="#1A1A1A" size="{{22}}" />
        </view>
        <view class="menu-content">
          <text class="menu-title">数据导出</text>
          <text class="menu-desc">导出 Markdown 报告或 JSON 备份</text>
        </view>
        <mp-icon icon="arrow" color="#CCCCCC" size="{{12}}" />
      </view>

      <view wx:if="{{isLoggedIn}}" class="menu-item" bindtap="onOpenAccountSheet">
        <view class="menu-icon-wrap">
          <mp-icon icon="me" color="#1A1A1A" size="{{22}}" />
        </view>
        <view class="menu-content">
          <text class="menu-title">账号管理</text>
          <text class="menu-desc">退出登录、注销账号</text>
        </view>
        <mp-icon icon="arrow" color="#CCCCCC" size="{{12}}" />
      </view>
    </view>

    <!-- 底部协议文字链与版本信息 -->
    <view class="version-info">
      <view class="legal-links">
        <text class="legal-link-item" bindtap="onOpenPrivacyPolicy">隐私保护指引</text>
        <text class="legal-link-sep">·</text>
        <text class="legal-link-item" bindtap="onOpenUserAgreement">用户服务协议</text>
      </view>
      <text class="version-text">训练记一记 v1.0.0</text>
    </view>
  </view>

  <!-- 添加目标弹窗（支持抽屉内直接搜索、筛选完整动作库） -->
  <modal-sheet
    visible="{{showGoalModal}}"
    tall="{{goalPickerMode}}"
    title="{{goalPickerMode ? '选择目标动作' : '添加训练目标'}}"
    description="{{goalPickerMode ? '支持搜索或按肌群筛选' : '设定一个 1RM 目标，追踪你的进步'}}"
    showConfirm="{{!goalPickerMode}}"
    confirmText="保存目标"
    cancelText="{{goalPickerMode ? '返回' : '取消'}}"
    bind:confirm="onSaveGoal"
    bind:cancel="{{goalPickerMode ? 'onCloseGoalExercisePicker' : 'onHideGoalModal'}}"
    bind:close="onHideGoalModal"
  >
    <!-- 动作库选择视图（大字号列表 + 搜索 + 肌群筛选） -->
    <view wx:if="{{goalPickerMode}}" class="goal-picker-wrap">
      <view class="goal-picker-search">
        <input
          class="goal-search-input"
          type="text"
          placeholder="搜索动作名称、俗称或器械..."
          value="{{goalExerciseSearch}}"
          bindinput="onGoalExerciseSearch"
        />
      </view>
      <scroll-view scroll-x class="goal-muscle-scroll" show-scrollbar="{{false}}">
        <view class="goal-muscle-list">
          <view
            wx:for="{{goalMuscleGroups}}"
            wx:key="*this"
            class="goal-muscle-chip {{selectedGoalMuscle === item ? 'active' : ''}}"
            data-muscle="{{item}}"
            bindtap="onSelectGoalMuscle"
          >{{item}}</view>
        </view>
      </scroll-view>
      <scroll-view scroll-y class="goal-picker-list">
        <view
          wx:for="{{filteredGoalExercises}}"
          wx:key="id"
          class="goal-picker-item {{selectedGoalExercise && selectedGoalExercise.id === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="onChooseGoalExercise"
        >
          <view class="goal-picker-info">
            <text class="goal-picker-name">{{item.name}}</text>
            <text class="goal-picker-muscle">{{item.metaText}}</text>
          </view>
          <view class="goal-picker-right">
            <text wx:if="{{item.current1RM > 0}}" class="goal-picker-rm">1RM {{item.current1RM}}kg</text>
            <text wx:if="{{selectedGoalExercise && selectedGoalExercise.id === item.id}}" class="goal-picker-check">✓</text>
          </view>
        </view>
        <view wx:if="{{filteredGoalExercises.length === 0}}" class="goal-picker-empty">
          <text>未找到匹配动作</text>
        </view>
      </scroll-view>
    </view>

    <!-- 目标表单视图 -->
    <view wx:else class="goal-form">
      <view class="form-item">
        <text class="form-label">选择动作</text>
        <view class="form-picker" bindtap="onOpenGoalExercisePicker">
          <text class="form-picker-name">{{selectedGoalExercise ? selectedGoalExercise.name : '请选择动作'}}</text>
          <view class="form-picker-right">
            <text wx:if="{{selectedGoalExercise && selectedGoalExercise.current1RM > 0}}" class="form-picker-rm">当前 {{selectedGoalExercise.current1RM}}kg</text>
            <text class="picker-arrow">›</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">目标重量 (kg)</text>
        <input class="form-input"
               type="digit"
               placeholder="例如: 100"
               value="{{newGoal.target_weight}}"
               bindinput="onInputGoalWeight" />
      </view>

      <view class="form-item">
        <text class="form-label">截止日期</text>
        <picker mode="date" value="{{newGoal.deadline}}" bindchange="onSelectGoalDeadline">
          <view class="form-picker">
            <text>{{newGoal.deadline}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
      </view>
    </view>
  </modal-sheet>

  <!-- 账号管理半屏抽屉（退出登录 / 注销账号） -->
  <modal-sheet
    visible="{{showAccountSheet}}"
    title="账号管理"
    showConfirm="{{false}}"
    cancelText="取消"
    bind:cancel="onCloseAccountSheet"
    bind:close="onCloseAccountSheet"
  >
    <view class="legal-sheet-list">
      <view class="legal-sheet-item" bindtap="onLogout">
        <view class="legal-sheet-info">
          <text class="legal-sheet-title">退出登录</text>
          <text class="legal-sheet-desc">暂停云端同步，本地记录与计划仍会保留</text>
        </view>
        <mp-icon icon="arrow" color="#CCCCCC" size="{{12}}" />
      </view>
      <view class="legal-sheet-item danger" bindtap="onDeleteAccount">
        <view class="legal-sheet-info">
          <text class="legal-sheet-title danger">注销账号</text>
          <text class="legal-sheet-desc">永久删除账号及所有训练数据</text>
        </view>
        <mp-icon icon="arrow" color="#FA5151" size="{{12}}" />
      </view>
    </view>
  </modal-sheet>

  <!-- 用户服务协议 / 隐私保护指引（左对齐分条排版） -->
  <modal-sheet
    visible="{{legalModal.visible}}"
    title="{{legalModal.title}}"
    confirmText="我知道了"
    showCancel="{{false}}"
    bind:confirm="onCloseLegalModal"
    bind:close="onCloseLegalModal"
  >
    <view class="legal-clause-list">
      <view wx:for="{{legalModal.items}}" wx:key="title" class="legal-clause-item">
        <text class="legal-clause-title">{{item.title}}</text>
        <text class="legal-clause-body">{{item.body}}</text>
      </view>
    </view>
  </modal-sheet>

  <!-- 统一确认/说明半屏弹窗 -->
  <modal-sheet
    visible="{{confirmModal.visible}}"
    title="{{confirmModal.title}}"
    description="{{confirmModal.content}}"
    confirmText="{{confirmModal.confirmText}}"
    cancelText="{{confirmModal.cancelText}}"
    showCancel="{{confirmModal.showCancel}}"
    confirmDanger="{{confirmModal.danger}}"
    bind:confirm="onConfirmModalOk"
    bind:cancel="onConfirmModalCancel"
    bind:close="onConfirmModalCancel"
  />

  <!-- 训练悬浮窗（含全局组间休息倒计时） -->
  <training-float />

  <!-- 微信隐私保护指引弹窗 -->
  <privacy-popup />
</view>
