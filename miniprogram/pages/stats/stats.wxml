<!-- 统计页面 - 现代化风格 -->

<view class="page-stats" style="padding-top: {{navHeight}}px;">
  <!-- 页面标题 -->
  <view class="page-header">
    <view class="page-header-left">
      <text class="page-title">训练统计</text>
      <text class="page-subtitle">追踪你的进步</text>
    </view>
    <view class="history-entry" bindtap="onViewHistory">
      <text class="history-entry-text">训练历史</text>
      <text class="history-entry-arrow">›</text>
    </view>
  </view>

  <!-- 月度训练日历 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">训练日历</text>
      <text class="calendar-summary">本月已练 {{calendarTrainedDays}} 天</text>
    </view>

    <view class="calendar-card">
      <!-- 月份切换栏 -->
      <view class="calendar-nav">
        <view class="calendar-nav-btn" bindtap="onPrevMonth">
          <text>‹</text>
        </view>
        <view class="calendar-nav-center">
          <text class="calendar-month-label">{{calendarYear}}年{{calendarMonth}}月</text>
          <text wx:if="{{!calendarIsCurrentMonth}}" class="calendar-today-btn" bindtap="onBackToCurrentMonth">回到本月</text>
        </view>
        <view class="calendar-nav-btn" bindtap="onNextMonth">
          <text>›</text>
        </view>
      </view>

      <!-- 星期表头 -->
      <view class="calendar-weekdays">
        <text wx:for="{{calendarWeekdays}}" wx:key="*this" class="calendar-weekday">{{item}}</text>
      </view>

      <!-- 日期网格 -->
      <view class="calendar-grid">
        <view
          wx:for="{{calendarDays}}"
          wx:key="index"
          class="calendar-cell {{item.isEmpty ? 'empty' : ''}} {{item.hasWorkout ? 'trained' : ''}} {{item.isToday ? 'today' : ''}} {{selectedDateKey === item.dateKey ? 'selected' : ''}}"
          data-date-key="{{item.dateKey}}"
          bindtap="{{item.isEmpty ? '' : 'onSelectCalendarDay'}}"
        >
          <block wx:if="{{!item.isEmpty}}">
            <view class="calendar-day-top">
              <text class="calendar-day-num">{{item.day}}</text>
              <text wx:if="{{item.sessionCount > 1}}" class="calendar-multi-badge">+{{item.sessionCount - 1}}</text>
            </view>
            <view wx:if="{{item.hasWorkout}}" class="calendar-plan-tag">
              <text class="calendar-plan-text">{{item.planTag}}</text>
            </view>
          </block>
        </view>
      </view>

      <!-- 选中日期的训练详情列表 -->
      <view wx:if="{{selectedDateKey}}" class="calendar-detail">
        <view class="calendar-detail-header">
          <text class="calendar-detail-date">{{selectedDateKey}}</text>
          <text class="calendar-detail-count">{{selectedDaySessions.length > 0 ? selectedDaySessions.length + ' 次训练' : '当日休息'}}</text>
        </view>

        <view wx:if="{{selectedDaySessions.length === 0}}" class="calendar-detail-empty">
          <text>这一天没有已完成的训练记录</text>
        </view>

        <view wx:else class="calendar-session-list">
          <view
            wx:for="{{selectedDaySessions}}"
            wx:key="id"
            class="calendar-session-item"
            data-session-id="{{item.id}}"
            bindtap="onViewSessionDetail"
          >
            <view class="calendar-session-main">
              <view class="calendar-session-title-row">
                <text class="calendar-session-name">{{item.planName}}</text>
                <text class="calendar-session-time">{{item.timeStr}}</text>
              </view>
              <text class="calendar-session-meta">{{item.setCount}} 组 · {{item.volume}} kg · {{item.duration}}</text>
            </view>
            <text class="calendar-session-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 1RM 趋势折线图 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">1RM 趋势</text>
      <mp-tabs tabs="{{chartPeriodTabs}}" active-tab="{{chartPeriodTabIndex}}" bind:change="onChartPeriodTabChange" />
    </view>
    <view class="chart-card">
      <canvas type="2d" id="rmTrendChart" class="rm-chart"></canvas>
      <view class="chart-legend">
        <view class="legend-item">
          <view class="legend-dot" style="background: #1A1A1A;"></view>
          <text class="legend-text">卧推</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot" style="background: #666666;"></view>
          <text class="legend-text">深蹲</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot" style="background: #999999;"></view>
          <text class="legend-text">硬拉</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 三大项概览 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">三大项</text>
    </view>

    <view class="big-three-grid">
      <view wx:for="{{bigThree}}"
            wx:key="exerciseName"
            class="big-three-card"
            hover-class="card-pressed">
        <view class="card-glow"></view>
        <view class="card-content">
          <text class="exercise-name">{{item.exerciseName}}</text>

          <view class="rm-display">
            <text class="rm-value">{{item.latest1RM ? item.latest1RM : '--'}}</text>
            <text class="rm-unit">kg</text>
          </view>

          <view class="rm-trend">
            <view wx:if="{{item.trend > 0}}" class="trend-badge up">
              <text class="trend-arrow">↑</text>
              <text class="trend-value">{{item.trend}}%</text>
            </view>
            <view wx:elif="{{item.trend < 0}}" class="trend-badge down">
              <text class="trend-arrow">↓</text>
              <text class="trend-value">{{item.trend}}%</text>
            </view>
            <view wx:else class="trend-badge flat">
              <text class="trend-value">持平</text>
            </view>
          </view>

          <view class="best-rm">
            <text class="best-label">历史最佳</text>
            <text class="best-value">{{item.best1RM ? item.best1RM + 'kg' : '--'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 容量趋势 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-row">
        <text class="section-title">容量趋势</text>
        <mp-tabs tabs="{{periodTabs}}" active-tab="{{periodTabIndex}}" bind:change="onPeriodTabChange" />
      </view>
      <view class="total-volume">
        <text class="total-value">{{periodVolume}}</text>
        <text class="total-unit">kg</text>
      </view>
    </view>

    <view class="volume-card">
      <view class="volume-chart">
        <view wx:for="{{volumeTrend}}"
              wx:key="index"
              class="volume-bar-item">
          <view class="volume-bar-container">
            <view class="volume-bar-track">
              <view class="volume-bar {{item.volume > 0 ? 'active' : ''}}"
                    style="height: {{item.volume > 0 ? item.barHeight : 0}}%">
              </view>
            </view>
          </view>
          <text class="volume-day">{{item.date}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 肌群均衡雷达图 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">肌群训练分布</text>
      <text class="section-subtitle">近30天</text>
    </view>
    <view class="chart-card radar-card">
      <canvas type="2d" id="muscleRadarChart" class="radar-chart"></canvas>
      <view wx:if="{{muscleAdvice}}" class="muscle-advice">
        <text class="advice-icon">💡</text>
        <text class="advice-text">{{muscleAdvice}}</text>
      </view>
    </view>
  </view>

  <!-- 近期PR -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">近期PR</text>
    </view>

    <view wx:if="{{recentPRs.length === 0}}" class="empty-state">
      <view class="empty-visual">
        <text class="empty-icon">🏆</text>
      </view>
      <text class="empty-title">暂无PR记录</text>
      <text class="empty-desc">完成训练后记录会自动保存</text>
    </view>

    <view wx:else class="pr-list">
      <view wx:for="{{recentPRs}}"
            wx:key="index"
            class="pr-item"
            hover-class="item-pressed">
        <view class="pr-icon-wrap">
          <text class="pr-icon">🏆</text>
        </view>
        <view class="pr-info">
          <text class="pr-exercise">{{item.exercise}}</text>
          <text class="pr-date">{{item.date}}</text>
        </view>
        <view class="pr-value">
          <text class="value">{{item.value}}</text>
          <text class="type">{{item.type}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 训练悬浮窗 -->
  <view wx:if="{{trainingFloat}}" class="training-float" bindtap="onTapTrainingFloat">
    <view class="training-float-content">
      <text class="training-float-icon">💪</text>
      <view class="training-float-info">
        <text class="training-float-name">{{trainingFloat.exerciseName}}</text>
        <text class="training-float-set">第 {{trainingFloat.currentSet}}/{{trainingFloat.totalSets}} 组</text>
      </view>
      <text class="training-float-arrow">›</text>
    </view>
  </view>
</view>
