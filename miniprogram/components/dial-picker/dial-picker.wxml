<!--
  刻度拨盘组件
  基于微信原生 picker-view 实现精准吸附居中，无遮挡横线
-->
<view class="dial-picker">
  <picker-view
    class="dial-picker-view"
    indicator-style="height: 88rpx;"
    indicator-class="dial-indicator"
    value="{{pickerValue}}"
    immediate-change="{{true}}"
    bindchange="onPickerChange"
  >
    <picker-view-column>
      <view
        wx:for="{{items}}"
        wx:key="index"
        class="dial-item {{currentIndex === index ? 'dial-item--active' : ''}}"
      >
        <text class="dial-item-value">{{item}}</text>
      </view>
    </picker-view-column>
  </picker-view>

  <!-- 单位文字 -->
  <view class="dial-unit" wx:if="{{unit}}">{{unit}}</view>
</view>
