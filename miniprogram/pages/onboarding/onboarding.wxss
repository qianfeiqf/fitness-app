/* =====================
   Onboarding 引导页 — 与全站统一的 #F7F8FA 浅灰底 + 无边框白卡 + 微信绿 #07C160
   ===================== */

page {
  background: #F7F8FA;
}

.onboarding-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F7F8FA;
  box-sizing: border-box;
}

/* =====================
   顶部进度条（白底直达状态栏，避让微信胶囊）
   ===================== */
.onboarding-header {
  padding: 24rpx 40rpx 36rpx;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
  flex-shrink: 0;
}

.progress-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 32rpx;
}

.progress-track {
  flex: 1;
  height: 8rpx;
  background: #EFEFF2;
  border-radius: 9999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #07C160;
  border-radius: 9999rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #888888;
  font-weight: 600;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.step-header {
  margin-top: 8rpx;
}

.step-title {
  font-size: 42rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.step-subtitle {
  font-size: 26rpx;
  color: #888888;
  display: block;
  line-height: 1.45;
}

/* =====================
   步骤内容区
   ===================== */
.step-content {
  flex: 1;
  padding: 32rpx 36rpx;
  overflow-y: auto;
  min-height: 0;
  box-sizing: border-box;
  animation: fadeIn 0.28s ease;
}

/* =====================
   步骤1：健身目标
   ===================== */
.goal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.goal-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 44rpx 24rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.18s ease;
  position: relative;
  box-sizing: border-box;
}

.goal-card.selected {
  border-color: #07C160;
  background: #F2FBF6;
  box-shadow: 0 6rpx 18rpx rgba(7, 193, 96, 0.1);
}

.goal-card:active {
  transform: scale(0.98);
}

.goal-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 10rpx;
}

.goal-desc {
  font-size: 22rpx;
  color: #888888;
  text-align: center;
  line-height: 1.45;
}

.goal-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-icon {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 700;
}

/* =====================
   步骤2：训练天数
   ===================== */
.days-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.day-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 12rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.18s ease;
  position: relative;
}

.day-card.selected {
  border-color: #07C160;
  background: #F2FBF6;
  box-shadow: 0 6rpx 18rpx rgba(7, 193, 96, 0.1);
}

.day-card:active {
  transform: scale(0.98);
}

.day-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1;
  font-family: 'DIN Alternate', system-ui, sans-serif;
}

.day-label {
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

.day-desc {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
}

.day-check {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* =====================
   步骤3：训练经验
   ===================== */
.exp-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.exp-card {
  padding: 34rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.18s ease;
  position: relative;
}

.exp-card.selected {
  border-color: #07C160;
  background: #F2FBF6;
  box-shadow: 0 6rpx 18rpx rgba(7, 193, 96, 0.1);
}

.exp-card:active {
  transform: scale(0.98);
}

.exp-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.exp-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.exp-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.exp-tag {
  font-size: 22rpx;
  color: #555555;
  background: #F3F4F6;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
}

.exp-card.selected .exp-tag {
  background: rgba(7, 193, 96, 0.14);
  color: #07C160;
  font-weight: 600;
}

.exp-desc {
  font-size: 25rpx;
  color: #666666;
  line-height: 1.5;
}

.exp-check {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* =====================
   步骤4：推荐计划
   ===================== */
.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recommend-card {
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.18s ease;
  position: relative;
}

.recommend-card.selected {
  border-color: #07C160;
  background: #F2FBF6;
  box-shadow: 0 6rpx 18rpx rgba(7, 193, 96, 0.1);
}

.recommend-card:active {
  transform: scale(0.98);
}

.recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.recommend-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  flex: 1;
}

.recommend-tags {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
  background: #F3F4F6;
  color: #666666;
}

.tag-beginner {
  background: #EAF9F0;
  color: #07C160;
}

.tag-intermediate {
  background: #FFF4E5;
  color: #D97706;
}

.tag-advanced {
  background: #FFECEC;
  color: #E5484D;
}

.recommend-desc {
  font-size: 25rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: block;
}

.recommend-features {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.feature-tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  background: #F4F5F7;
  color: #666666;
}

.recommend-check {
  margin-top: 16rpx;
  text-align: right;
}

.check-text {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
}

/* 空推荐 */
.empty-recommend {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-top: 20rpx;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #666666;
  display: block;
  margin-bottom: 48rpx;
}

.empty-action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 36rpx;
  background: #07C160;
  border-radius: 9999rpx;
}

.empty-action-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.empty-action-arrow {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* =====================
   底部按钮区
   ===================== */
.onboarding-footer {
  padding: 24rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F1F4;
  flex-shrink: 0;
}

.footer-buttons {
  display: flex;
  gap: 18rpx;
}

.btn-prev {
  flex-shrink: 0;
  height: 92rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F4F5F7;
  color: #333333;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-prev:active {
  background: #E8EAEE;
}

.btn-next {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #07C160;
  color: #FFFFFF;
  border-radius: 9999rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: background-color 0.18s ease, color 0.18s ease;
}

.btn-next:active {
  opacity: 0.88;
}

.btn-next.disabled {
  background: #E8EAEE;
  color: #9CA3AF;
}

.skip-text {
  display: block;
  text-align: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999999;
  padding: 8rpx;
}

.skip-text:active {
  color: #555555;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
