<!-- 训练库页面（计划库 + 动作库） -->

<view class="page-plans" style="padding-top: {{navHeight}}px;">
  <!-- 顶部双大字分段 Tab -->
  <view class="page-header">
    <view class="main-tabs">
      <view class="main-tab {{activeMainTab === 'plans' ? 'active' : ''}}" data-tab="plans" bindtap="onSwitchMainTab">
        <text class="main-tab-text">计划库</text>
        <view wx:if="{{activeMainTab === 'plans'}}" class="main-tab-bar"></view>
      </view>
      <view class="main-tab {{activeMainTab === 'exercises' ? 'active' : ''}}" data-tab="exercises" bindtap="onSwitchMainTab">
        <text class="main-tab-text">动作库</text>
        <view wx:if="{{activeMainTab === 'exercises'}}" class="main-tab-bar"></view>
      </view>
    </view>
  </view>

  <!-- ========== 计划库视图 ========== -->
  <block wx:if="{{activeMainTab === 'plans'}}">
  <!-- 训练计划列表 -->
  <view class="section first-section">
    <view class="section-header">
      <text class="section-title">我的计划</text>
      <view wx:if="{{plans.length > 0}}" class="btn-new" bindtap="onNavigateToCreate">
        <text class="btn-new-plus">+</text>
        <text>新建</text>
      </view>
    </view>

    <view wx:if="{{plans.length === 0}}" class="empty-card" bindtap="onNavigateToCreate">
      <text class="empty-card-icon">+</text>
      <text class="empty-card-text">新建计划</text>
    </view>

    <view wx:else class="plan-list">
      <view wx:for="{{plans}}"
            wx:key="id"
            class="plan-item"
            bindtap="onViewPlanDetail"
            data-plan-id="{{item.id}}">
        <view class="plan-info">
          <view class="plan-title-line">
            <text class="plan-name">{{item.name}}</text>
            <view class="plan-status-pill {{item.status === 'active' ? 'active' : 'archived'}}">{{item.status === 'active' ? '进行中' : item.status === 'archived' ? '已归档' : '草稿'}}</view>
          </view>
          <text class="plan-meta">{{item.summaryText}}</text>
        </view>
        <view class="plan-right">
          <text class="arrow-icon">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 经典计划 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-group">
        <text class="section-title">经典计划</text>
        <text class="section-count">共 {{filteredTemplates.length}} 个</text>
      </view>
      <text class="btn-recommend" bindtap="onShowRecommend">智能推荐</text>
    </view>

    <!-- 紧凑双排胶囊筛选（难度 + 天数） -->
    <view class="filter-pills-group">
      <scroll-view scroll-x class="filter-pill-row" show-scrollbar="{{false}}">
        <view class="filter-pill-list">
          <view
            wx:for="{{difficultyTabs}}"
            wx:key="title"
            class="filter-pill {{difficultyTabIndex === index ? 'active' : ''}}"
            data-index="{{index}}"
            bindtap="onSelectDifficultyPill"
          >{{item.title}}</view>
        </view>
      </scroll-view>
      <scroll-view scroll-x class="filter-pill-row" show-scrollbar="{{false}}">
        <view class="filter-pill-list">
          <view
            wx:for="{{daysTabs}}"
            wx:key="title"
            class="filter-pill {{daysTabIndex === index ? 'active' : ''}}"
            data-index="{{index}}"
            bindtap="onSelectDaysPill"
          >{{item.title}}</view>
        </view>
      </scroll-view>
    </view>

    <view class="template-list">
      <view wx:for="{{filteredTemplates}}"
            wx:key="id"
            class="template-item"
            bindtap="onViewTemplateDetail"
            data-template-id="{{item.id}}">
        <view class="template-info">
          <text class="template-name">{{item.name}}</text>
          <text class="template-desc">{{item.description}}</text>
          <view class="template-tags">
            <text class="template-difficulty">{{item.difficulty}}</text>
            <text class="template-days">每周{{item.training_days}}天</text>
          </view>
        </view>
        <view class="template-use-btn"
              catchtap="onShowCloneTemplateModal"
              data-template-id="{{item.id}}">
          <text>使用</text>
        </view>
      </view>

      <!-- 无筛选结果 -->
      <view wx:if="{{filteredTemplates.length === 0}}" class="empty-state">
        <text class="empty-title">暂无符合条件的计划</text>
        <text class="empty-desc">试试调整筛选条件</text>
      </view>
    </view>
  </view>
  </block>

  <!-- ========== 动作库视图 ========== -->
  <block wx:else>
    <view class="section first-section">
      <!-- 搜索栏 + 自定义动作入口 -->
      <view class="ex-toolbar">
        <view class="ex-search-box">
          <input
            class="ex-search-input"
            type="text"
            placeholder="搜索动作、肌群或器械"
            value="{{exerciseSearch}}"
            bindinput="onExerciseSearchInput"
          />
          <view wx:if="{{exerciseSearch}}" class="ex-search-clear" bindtap="onClearExerciseSearch">×</view>
        </view>
        <view class="btn-new" bindtap="onShowAddCustomModal">
          <text class="btn-new-plus">+</text>
          <text>自定义</text>
        </view>
      </view>

      <!-- 单排肌群筛选胶囊 -->
      <scroll-view scroll-x class="filter-pill-row ex-muscle-row" show-scrollbar="{{false}}">
        <view class="filter-pill-list">
          <view
            wx:for="{{exerciseMuscleGroups}}"
            wx:key="*this"
            class="filter-pill {{selectedExerciseMuscle === item ? 'active' : ''}}"
            data-muscle="{{item}}"
            bindtap="onSelectExerciseMuscle"
          >{{item}}</view>
        </view>
      </scroll-view>

      <!-- 动作统计行 -->
      <view class="ex-count-row">
        <text class="section-count">共 {{filteredExercises.length}} 个动作 · 点击查看动图与要领</text>
      </view>

      <!-- 动作无边框白卡列表 -->
      <view wx:if="{{filteredExercises.length > 0}}" class="ex-lib-list">
        <view
          wx:for="{{filteredExercises}}"
          wx:key="id"
          class="ex-lib-card"
          bindtap="onTapExerciseCard"
          data-exercise-id="{{item.id}}"
        >
          <view class="ex-lib-main">
            <view class="ex-lib-title-row">
              <text class="ex-lib-name">{{item.name}}</text>
              <text wx:if="{{item.equipment}}" class="ex-lib-equip">{{item.equipment}}</text>
              <text wx:if="{{item.is_system === false}}" class="ex-lib-custom">自定义</text>
            </view>
            <text class="ex-lib-sub">{{item.target_muscles || item.muscle_group}}</text>
          </view>
          <text class="arrow-icon">›</text>
        </view>
      </view>

      <!-- 无匹配结果 -->
      <view wx:else class="empty-state">
        <text class="empty-title">未找到匹配的动作</text>
        <text class="empty-desc">可以换个关键词，或点右上角添加自定义动作</text>
      </view>
    </view>
  </block>

  <!-- 动作要领与动图半屏抽屉 -->
  <exercise-guide-sheet
    visible="{{showExerciseDetail}}"
    exercise="{{detailExercise}}"
    allowDelete="{{true}}"
    bind:close="onCloseExerciseDetail"
    bind:delete="onDeleteCustomExercise"
  />

  <!-- 新建自定义动作弹窗 -->
  <modal-sheet
    visible="{{showAddCustomModal}}"
    title="添加自定义动作"
    confirmText="保存"
    cancelText="取消"
    bind:confirm="onConfirmAddCustom"
    bind:cancel="onCloseAddCustomModal"
    bind:close="onCloseAddCustomModal"
  >
    <view class="input-wrapper">
      <text class="input-label">动作名称</text>
      <input class="input" placeholder="例如：绳索面拉 / 壶铃摇摆" value="{{customExercise.name}}" bindinput="onInputCustomName" />
    </view>
    <view class="input-wrapper">
      <text class="input-label">所属肌群</text>
      <picker mode="selector" range="{{customMuscleGroups}}" value="{{customExercise.muscleGroupIndex}}" bindchange="onSelectCustomMuscle">
        <view class="custom-picker-box">
          <text>{{customExercise.muscle_group}}</text>
          <text class="arrow-icon">›</text>
        </view>
      </picker>
    </view>
    <view class="input-wrapper">
      <text class="input-label">常用器械（可选）</text>
      <input class="input" placeholder="例如：哑铃、龙门架、徒手" value="{{customExercise.equipment}}" bindinput="onInputCustomEquipment" />
    </view>
  </modal-sheet>

  <!-- 经典计划详情弹窗 -->
  <modal-sheet
    visible="{{showTemplateDetailModal}}"
    title="{{selectedTemplate ? selectedTemplate.name : ''}}"
    confirmText="使用此计划"
    cancelText="关闭"
    bind:confirm="onShowCloneTemplateFromDetail"
    bind:cancel="onCloseTemplateDetail"
    bind:close="onCloseTemplateDetail"
  >
    <view class="detail-tags" style="margin-bottom:16rpx;">
      <text class="template-difficulty {{selectedTemplate.difficulty === '入门' ? 'tag-green' : selectedTemplate.difficulty === '进阶' ? 'tag-red' : 'tag-yellow'}}">{{selectedTemplate.difficulty}}</text>
      <text class="template-days">每周{{selectedTemplate.training_days}}天</text>
    </view>
    <text class="detail-desc">{{selectedTemplate.description}}</text>

    <view class="btn btn-ghost btn-block" style="margin:16rpx 0;" bindtap="onShowTemplateIntro">
      了解更多 ›
    </view>

    <view class="detail-exercises">
      <text class="detail-section-title">训练安排</text>
      <view wx:for="{{templateExerciseList}}"
            wx:key="day"
            class="day-block">
        <view class="day-header">
          <text class="day-label">{{item.dayLabel}}</text>
          <text class="day-count">{{item.exercises.length}}个动作</text>
        </view>
        <view wx:for="{{item.exercises}}"
              wx:for-item="ex"
              wx:key="exercise_id"
              class="exercise-row">
          <text class="exercise-name">{{ex.name}}</text>
          <text class="exercise-sets">{{ex.target_sets}}组 × {{ex.target_reps}}次</text>
        </view>
      </view>
    </view>
  </modal-sheet>

  <!-- 经典计划详细介绍弹窗 -->
  <modal-sheet
    visible="{{showTemplateIntroModal}}"
    title="{{selectedTemplate ? selectedTemplate.name : ''}}"
    confirmText="使用此计划"
    cancelText="关闭"
    bind:confirm="onShowCloneTemplateFromIntro"
    bind:cancel="onCloseTemplateIntro"
    bind:close="onCloseTemplateIntro"
  >
    <view class="intro-tags" style="margin-bottom:24rpx;">
      <text class="template-difficulty {{selectedTemplate.difficulty === '入门' ? 'tag-green' : selectedTemplate.difficulty === '进阶' ? 'tag-red' : 'tag-yellow'}}">{{selectedTemplate.difficulty}}</text>
      <text class="template-days">每周{{selectedTemplate.training_days}}天</text>
    </view>

    <view class="intro-section">
      <text class="intro-section-title">计划简介</text>
      <text class="intro-text">{{selectedTemplate.description}}</text>
    </view>

    <view class="intro-section">
      <text class="intro-section-title">产生背景</text>
      <text class="intro-text">{{selectedTemplate.background}}</text>
    </view>

    <view class="intro-section">
      <text class="intro-section-title">适用对象</text>
      <text class="intro-text">{{selectedTemplate.suitable_for}}</text>
    </view>

    <view class="intro-section">
      <text class="intro-section-title">训练频率</text>
      <text class="intro-text">每周 {{selectedTemplate.training_days}} 天训练，{{7 - selectedTemplate.training_days}} 天休息</text>
    </view>

    <view class="intro-section" wx:if="{{selectedTemplate.notes}}">
      <text class="intro-section-title">注意事项</text>
      <text class="intro-text">{{selectedTemplate.notes}}</text>
    </view>
  </modal-sheet>

  <!-- 使用计划弹窗 -->
  <modal-sheet
    visible="{{showCloneModal}}"
    title="使用计划"
    description="为计划指定一个新名称"
    confirmText="确认使用"
    cancelText="取消"
    bind:confirm="onConfirmClone"
    bind:cancel="onCancelClone"
    bind:close="onCancelClone"
  >
    <view class="input-wrapper">
      <text class="input-label">计划名称</text>
      <input class="input"
             placeholder="输入计划名称"
             value="{{newPlanName}}"
             bindinput="onInputPlanName" />
    </view>
  </modal-sheet>

  <!-- 计划推荐弹窗 — 4步引导 -->
  <modal-sheet
    visible="{{showRecommendModal}}"
    showConfirm="{{false}}"
    showCancel="{{false}}"
    cancelText="取消"
  >
    <!-- 步骤指示器 -->
    <view class="wizard-progress">
      <view class="wizard-dots">
        <view wx:for="{{4}}" wx:key="index" class="wizard-dot {{recommendStep > index ? 'done' : ''}} {{recommendStep === index + 1 ? 'active' : ''}}"/>
      </view>
      <text class="wizard-step-text">第 {{recommendStep}} / 4 步</text>
    </view>

    <!-- 步骤1：健身目标 -->
    <view wx:if="{{recommendStep === 1}}" class="wizard-step">
      <view class="wizard-header">
        <text class="wizard-title">你的健身目标是什么？</text>
        <text class="wizard-subtitle">我们会根据你的目标推荐最适合的计划</text>
      </view>
      <view class="wizard-options wizard-goal-options">
        <view
          wx:for="{{wizardGoals}}"
          wx:key="id"
          class="wizard-option wizard-goal-card {{wizardSelectedGoal === item.id ? 'selected' : ''}}"
          bindtap="onWizardSelectGoal"
          data-id="{{item.id}}"
        >
          <text class="wizard-option-name">{{item.name}}</text>
          <text class="wizard-option-desc">{{item.desc}}</text>
          <view wx:if="{{wizardSelectedGoal === item.id}}" class="wizard-option-check">✓</view>
        </view>
      </view>
      <view class="wizard-skip-row" bindtap="onCloseRecommend">
        <text class="wizard-skip-text">暂不使用推荐</text>
      </view>
      <view class="wizard-footer">
        <view class="wizard-btn wizard-btn-primary" bindtap="onWizardNext">下一步</view>
      </view>
    </view>

    <!-- 步骤2：训练天数 -->
    <view wx:if="{{recommendStep === 2}}" class="wizard-step">
      <view class="wizard-header">
        <text class="wizard-title">每周能练几天？</text>
        <text class="wizard-subtitle">选择你每周可以稳定投入训练的天数</text>
      </view>
      <view class="wizard-days-grid">
        <view
          wx:for="{{wizardDayOptions}}"
          wx:key="days"
          class="wizard-day-card {{wizardSelectedDays === item.days ? 'selected' : ''}}"
          bindtap="onWizardSelectDays"
          data-days="{{item.days}}"
        >
          <text class="wizard-day-num">{{item.days}}</text>
          <text class="wizard-day-label">天</text>
          <text class="wizard-day-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="wizard-skip-row" bindtap="onCloseRecommend">
        <text class="wizard-skip-text">暂不使用推荐</text>
      </view>
      <view class="wizard-footer">
        <view class="wizard-btn wizard-btn-ghost" bindtap="onWizardPrev">上一步</view>
        <view class="wizard-btn wizard-btn-primary" bindtap="onWizardNext">下一步</view>
      </view>
    </view>

    <!-- 步骤3：训练经验 -->
    <view wx:if="{{recommendStep === 3}}" class="wizard-step">
      <view class="wizard-header">
        <text class="wizard-title">你的训练经验？</text>
        <text class="wizard-subtitle">帮助我们为你匹配适合的计划难度</text>
      </view>
      <scroll-view scroll-y class="wizard-exp-scroll" show-scrollbar="{{false}}">
        <view class="wizard-options wizard-exp-options">
          <view
            wx:for="{{wizardExpOptions}}"
            wx:key="id"
            class="wizard-option wizard-exp-card {{wizardSelectedExp === item.id ? 'selected' : ''}}"
            bindtap="onWizardSelectExp"
            data-id="{{item.id}}"
          >
            <view class="wizard-exp-header">
              <view class="wizard-option-info">
                <text class="wizard-option-name">{{item.name}}</text>
                <text class="wizard-exp-tag">{{item.tag}}</text>
              </view>
            </view>
            <text class="wizard-option-desc">{{item.desc}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="wizard-skip-row" bindtap="onCloseRecommend">
        <text class="wizard-skip-text">暂不使用推荐</text>
      </view>
      <view class="wizard-footer">
        <view class="wizard-btn wizard-btn-ghost" bindtap="onWizardPrev">上一步</view>
        <view class="wizard-btn wizard-btn-primary" bindtap="onWizardNext">下一步</view>
      </view>
    </view>

    <!-- 步骤4：推荐计划 -->
    <view wx:if="{{recommendStep === 4}}" class="wizard-step">
      <view class="wizard-header">
        <text class="wizard-title">为你推荐</text>
        <text class="wizard-subtitle">基于你的目标和训练偏好，为你推荐最适合的计划</text>
      </view>
      <view wx:if="{{wizardRecommended.length === 0}}" class="wizard-empty">
        <text class="wizard-empty-text">暂无符合条件的推荐计划</text>
      </view>
      <scroll-view wx:else scroll-y class="wizard-recommend-scroll" show-scrollbar="{{false}}">
        <view class="wizard-recommend-list">
          <view
            wx:for="{{wizardRecommended}}"
            wx:key="id"
            class="wizard-recommend-card {{wizardSelectedPlan === item.id ? 'selected' : ''}}"
            bindtap="onWizardSelectPlan"
            data-id="{{item.id}}"
          >
            <view class="wizard-recommend-header">
              <text class="wizard-recommend-name">{{item.name}}</text>
              <view class="wizard-recommend-tags">
                <text class="tag {{item.difficultyClass}}">{{item.difficulty}}</text>
                <text class="tag tag-gray">{{item.training_days}}天/周</text>
              </view>
            </view>
            <text class="wizard-recommend-desc">{{item.description}}</text>
            <view class="wizard-recommend-features">
              <text wx:for="{{item.features}}" wx:for-item="feat" wx:key="*this" class="feature-tag">{{feat}}</text>
            </view>
            <view wx:if="{{wizardSelectedPlan === item.id}}" class="wizard-recommend-check">✓ 已选择</view>
          </view>
        </view>
      </scroll-view>
      <view class="wizard-skip-row" bindtap="onCloseRecommend">
        <text class="wizard-skip-text">暂不使用推荐</text>
      </view>
      <view class="wizard-footer">
        <view class="wizard-btn wizard-btn-ghost" bindtap="onWizardPrev">上一步</view>
        <view wx:if="{{wizardRecommended.length === 0}}" class="wizard-btn wizard-btn-primary" bindtap="onCloseRecommend">关闭</view>
        <view wx:else class="wizard-btn wizard-btn-primary {{!wizardSelectedPlan ? 'disabled' : ''}}" bindtap="onWizardApply">应用推荐</view>
      </view>
    </view>
  </modal-sheet>

  <!-- 训练悬浮窗（含全局组间休息倒计时） -->
  <training-float />
</view>
