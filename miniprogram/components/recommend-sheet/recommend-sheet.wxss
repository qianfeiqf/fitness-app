/* 公共 4 步智能推荐半屏弹窗样式 */

.wizard-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
  padding-top: 8rpx;
}

.wizard-dots {
  display: flex;
  gap: 12rpx;
}

.wizard-dot {
  width: 48rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E5E5E5;
  transition: all 0.3s ease;
}

.wizard-dot.done {
  background: #07C160;
}

.wizard-dot.active {
  background: #1A1A1A;
  width: 64rpx;
}

.wizard-step-text {
  font-size: 24rpx;
  color: #999999;
}

.wizard-step {
  display: flex;
  flex-direction: column;
}

.wizard-header {
  margin-bottom: 32rpx;
}

.wizard-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 10rpx;
}

.wizard-subtitle {
  font-size: 26rpx;
  color: #666666;
  display: block;
}

/* Step 1：健身目标 */
.wizard-goal-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.wizard-goal-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #ECEEF2;
  transition: all 0.2s ease;
  position: relative;
}

.wizard-goal-card.selected {
  border-color: #07C160;
  background-color: #F4FBF7;
}

.wizard-goal-card .wizard-option-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.wizard-goal-card .wizard-option-desc {
  font-size: 22rpx;
  color: #999999;
  text-align: center;
  line-height: 1.4;
}

.wizard-option-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #07C160;
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Step 2：训练天数 */
.wizard-days-grid {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.wizard-day-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
  height: 180rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #ECEEF2;
  transition: all 0.2s ease;
}

.wizard-day-card.selected {
  border-color: #07C160;
  background-color: #F4FBF7;
}

.wizard-day-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #1A1A1A;
  font-family: 'DIN Alternate', system-ui, sans-serif;
  line-height: 1;
}

.wizard-day-label {
  font-size: 24rpx;
  color: #666666;
  margin-top: 4rpx;
}

.wizard-day-desc {
  font-size: 20rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* Step 3：训练经验 */
.wizard-exp-scroll {
  max-height: 540rpx;
}

.wizard-exp-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wizard-exp-card {
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #ECEEF2;
  transition: all 0.2s ease;
}

.wizard-exp-card.selected {
  border-color: #07C160;
  background-color: #F4FBF7;
}

.wizard-exp-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.wizard-exp-card .wizard-option-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.wizard-exp-card .wizard-option-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.wizard-exp-tag {
  font-size: 20rpx;
  color: #666666;
  background: #F2F3F5;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
}

.wizard-exp-card .wizard-option-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.45;
}

/* Step 4：推荐结果 */
.wizard-recommend-scroll {
  max-height: 540rpx;
}

.wizard-recommend-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.wizard-recommend-card {
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 2rpx solid #ECEEF2;
  transition: all 0.2s ease;
}

.wizard-recommend-card.selected {
  border-color: #07C160;
  background-color: #F4FBF7;
}

.wizard-recommend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.wizard-recommend-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.wizard-recommend-tags {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.tag {
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 14rpx;
  border-radius: 9999rpx;
  background: #F2F3F5;
  color: #555555;
}

.tag.beginner {
  background: rgba(7, 193, 96, 0.12);
  color: #07C160;
}

.tag.intermediate {
  background: #F2F3F5;
  color: #1A1A1A;
}

.tag.advanced {
  background: rgba(26, 26, 26, 0.08);
  color: #1A1A1A;
}

.wizard-recommend-desc {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: block;
}

.wizard-recommend-features {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.feature-tag {
  font-size: 20rpx;
  color: #555555;
  background: #F2F3F5;
  padding: 4rpx 14rpx;
  border-radius: 9999rpx;
}

.wizard-recommend-check {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
}

.wizard-empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.wizard-empty-text {
  font-size: 28rpx;
  color: #999999;
}

.wizard-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 12rpx;
}

.wizard-btn {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.wizard-btn-primary {
  background: #07C160;
  color: #FFFFFF;
}

.wizard-btn-ghost {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 0;
  background: none;
  border: none;
  flex: none;
  font-weight: 400;
  white-space: nowrap;
}

.wizard-btn.disabled {
  opacity: 0.4;
}

.wizard-skip-row {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
  margin-bottom: 4rpx;
}

.wizard-skip-text {
  font-size: 26rpx;
  color: #999999;
  padding: 12rpx 24rpx;
}
